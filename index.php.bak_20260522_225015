    checkProximityAlerts: function() {
        const today = new Date();
        const alerts = (this.data.holidays || []).filter(h => {
            if(!h.priority) return false;
            const parts = h.date.split('-');
            const hDate = new Date(parts[2], parts[1]-1, parts[0]);
            const diffTime = hDate - today;
            const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
            return diffDays >= 0 && diffDays <= 7;
        });

        const alertBar = document.getElementById('priorityAlert');
        const alertMsg = document.getElementById('alertMessage');

        if(alerts.length > 0) {
            const h = alerts[0];
            alertMsg.textContent = `URGENT: ${h.what_day} is in ${Math.ceil((new Date(h.date.split('-').reverse().join('-')) - today) / (1000*60*60*24))} days! Prepare your content.`;
            alertBar.classList.remove('hidden');
        } else {
            alertBar.classList.add('hidden');
        }
