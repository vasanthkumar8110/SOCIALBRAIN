    plannerUpdateProduct: function(productId) {
        const idx = this.plannerState.selectedSlot;
        if (idx !== null) {
            if (!this.plannerState.grid[idx]) this.plannerState.grid[idx] = {};
            this.plannerState.grid[idx].product_id = productId;
            
            // Find product name for convenience
            const product = (this.data.products || []).find(p => p.id === productId);
            if(product) {
                this.plannerState.grid[idx].product_name = product.name;
            } else {
                this.plannerState.grid[idx].product_name = '';
            }
            this.plannerSave();
        }
