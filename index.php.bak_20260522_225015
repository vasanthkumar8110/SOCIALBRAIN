                } else if (l.action === 'holidays_seeded') {
                    if (l.details && typeof l.details.count !== 'undefined') {
                        humanDetails = `${l.details.count} holidays seeded`;
                    }
                } else if (l.action === 'all_products_deleted' || l.action === 'all_sectors_deleted' || l.action === 'all_holidays_deleted' || l.action === 'all_logs_deleted' || l.action === 'all_api_keys_deleted') {
                    humanDetails = 'Bulk operation across brain';
                }

                // R&D Intelligence: Add activity scoring
                const activityScore = this.calculateActivityScore(l);
                const scoreColor = activityScore >= 80 ? 'text-green-600' : activityScore >= 60 ? 'text-amber-600' : 'text-slate-500';

                const logIdSafe = l.id ? String(l.id).replace(/"/g, '&quot;') : '';
                const canRecover = (l.action === 'post_soft_deleted' && !l.revoked_at);

                return `
                <div class="mb-4 bg-white border border-slate-100 rounded-xl p-4 shadow-sm hover:shadow-md transition-all group">
