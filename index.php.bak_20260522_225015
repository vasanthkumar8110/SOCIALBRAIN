                            <button id="btnRecoverLastDay" class="text-[10px] bg-red-50 text-red-600 px-3 py-1 rounded-lg font-bold hover:bg-red-100 transition-colors flex items-center gap-1">
                                <i class="fas fa-undo-alt"></i>
                                Recover last 1 day
                            </button>
                        </div>
                    </div>
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 text-xs">
                        <div class="bg-white rounded-lg p-3 border border-purple-100">
                            <div class="text-purple-600 font-bold">${activityStats.totalActions}</div>
