    startMainDaysAutoRefresh: function() {
        if (this.mainDaysRefreshTimer) clearInterval(this.mainDaysRefreshTimer);
        const run = async () => {
            if (this.state.currentView !== 'calendar') return;
            try {
                const res = await fetch('?action=refresh_main_days&region=both');
                if (!res.ok) return;
                const json = await res.json();
                if (json.success && json.data && Array.isArray(json.data.holidays)) {
                    this.data.holidays = json.data.holidays;
                    if ((json.data.added || 0) > 0) {
                        const stats = json.data.stats || {};
                        const ts = stats.last_search_at ? new Date(stats.last_search_at) : null;
                        const timeLabel = ts && !Number.isNaN(ts.getTime()) ? ts.toLocaleTimeString() : '';
                        this.showToast(
                            `New main days detected (${json.data.added} added${timeLabel ? ' · ' + timeLabel : ''})`,
                            'info'
                        );
                    }
                    if (this.state.currentView === 'calendar') {
                        this.renderCalendar();
                    }
                }
            } catch (e) {
                console.error('Main days auto-refresh error:', e);
            }
        };
        run();
        this.mainDaysRefreshTimer = setInterval(run, this.mainDaysRefreshIntervalMs);
    },

    analyzePostSafety: async function() {
        const text = document.getElementById('postCaption').value;
        if (!text || !text.trim()) return this.showToast('Please enter caption text first', 'warning');

        const platform = this.state.wizard.platform || 'twitter';
        
