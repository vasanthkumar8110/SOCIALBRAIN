// --- SAFETY FIREWALL: Pre-Post Decision Engine ---
if ($action === 'analyze_post_safety') {
    $input = json_decode(file_get_contents('php://input'), true);
    
    // 1. Inputs
    $text = $input['caption'] ?? '';
    $platform = $input['platform'] ?? 'twitter';
    
    // 2. Load History for Fatigue
    $data = loadJSON(MASTER_BRAIN_FILE);
    $history = array_slice($data['posts'] ?? [], -20); // Last 20 posts
    
    // 3. Logic Steps
    
    // Step 1: Emotional Analysis
    $emotions = [
        'anger' => ['hate', 'stupid', 'worst', 'angry', 'furious', 'fail', 'bad', 'horrible', 'trash', 'disaster'],
        'fear' => ['danger', 'risk', 'warning', 'alert', 'scare', 'crisis', 'emergency', 'panic', 'loss'],
        'joy' => ['happy', 'love', 'great', 'exciting', 'amazing', 'best', 'win', 'success', 'awesome'],
        'authority' => ['official', 'policy', 'rule', 'mandatory', 'must', 'required', 'law', 'compliance']
    ];
    $emotional_pressure = ['anger'=>0, 'fear'=>0, 'joy'=>0, 'authority'=>0];
    $words = str_word_count(strtolower($text), 1);
    foreach ($words as $word) {
        foreach ($emotions as $emo => $keys) {
            if (in_array($word, $keys)) $emotional_pressure[$emo]++;
        }
    }
    
    // Step 2: Fatigue (Originality)
    $fatigue_score = 0;
    if (!empty($history)) {
        foreach ($history as $h) {
            $hText = strtolower($h['caption'] ?? '');
            if (empty($hText)) continue;
            similar_text(strtolower($text), $hText, $percent);
            if ($percent > $fatigue_score) $fatigue_score = $percent;
        }
    }
    
    // Step 3: Platform Risk
    $platform_traits = [
        'twitter' => ['volatility' => 0.9, 'outrage_gain' => 1.5],
        'instagram' => ['volatility' => 0.4, 'outrage_gain' => 0.8],
        'linkedin' => ['volatility' => 0.2, 'outrage_gain' => 0.5],
        'tiktok' => ['volatility' => 0.8, 'outrage_gain' => 1.2],
        'facebook' => ['volatility' => 0.6, 'outrage_gain' => 1.0]
    ];
    $traits = $platform_traits[strtolower($platform)] ?? ['volatility'=>0.5, 'outrage_gain'=>1.0];
    
    // Step 4: World Fragility
    $fragile_keywords = ['war', 'pandemic', 'crash', 'scandal', 'leak', 'attack', 'fraud', 'racist', 'sexist', 'hacked', 'breach'];
    $sensitivity_hits = 0;
    foreach ($words as $word) {
        if (in_array($word, $fragile_keywords)) $sensitivity_hits++;
    }
    
    // Step 5: Crisis Probability
    // Formula: (Anger * OutrageGain * 0.1) + (Sensitivity * 0.2) + (Volatility * 0.1)
    $crisis_prob = ($emotional_pressure['anger'] * $traits['outrage_gain'] * 0.1) 
                 + ($sensitivity_hits * 0.2) 
                 + ($traits['volatility'] * 0.1);
    if ($crisis_prob > 1.0) $crisis_prob = 1.0;
    
    // Step 6: Engagement Curve (24h)
    $curve = [];
    $baseline = 100;
    $decay = 0.1; // Hourly decay
    for ($i=0; $i<24; $i++) {
        $val = $baseline * pow(1 - $decay, $i);
        // Crisis impact: after hour 4, crash if risk is high
        if ($i > 4 && $crisis_prob > 0.5) {
            $val *= (1 - $crisis_prob); 
        }
        $curve[] = round($val);
    }
    
    // Step 7: Decision
    $decision = 'POST';
    $explanation = "Content looks safe and original.";
    
    if ($crisis_prob > 0.75) {
        $decision = 'DO_NOT_POST';
        $explanation = "CRITICAL RISK: High probability of backlash detected due to angry/sensitive language.";
    } elseif ($fatigue_score > 65) {
        $decision = 'REWRITE';
        $explanation = "Content is too similar to previous posts (Fatigue Score: " . round($fatigue_score) . "%).";
    } elseif ($crisis_prob > 0.45) {
        $decision = 'DELAY';
        $explanation = "Moderate risk detected. Consider waiting or softening the tone.";
    }
    
    jsonResponse([
        'decision' => $decision,
        'scores' => [
            'originality_score' => round(100 - $fatigue_score),
            'fatigue_score' => round($fatigue_score),
            'risk_score' => round($crisis_prob * 100),
            'crisis_probability' => $crisis_prob
        ],
        'emotional_pressure' => $emotional_pressure,
        'predicted_engagement_curve' => $curve,
        'explanation' => $explanation
    ]);
}

