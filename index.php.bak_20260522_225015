    loadData: async function() {
        try {
            const res = await fetch('?action=get_data');
            if(!res.ok) throw new Error('Network response was not ok');
            const json = await res.json();
            
            if (json.success && json.data) {
                this.data = json.data;
                this.lastServerVersion = json.data.version || 0;
            } else {
                // Handle unauthorized or empty data
                this.data = { posts: [], products: [], sectors: [], platforms: [], holidays: [] };
                if (json.message && json.message !== 'Unauthorized') {
                    this.showToast(json.message, 'error');
                }
            }
            
            const arrays = ['posts', 'products', 'sectors', 'platforms', 'categories', 'sub_categories', 'holidays', 'tasks', 'users'];
            arrays.forEach(key => {
                if (!this.data[key] || !Array.isArray(this.data[key])) {
                    this.data[key] = [];
                } else {
                    // Filter out null/undefined entries and ensure objects
                    this.data[key] = this.data[key].filter(item => item && typeof item === 'object');
                }
            });
            
            // Filter out soft-deleted posts safely
            this.data.posts = this.data.posts.filter(p => !p.deleted_at);
            
            // Update Role from fetched data
            if (this.data.current_user && this.data.current_user.role) {
                this.data.userRole = this.data.current_user.role;
                if(typeof this.applyRolePermissions === 'function') {
                    this.applyRolePermissions(this.data.userRole);
                }
            }
            
            const currentUser = this.data.current_user || {};
            const hasBrainFile = !!this.data.team_brain_ready;
            const pill = document.getElementById('brainStatusPill');
            const icon = document.getElementById('brainStatusIcon');
            const text = document.getElementById('brainStatusText');
            if (pill && icon && text) {
                pill.classList.remove('hidden');
                pill.classList.remove('border-slate-300','bg-slate-50','text-slate-600','border-amber-300','bg-amber-50','text-amber-700','border-emerald-300','bg-emerald-50','text-emerald-700');
                if (!currentUser.id) {
                    pill.classList.add('border-slate-300','bg-slate-50','text-slate-600');
                    icon.className = 'fas fa-user-secret text-slate-500';
                    text.textContent = 'Guest session';
                } else if (currentUser.role === 'admin') {
                    if (hasBrainFile) {
                        pill.classList.add('border-emerald-300','bg-emerald-50','text-emerald-700');
                        icon.className = 'fas fa-brain text-emerald-600';
                        text.textContent = 'Admin Brain: ready';
                    } else {
                        pill.classList.add('border-amber-300','bg-amber-50','text-amber-700');
                        icon.className = 'fas fa-seedling text-amber-600';
                        text.textContent = 'New Admin: empty brain';
                    }
                } else {
                    pill.classList.add('border-slate-300','bg-slate-50','text-slate-600');
                    icon.className = 'fas fa-user-friends text-slate-500';
                    text.textContent = 'Team Member: ' + (currentUser.role || 'viewer');
                }
            }
            
            // Assigned tasks notification + navbar count
            const currentUserTasks = this.data.current_user || {};
            const currentUserId = currentUserTasks.id || '';
            if (currentUserId) {
                if (!this.state.seenAssignedTasks) {
                    this.state.seenAssignedTasks = {};
                }
                const seen = this.state.seenAssignedTasks;
                const assignedToMe = (this.data.tasks || []).filter(t => t.assigned_to === currentUserId);
                let newOnes = 0;
                assignedToMe.forEach(t => {
                    if (t.id && !seen[t.id]) {
                        seen[t.id] = true;
                        newOnes++;
                    }
                });
                const activeAssigned = assignedToMe.filter(t => (t.status || 'pending') === 'pending' || (t.status || '') === 'ongoing');
                const badge = document.getElementById('nav-tasks-count');
                if (badge) {
                    if (activeAssigned.length > 0) {
                        badge.textContent = String(activeAssigned.length);
                        badge.classList.remove('hidden');
                    } else {
                        badge.textContent = '';
                        badge.classList.add('hidden');
                    }
                }
                if (newOnes > 0) {
                    this.showToast('New work assigned to you', 'info');
                }
            }
        } catch(e) {
            console.error('Data load error:', e);
            this.data = { posts: [], products: [], sectors: [], platforms: [], holidays: [] };
            this.showToast('Error connecting to brain server', 'error');
        }
    },

    applyRolePermissions: function(role) {
        const currentUser = this.data.current_user || {};
        let assignedPanel = currentUser.assigned_panel || '';
        if (assignedPanel === 'research') assignedPanel = 'dashboard';
        
        // 0. Base Class Management
        document.body.classList.remove('role-admin', 'role-editor', 'role-viewer');
        document.body.classList.add('role-' + role);
        
        // 1. Viewer Strict Panel Lock
        if (role === 'viewer' && assignedPanel) {
            // Hide all nav items first
            document.querySelectorAll('nav button, .md\\:hidden button').forEach(btn => {
                // Keep Logout/Theme buttons if they are in the same container? 
                // Assuming nav buttons are strictly view switchers based on typical structure
                // But let's be safe: only hide ones that switch views
                if(btn.onclick && btn.onclick.toString().includes('switchView')) {
                    btn.classList.add('hidden');
                }
            });
            
            // Show only the assigned one
            const allowedNav = document.getElementById('nav-' + assignedPanel);
            if(allowedNav) allowedNav.classList.remove('hidden');
            
            const allowedMobile = document.querySelector(`.md\\:hidden button[onclick*="'${assignedPanel}'"]`);
            if(allowedMobile) allowedMobile.classList.remove('hidden');
            
            // Force switch if not on assigned panel
            if (this.state.currentView !== assignedPanel) {
                this.switchView(assignedPanel);
            }
