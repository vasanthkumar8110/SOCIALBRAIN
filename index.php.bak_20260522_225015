                        ${hoverDate ? `<div class="text-[10px] tracking-wide uppercase mb-1">${hoverDate}</div>` : ''}
                        <div class="max-w-[90%] line-clamp-3">
                            ${item.caption ? item.caption.substring(0, 60) + (item.caption.length > 60 ? '...' : '') : 'No caption yet'}
                        </div>
                        ${item.product_name ? `<span class="text-[10px] text-yellow-300 font-bold mt-1">${item.product_name}</span>` : ''}
                        ${item.schedule ? '<div class="mt-1 flex items-center gap-1 justify-center text-[10px] opacity-90"><i class="far fa-clock"></i><span>Tap to edit mobile view</span></div>' : '<div class="mt-1 text-[10px] opacity-80">Tap to set date & time</div>'}
                    </div>
                `;
            } else {
                cell.innerHTML = `
                    <div class="absolute inset-0 flex items-center justify-center text-slate-300 group-hover:text-slate-400 transition-colors pointer-events-none">
                        <i class="fas fa-plus text-2xl"></i>
                    </div>
