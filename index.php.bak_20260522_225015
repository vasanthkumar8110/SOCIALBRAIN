        const originalBtnContent = btn.innerHTML;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin text-blue-500"></i> Analyzing...';
        btn.disabled = true;
        
        try {
            const res = await fetch('?action=analyze_post_safety', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ caption: text, platform: platform })
            });
            
            const result = await res.json();
            
            // Show Result Container
            const container = document.getElementById('safetyAnalysisResult');
            container.classList.remove('hidden');
            
            // Update Decision Badge
            const badge = document.getElementById('safetyDecisionBadge');
            const title = document.getElementById('safetyDecisionTitle');
            const expl = document.getElementById('safetyExplanation');
            
            title.textContent = result.decision.replace(/_/g, ' ');
            expl.textContent = result.explanation;
            
            // Color Logic
            badge.className = 'p-4 rounded-lg text-center mb-6 border-2 transition-colors duration-500';
            if (result.decision === 'POST') {
                badge.classList.add('bg-green-50', 'border-green-200', 'text-green-800');
            } else if (result.decision === 'DELAY') {
                badge.classList.add('bg-yellow-50', 'border-yellow-200', 'text-yellow-800');
            } else if (result.decision === 'REWRITE') {
                badge.classList.add('bg-orange-50', 'border-orange-200', 'text-orange-800');
            } else { // DO_NOT_POST
                badge.classList.add('bg-red-50', 'border-red-200', 'text-red-800');
            }
            
            // Update Bars
            document.getElementById('barRisk').style.width = result.scores.risk_score + '%';
            document.getElementById('barFatigue').style.width = result.scores.fatigue_score + '%';
            document.getElementById('barOriginality').style.width = result.scores.originality_score + '%';
            document.getElementById('barCrisis').style.width = (result.scores.crisis_probability * 100) + '%';
            
