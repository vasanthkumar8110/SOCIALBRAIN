    finishPost: async function() {
        const w = this.state.wizard;
        if(!w.product) return this.showToast('Please select a product from the list above.', 'info');
        
        const payload = {
            date: w.date,
            platform: w.platform,
            post_type: w.type,
            product_id: w.product.id,
            product_name: w.product.name,
            sector_id: w.sector_id,
            category_id: w.category_id,
            sub_category_id: w.sub_category_id,
            fb_context: w.fbContext,
            caption: document.getElementById('postCaption') ? document.getElementById('postCaption').value : ''
        };

        try {
            const res = await fetch('?action=save_post', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const result = await res.json();
            
            if(result.success) {
                // Show Success UI
                document.getElementById('wizardFooter').classList.add('hidden');
                document.querySelectorAll('.wizard-step').forEach(el => el.classList.add('hidden'));
                document.getElementById('step-success').classList.remove('hidden');
                document.getElementById('btnClose').classList.remove('hidden');
                document.getElementById('wizardFooter').classList.remove('hidden');
                
                await this.loadData();
                this.renderCalendar();
                this.renderKanban();
                this.renderDashboard();
                this.showToast('Post Created Successfully!', 'success');
            } else {
                this.showToast(result.message, 'error');
            }
        } catch(e) {
            this.showToast('Error saving post', 'error');
        }
    },

    // --- Dashboard Logic ---
    showScheduleModal: function(message, defaultTime) {
        return new Promise((resolve) => {
            const modal = document.getElementById('scheduleModal');
            const msgEl = document.getElementById('scheduleMsg');
            const input = document.getElementById('scheduleTimeInput');
            
            msgEl.textContent = message;
            input.value = defaultTime;
            
            modal.classList.remove('hidden');
            input.focus();
            
            window.confirmSchedule = () => {
                modal.classList.add('hidden');
                resolve(input.value);
            };
            
            window.cancelSchedule = () => {
                modal.classList.add('hidden');
                resolve(null);
            };

            // Allow Enter key
            input.onkeydown = (e) => {
                if(e.key === 'Enter') window.confirmSchedule();
                if(e.key === 'Escape') window.cancelSchedule();
            };
        });
    },

    showLateReasonModal: function(defaultReason) {
        return new Promise((resolve) => {
            if (typeof Swal === 'undefined') {
                const r = window.prompt('Reason for posting late?', defaultReason || '');
                if (r === null) resolve(null);
                else resolve(r.trim());
                return;
            }
            const safeDefaultReason = (defaultReason || '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;');
            Swal.fire({
                title: 'Post is late',
                html: `
                    <div class="task-sheet-body space-y-4 text-left">
                        <div>
                            <div class="task-sheet-label">Why is this post going live after its scheduled date?</div>
                            <textarea id="late_reason_input" class="swal2-textarea task-sheet-textarea" style="margin:0" aria-label="Reason for late posting" placeholder="Example: Client delay, last-minute edits, approval bottleneck...">${safeDefaultReason}</textarea>
                        </div>
                    </div>
                `,
                focusConfirm: false,
                showCancelButton: true,
                confirmButtonText: 'Save reason',
                cancelButtonText: 'Skip',
                customClass: {
                    popup: 'task-sheet-modal',
                    actions: 'task-sheet-actions',
                    confirmButton: 'task-sheet-btn-primary',
                    cancelButton: 'task-sheet-btn-clear'
                },
                preConfirm: () => {
                    const el = document.getElementById('late_reason_input');
                    return el ? el.value.trim() : '';
                }
            }).then(result => {
                if (!result.isConfirmed) {
                    resolve(null);
                } else {
                    resolve((result.value || '').trim());
                }
            });
        });
    },

