    nextStep: function() {
        const w = this.state.wizard;
        if(w.step === 1 && !w.platform) return this.showToast('Select a platform', 'info');
        if(w.step === 2 && !w.type) return this.showToast('Select a post type', 'info');
        if(w.step === 3 && !w.sector_id) return this.showToast('Select a sector', 'info');
        if(w.step === 4 && !w.category_id) return this.showToast('Select a category', 'info');
        if(w.step === 5 && !w.sub_category_id) return this.showToast('Select a sub-category', 'info');
        
        if(w.step < 6) {
            w.step++;
            this.saveState();
            this.renderWizardStep();
        }
