    saveUser: function(userData) {
        fetch('?action=save_user', {
            method: 'POST',
            body: JSON.stringify(userData)
        })
        .then(r => r.json())
        .then(res => {
            if(res.success) {
                App.showToast(res.message, 'success');
                this.renderAdminUsers();
            } else {
                App.showToast(res.error || 'Failed to save user', 'error');
            }
        });
    },

    deleteUser: function(id) {
        Swal.fire({
            title: 'Delete User?',
            text: "This action cannot be undone. The user will lose access immediately.",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#ef4444',
            confirmButtonText: 'Yes, delete user'
        }).then((result) => {
            if (result.isConfirmed) {
                fetch('?action=delete_user', {
                    method: 'POST',
                    body: JSON.stringify({id})
                })
                .then(r => r.json())
                .then(res => {
                    if(res.success) {
                        App.showToast('User deleted', 'success');
                        this.renderAdminUsers();
                    } else {
                        App.showToast(res.error, 'error');
                    }
