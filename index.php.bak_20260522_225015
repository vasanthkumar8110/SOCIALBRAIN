                        </div>
                    </div>
                    ${(humanDetails || (l.details && Object.keys(l.details).length)) ? `
                    <div class="mt-3 pl-13 text-xs bg-slate-50 p-2 rounded-lg border border-slate-100 text-slate-600 font-mono overflow-x-auto">
                        <span class="text-slate-400 mr-2 opacity-50">Details:</span> ${humanDetails || JSON.stringify(l.details)}
                    </div>` : ''}
                </div>
