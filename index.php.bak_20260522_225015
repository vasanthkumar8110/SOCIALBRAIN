            addTaskBtn.className = 'px-3 py-1 rounded-lg text-xs font-semibold bg-blue-600 text-white hover:bg-blue-700';
            addTaskBtn.textContent = 'Add Task';
            addTaskBtn.onclick = () => this.createTaskForCurrentDay();
            tasksHeader.appendChild(addTaskBtn);
        }
        list.appendChild(tasksHeader);

        const board = document.createElement('div');
        board.className = 'grid grid-cols-2 gap-3 sm:grid-cols-3';

        taskStatuses.forEach(statusDef => {
            const col = document.createElement('div');
            col.className = 'bg-white rounded-xl border border-slate-200 p-2 flex flex-col gap-2';
            const colHeader = document.createElement('div');
            colHeader.className = 'text-[10px] font-bold uppercase tracking-widest text-slate-400 flex justify-between items-center';
            colHeader.textContent = statusDef.label;
            const countSpan = document.createElement('span');
            countSpan.className = 'ml-2 text-[10px] text-slate-300';
            const colTasks = tasks.filter(t => this.getTaskEffectiveStatus(t) === statusDef.key);
            countSpan.textContent = String(colTasks.length);
            colHeader.appendChild(countSpan);
            col.appendChild(colHeader);

            const zone = document.createElement('div');
            zone.className = 'task-drop-zone mt-1 space-y-1 min-h-[24px]';
            if (canEditTasks) {
                zone.dataset.status = statusDef.key;
                zone.ondragover = (e) => {
                    e.preventDefault();
                    zone.classList.add('ring-1', 'ring-blue-400');
                };
                zone.ondragleave = () => {
                    zone.classList.remove('ring-1', 'ring-blue-400');
                };
                zone.ondrop = (e) => {
                    zone.classList.remove('ring-1', 'ring-blue-400');
                    this.handleTaskDrop(e, statusDef.key);
                };
            }

            const users = Array.isArray(this.data.users) ? this.data.users : [];
            colTasks.forEach(task => {
                const card = document.createElement('div');
                card.className = 'rounded-lg bg-slate-50 px-2 py-1 text-xs text-slate-700 flex items-center justify-between gap-1 cursor-pointer';
                card.draggable = canEditTasks;
                if (canEditTasks) {
                    card.ondragstart = (e) => {
                        e.dataTransfer.setData('task_id', task.id);
                        e.dataTransfer.setData('old_status', this.getTaskEffectiveStatus(task));
                    };
                    card.onclick = () => this.openTaskEditor(task.id);
                }
                const title = document.createElement('div');
                title.className = 'truncate';
                const parts = [];
                if (task.priority) {
                    parts.push('[' + task.priority + ']');
                }
                parts.push(task.title || 'Untitled');
                if (task.dueTime) {
                    parts.push('@' + task.dueTime);
                }
                if (task.assigned_to) {
                    const ass = users.find(u => u.id === task.assigned_to);
                    if (ass) {
                        parts.push('→ @' + (ass.username || ass.id));
                    }
                }
                title.textContent = parts.join(' ');
                card.appendChild(title);
                zone.appendChild(card);
            });

            col.appendChild(zone);
            board.appendChild(col);
        });

        list.appendChild(board);

        if (!tasks.length && canEditTasks) {
            const hint = document.createElement('div');
            hint.className = 'mt-2 text-[11px] text-slate-400';
            hint.textContent = 'Use Add Task to plan your work for this day.';
            list.appendChild(hint);
        }

        document.getElementById('dayDetailModal').classList.remove('hidden');
        if (showTasksBtn) {
            if (!tasks.length && !canEditTasks) {
                showTasksBtn.classList.add('hidden');
                showTasksBtn.onclick = null;
            } else {
                showTasksBtn.classList.remove('hidden');
                showTasksBtn.onclick = () => {
                    const listEl = document.getElementById('dayDetailList');
                    const tasksSection = document.getElementById('dayDetailTasksSection');
                    if (listEl && tasksSection) {
                        const top = tasksSection.offsetTop - 8;
                        if (typeof listEl.scrollTo === 'function') {
                            listEl.scrollTo({ top, behavior: 'smooth' });
                        } else {
                            listEl.scrollTop = top;
                        }
                    }
                };
            }
        }
    },

    createTaskForCurrentDay: async function() {
        const dateStr = this.state.currentDetailDate;
        if (!dateStr) return;
        if (typeof Swal === 'undefined') {
            const title = window.prompt('Task title');
            if (!title) return;
            try {
                const res = await fetch('?action=save_task', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ title, date: dateStr, status: 'pending' })
                });
                const json = await res.json();
                if (json.success && json.data) {
                    if (!Array.isArray(this.data.tasks)) {
                        this.data.tasks = [];
                    }
                    this.data.tasks.push(json.data);
                    this.viewDayDetail(dateStr);
                } else {
                    this.showToast(json.message || 'Task save failed', 'error');
