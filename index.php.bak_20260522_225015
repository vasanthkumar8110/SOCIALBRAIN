    buildAiPrediction: function(item, now) {
        let horizon = '';
        if (item.dueAt instanceof Date && !Number.isNaN(item.dueAt.getTime())) {
            const d0 = new Date(now.getFullYear(), now.getMonth(), now.getDate());
            const d1 = new Date(item.dueAt.getFullYear(), item.dueAt.getMonth(), item.dueAt.getDate());
            const diffDays = Math.round((d1.getTime() - d0.getTime()) / 86400000);
            if (diffDays === 0) horizon = 'today';
            else if (diffDays === 1) horizon = 'tomorrow';
            else if (diffDays > 1 && diffDays <= 7) horizon = 'week';
            else if (d1.getMonth() === now.getMonth() && d1.getFullYear() === now.getFullYear()) horizon = 'month';
        }
        let urgency = 0;
        if (item.dueAt instanceof Date && !Number.isNaN(item.dueAt.getTime())) {
            const diffMs = item.dueAt.getTime() - now.getTime();
            const diffMin = diffMs / 60000;
            if (diffMin < 0) urgency = 3;
            else if (diffMin <= 60) urgency = 2;
            else if (diffMin <= 24 * 60) urgency = 1;
        }
        const priorityScore = 4 - (item.priority || 3);
        const severity = item.riskSeverity || 0;
        const likelihood = item.riskLikelihood || 0;
        const riskScoreRaw = severity * likelihood;
        const riskScore = riskScoreRaw > 0 ? Math.min(riskScoreRaw / 25, 4) : 0;
        const w = this.aiAgentState && this.aiAgentState.weights ? this.aiAgentState.weights : { priority: 1, urgency: 1, risk: 1 };
        const effectivePriority = (w.priority || 1) * priorityScore + (w.urgency || 1) * urgency + (w.risk || 1) * riskScore;
        let recommendedAction = '';
        let reason = '';
        const status = String(item.status || '').toLowerCase();
        if (status === 'completed' || status === 'done' || status === 'cancelled') {
            recommendedAction = 'No action needed';
            reason = 'Item is already ' + status;
        } else if (item.type === 'risk') {
            if (riskScoreRaw >= 25) {
                recommendedAction = 'Mitigate this risk now';
                reason = 'High severity and likelihood';
            } else if (urgency >= 2) {
                recommendedAction = 'Review and update risk status';
                reason = 'Review window is imminent';
            } else {
                recommendedAction = 'Plan mitigation steps';
                reason = 'Active risk without immediate deadline';
            }
        } else {
            if (urgency === 3) {
                recommendedAction = 'Handle this immediately';
                reason = 'Overdue and still pending';
            } else if (urgency === 2) {
                recommendedAction = 'Work on this within the next hour';
                reason = 'Due soon and not completed';
            } else if (urgency === 1) {
                recommendedAction = 'Schedule time today';
                reason = 'Due later today';
            } else {
                if (priorityScore >= 3) {
                    recommendedAction = 'Plan this in your next focus block';
                    reason = 'High priority item without near deadline';
                } else {
                    recommendedAction = 'Keep in backlog';
                    reason = 'Lower priority and no close deadline';
                }
            }
        }
        return {
            itemId: item.id,
            type: item.type,
            title: item.title,
            status: item.status,
            source: item.source,
            recommendedAction: recommendedAction,
            reason: reason,
            effectivePriority: Number(effectivePriority.toFixed(2)),
            dueAt: item.dueAt,
            riskScore: riskScoreRaw,
            horizon: horizon
        };
    },
    
    describeAiAgentItem: function(prediction) {
        if (!prediction) return '';
        const parts = [];
        if (prediction.type === 'task') parts.push('Task');
        else if (prediction.type === 'post') parts.push('Post');
        else if (prediction.type === 'reminder') parts.push('Reminder');
        else if (prediction.type === 'risk') parts.push('Risk');
        const title = prediction.title || '';
        if (title) parts.push(title);
        const status = prediction.status ? String(prediction.status).toUpperCase() : '';
        if (status) parts.push(status);
        const due = prediction.dueAt instanceof Date && !Number.isNaN(prediction.dueAt.getTime()) ? prediction.dueAt : null;
        if (due) {
            const dtStr = due.toLocaleString(undefined, {
                year: 'numeric',
                month: 'short',
                day: '2-digit',
                hour: '2-digit',
                minute: '2-digit'
            });
            parts.push(dtStr);
        }
        if (!parts.length) return '';
        return 'AI Agent · ' + parts.join(' · ');
    },
    
    computeAiAgentPredictions: function(now) {
        const items = this.collectWorkBrainItems(now);
        const predictions = [];
        for (let i = 0; i < items.length; i++) {
            predictions.push(this.buildAiPrediction(items[i], now));
        }
        predictions.sort((a, b) => b.effectivePriority - a.effectivePriority);
        return predictions;
    },
    
    updateAiAgentPredictions: function(predictions, now) {
        if (!this.aiAgentState) return;
        const prev = this.aiAgentState.previous || {};
        const nextPrev = {};
        for (let i = 0; i < predictions.length; i++) {
            const p = predictions[i];
            const key = p.itemId;
            const hash = p.recommendedAction + '|' + p.effectivePriority.toFixed(1);
            const prevEntry = prev[key];
            p.isNew = !prevEntry || prevEntry.hash !== hash;
            nextPrev[key] = { hash: hash, prediction: p };
        }
        this.aiAgentState.previous = nextPrev;
        this.aiAgentState.lastUpdatedAt = now;
        this.renderAiAgentPanel(predictions, now);
        if (typeof this.showToast === 'function') {
            const state = this.aiAgentState;
            const nowMs = now.getTime();
            const lastAtMs = state.lastNotificationAt instanceof Date ? state.lastNotificationAt.getTime() : (state.lastNotificationAt || 0);
            const minuteElapsed = !lastAtMs || (nowMs - lastAtMs >= 60000);
            if (!predictions || !predictions.length) {
                if (minuteElapsed) {
                    this.showToast('AI Agent · No active items found in Work Brain yet', 'info');
                    state.lastNotificationItemId = null;
                    state.lastNotificationAt = now;
                }
            } else {
                const top = predictions[0];
                const lastId = state.lastNotificationItemId || null;
                const changedTop = !lastId || lastId !== top.itemId;
                if (minuteElapsed || changedTop) {
                    const title = top.title || 'Next action';
                    const action = top.recommendedAction || '';
                    const horizon = top.horizon || '';
                    const label = horizon ? horizon.charAt(0).toUpperCase() + horizon.slice(1) : '';
                    let msg = title;
                    if (action) msg += ' – ' + action;
                    if (label) msg = '[' + label + '] ' + msg;
                    const finalMsg = 'AI Agent · ' + msg;
                    this.showToast(finalMsg, 'info');
                    state.lastNotificationItemId = top.itemId;
                    state.lastNotificationAt = now;
                }
            }
        }
    },
    
    renderAiAgentPanel: function(predictions, now) {
        const listEl = document.getElementById('aiAgentList');
        const timeEl = document.getElementById('aiAgentVirtualTime');
        const updatedEl = document.getElementById('aiAgentLastUpdated');
        const statusEl = document.getElementById('aiAgentStatus');
        if (timeEl) {
            timeEl.textContent = now.toLocaleString();
        }
        if (updatedEl) {
            updatedEl.textContent = 'Updated ' + now.toLocaleTimeString();
        }
        if (!listEl) return;
        if (!predictions.length) {
            listEl.innerHTML = '<div class="text-[11px] text-slate-400">No active tasks, posts, reminders, or risks.</div>';
            if (statusEl) statusEl.textContent = 'Idle';
            return;
        }
        const top = predictions.slice(0, 6);
        const htmlParts = [];
        for (let i = 0; i < top.length; i++) {
            const p = top[i];
            let typeLabel = 'Item';
            if (p.type === 'task') typeLabel = 'Task';
            else if (p.type === 'reminder') typeLabel = 'Reminder';
            else if (p.type === 'post') typeLabel = 'Post';
            else if (p.type === 'risk') typeLabel = 'Risk';
            let horizonLabel = '';
            if (p.horizon === 'today') horizonLabel = 'Today';
            else if (p.horizon === 'tomorrow') horizonLabel = 'Tomorrow';
            else if (p.horizon === 'week') horizonLabel = 'This week';
            else if (p.horizon === 'month') horizonLabel = 'This month';
            const horizonBadge = horizonLabel ? '<span class="ml-1 px-1.5 py-0.5 rounded-full bg-slate-700/80 text-slate-200 text-[9px]">' + horizonLabel + '</span>' : '';
            const badge = p.isNew ? '<span class="ml-1 px-1.5 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 text-[9px]">New</span>' : '';
            const due = p.dueAt instanceof Date && !Number.isNaN(p.dueAt.getTime()) ? p.dueAt.toLocaleTimeString(undefined, { hour: '2-digit', minute: '2-digit' }) : '';
            const dueLabel = due ? '<span class="text-[10px] text-slate-300">Due ' + due + '</span>' : '';
            htmlParts.push(
                '<div class="border border-slate-700/70 rounded-xl px-2 py-1.5 bg-slate-900/80 flex flex-col gap-0.5">' +
                '<div class="flex items-center justify-between gap-2">' +
                '<div class="flex items-center gap-1">' +
                        '<span class="px-1.5 py-0.5 rounded bg-slate-800 text-[9px] uppercase tracking-widest text-slate-300">' + typeLabel + '</span>' +
                        horizonBadge +
                        badge +
                        '</div>' +
                        '<span class="text-[10px] text-slate-400 capitalize">' + (p.status || '') + '</span>' +
                    '</div>' +
                    '<div class="text-[11px] font-semibold text-slate-100 truncate" title="' + this.escapeHTML(p.title || '') + '">' + this.escapeHTML(p.title || '') + '</div>' +
                    '<div class="text-[10px] text-slate-300">' + this.escapeHTML(p.recommendedAction || '') + '</div>' +
                    '<div class="flex items-center justify-between text-[9px] text-slate-400 mt-0.5">' +
                        '<span class="truncate">' + this.escapeHTML(p.reason || '') + '</span>' +
                        dueLabel +
                    '</div>' +
                '</div>'
            );
        }
        listEl.innerHTML = htmlParts.join('');
        if (statusEl) statusEl.textContent = 'Monitoring ' + predictions.length + ' items';
    },
    
    scheduleNextAiAgentUpdate: function() {
        if (!this.aiAgentState) return;
        const delay = this.aiAgentState.refreshIntervalMs || 10000;
        setTimeout(() => {
            const now = this.getVirtualNow();
            const predictions = this.computeAiAgentPredictions(now);
            this.updateAiAgentPredictions(predictions, now);
            this.scheduleNextAiAgentUpdate();
        }, delay);
    },
    
    applyAiAgentFocusMode: function(mode) {
        if (!this.aiAgentState) return;
        if (mode === 'tasks') {
            this.aiAgentState.weights = { priority: 1.4, urgency: 1.2, risk: 0.6 };
        } else if (mode === 'risks') {
            this.aiAgentState.weights = { priority: 1.0, urgency: 0.8, risk: 1.6 };
        } else {
            this.aiAgentState.weights = { priority: 1.0, urgency: 1.0, risk: 1.0 };
        }
    },
    
    applyAiAgentQuery: function(query) {
        if (!this.aiAgentState) return;
        const q = String(query || '').toLowerCase();
        const now = this.getVirtualNow();
        let mode = 'balanced';
        if (q.includes('risk')) mode = 'risks';
        else if (q.includes('task')) mode = 'tasks';
        else if (q.includes('focus')) mode = 'tasks';
        this.applyAiAgentFocusMode(mode);
        const focusSelect = document.getElementById('aiAgentFocusMode');
        if (focusSelect) focusSelect.value = mode;
        const allPreds = this.computeAiAgentPredictions(now);
        let horizonFilter = '';
        if (q.includes('today') || q.includes('now')) horizonFilter = 'today';
        else if (q.includes('tomorrow')) horizonFilter = 'tomorrow';
        else if (q.includes('week')) horizonFilter = 'week';
        else if (q.includes('month')) horizonFilter = 'month';
        const preds = horizonFilter
            ? allPreds.filter(p => p.horizon === horizonFilter)
            : allPreds;
        this.updateAiAgentPredictions(preds, now);
        const statusEl = document.getElementById('aiAgentStatus');
        if (statusEl) {
            if (!q.trim()) statusEl.textContent = 'Monitoring your Work Brain';
            else statusEl.textContent = 'Answering: "' + query.trim() + '"';
        }
    },
    
    toggleAiAgentPanel: function(open) {
        if (!this.aiAgentState) return;
        const panel = document.getElementById('aiAgentPanel');
        const toggle = document.getElementById('aiAgentToggle');
        this.aiAgentState.open = typeof open === 'boolean' ? open : !this.aiAgentState.open;
        const isOpen = this.aiAgentState.open;
        if (panel) {
            if (isOpen) panel.classList.remove('hidden');
            else panel.classList.add('hidden');
        }
        if (toggle) {
            if (isOpen) toggle.classList.add('bg-slate-900', 'text-emerald-300');
            else toggle.classList.remove('bg-slate-900', 'text-emerald-300');
        }
    },
    
    buildWorkBrainSnapshot: function(now) {
        const posts = this.data.posts || [];
        const logs = this.data.logs || [];
        let intel = null;
        if (posts.length && typeof this.processIntelligence === 'function') {
            intel = this.processIntelligence(posts, logs || []);
        }
        const horizons = {
            today: { tasks: [], posts: [] },
            tomorrow: { tasks: [], posts: [] },
            week: { tasks: [], posts: [] },
            month: { tasks: [], posts: [] }
        };
        const tasks = Array.isArray(this.data.tasks) ? this.data.tasks : [];
        const nowDate = new Date(now.getFullYear(), now.getMonth(), now.getDate());
        const classify = (dateStr) => {
            if (!dateStr) return '';
            const s = String(dateStr);
            let d = new Date(s);
            if (Number.isNaN(d.getTime())) {
                const parts = s.split('-').map(Number);
                if (parts.length === 3) {
                    const a = parts[0];
                    const b = parts[1];
                    const c = parts[2];
                    if (!Number.isNaN(a) && !Number.isNaN(b) && !Number.isNaN(c)) {
                        if (a > 31) d = new Date(a, b - 1, c);
                        else if (c > 31) d = new Date(c, b - 1, a);
                    }
                }
            }
            if (Number.isNaN(d.getTime())) return '';
            const dOnly = new Date(d.getFullYear(), d.getMonth(), d.getDate());
            const diffDays = Math.round((dOnly.getTime() - nowDate.getTime()) / 86400000);
            if (diffDays === 0) return 'today';
            if (diffDays === 1) return 'tomorrow';
            if (diffDays > 1 && diffDays <= 7) return 'week';
            if (dOnly.getMonth() === nowDate.getMonth() && dOnly.getFullYear() === nowDate.getFullYear()) return 'month';
            return '';
        };
        for (let i = 0; i < tasks.length; i++) {
            const t = tasks[i] || {};
            const horizon = classify(t.dueDate || t.date || null);
            if (!horizon || !horizons[horizon]) continue;
            horizons[horizon].tasks.push({
                id: t.id,
                title: t.title || 'Untitled task',
                status: t.status || 'pending',
                priority: t.priority || 'P3',
                date: t.dueDate || t.date || null
            });
        }
        for (let i = 0; i < posts.length; i++) {
            const p = posts[i] || {};
            const horizon = classify(p.date || null);
            if (!horizon || !horizons[horizon]) continue;
            horizons[horizon].posts.push({
                id: p.id,
                title: p.product_name || p.caption || 'Scheduled post',
                status: p.status || 'draft',
                date: p.date || null
            });
        }
        const plannerGrid = this.plannerState && Array.isArray(this.plannerState.grid) ? this.plannerState.grid : [];
        for (let i = 0; i < plannerGrid.length; i++) {
            const slot = plannerGrid[i];
            if (!slot || !slot.schedule) continue;
            const horizon = classify(slot.schedule);
            if (!horizon || !horizons[horizon]) continue;
            horizons[horizon].posts.push({
                id: slot.id || ('plan_' + i),
                title: slot.caption || slot.product_name || 'Planned slot #' + (i + 1),
                status: 'planned',
                date: slot.schedule
            });
        }
        const metrics = {
            system: { activeUsers: null, requestsPerMinute: null, errorRate: null, healthScore: null, apiSuccessRate: null, responseTimeMs: null },
            activity: { recent: [], topEndpoints: [] },
            intelligence: { highRiskCount: 0, pendingTodayCount: 0, avgCreationRate: 0 }
        };
        const overview = this.research && this.research.data && this.research.data.overview ? this.research.data.overview : null;
        if (overview && overview.metrics) {
            const m = overview.metrics;
            metrics.system.activeUsers = m.active_users ?? null;
            metrics.system.requestsPerMinute = m.requests_per_minute ?? null;
            metrics.system.errorRate = m.error_rate ?? null;
            metrics.system.healthScore = m.health_score ?? null;
            metrics.system.apiSuccessRate = m.api_success_rate ?? null;
            metrics.system.responseTimeMs = m.avg_response_time ?? null;
        }
        if (overview && Array.isArray(overview.recent_activity)) {
            metrics.activity.recent = overview.recent_activity.slice(0, 10);
        }
        const api = this.research && this.research.data && this.research.data.api_analytics ? this.research.data.api_analytics : null;
        if (api && api.top_endpoints) {
            const endpoints = api.top_endpoints;
            const list = [];
            for (const key in endpoints) {
                if (Object.prototype.hasOwnProperty.call(endpoints, key)) {
                    list.push({ path: key, value: endpoints[key] });
                }
            }
            metrics.activity.topEndpoints = list;
        }
        if (intel && Array.isArray(intel.posts)) {
            metrics.intelligence.avgCreationRate = intel.avgCreationRate || 0;
            const highRisk = intel.posts.filter(p => p.risk > 80 && p.status !== 'posted');
            metrics.intelligence.highRiskCount = highRisk.length;
            const pendingToday = intel.posts.filter(p => p.daysLeft === 0 && p.status !== 'posted');
            metrics.intelligence.pendingTodayCount = pendingToday.length;
        }
        const snapshot = {
            generatedAt: now,
            horizons: horizons,
            metrics: metrics
        };
        this.data.workBrainSnapshot = snapshot;
        return snapshot;
    },
    
    initAiAgent: function() {
        if (!this.aiAgentState) {
            this.aiAgentState = {
                virtualOffsetMinutes: 0,
                refreshIntervalMs: 10000,
                previous: {},
                weights: { priority: 1, urgency: 1, risk: 1 },
                open: false,
                initialized: false
            };
        }
        if (this.aiAgentState.initialized) return;
        this.aiAgentState.initialized = true;
        const toggle = document.getElementById('aiAgentToggle');
        const closeBtn = document.getElementById('aiAgentClose');
        const offsetInput = document.getElementById('aiAgentOffsetInput');
        const offsetApply = document.getElementById('aiAgentOffsetApply');
        const focus = document.getElementById('aiAgentFocusMode');
        if (toggle) {
            toggle.addEventListener('click', () => {
                this.toggleAiAgentPanel(!this.aiAgentState.open);
            });
        }
        if (closeBtn) {
            closeBtn.addEventListener('click', () => {
                this.toggleAiAgentPanel(false);
            });
        }
        if (offsetApply && offsetInput) {
            offsetApply.addEventListener('click', () => {
                const v = parseFloat(offsetInput.value || '0');
                if (!Number.isNaN(v)) {
                    this.aiAgentState.virtualOffsetMinutes = v;
                    const now = this.getVirtualNow();
                    const preds = this.computeAiAgentPredictions(now);
                    this.updateAiAgentPredictions(preds, now);
                }
            });
        }
        if (focus) {
            focus.addEventListener('change', () => {
                this.applyAiAgentFocusMode(focus.value);
                const now = this.getVirtualNow();
                const preds = this.computeAiAgentPredictions(now);
                this.updateAiAgentPredictions(preds, now);
            });
        }
        const now = this.getVirtualNow();
        const preds = this.computeAiAgentPredictions(now);
        this.updateAiAgentPredictions(preds, now);
        this.scheduleNextAiAgentUpdate();
        const queryInput = document.getElementById('aiAgentQueryInput');
        const queryButton = document.getElementById('aiAgentQuerySend');
        if (queryInput && queryButton) {
            const handler = () => {
                const v = queryInput.value || '';
                this.applyAiAgentQuery(v);
            };
            queryButton.addEventListener('click', handler);
            queryInput.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    handler();
                }
            });
        }
    },
    
