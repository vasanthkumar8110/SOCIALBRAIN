    exportData: function(format = 'xlsx') {
        const posts = this.data.posts || [];
        const exportData = posts.map(p => {
            const status = (p.status || 'draft').toUpperCase();
            const platform = (this.data.platforms || []).find(plat => plat.id === p.platform);
            const product = (this.data.products || []).find(prod => prod.id === p.product_id) || {};
            
            // Check for missing items
            const missing = [];
            if (!p.platform) missing.push('Platform');
            if (!p.post_type) missing.push('Type');
            if (!p.product_id) missing.push('Product Selection');
            if (!p.post_time) missing.push('Schedule Time');

            return {
                'Date': p.date,
                'Platform': platform ? platform.name : (p.platform || 'N/A'),
                'Context': p.fb_context || '---',
                'Post Type': (p.post_type || 'N/A').replace(/_/g, ' '),
                'Product Name': product.name || p.product_name || 'MISSING',
                'Product Code': product.code || 'N/A',
                'Schedule Time': p.post_time || 'NOT SET',
                'Status': status,
                'Price': product.price || 0,
                'Missing Inputs': missing.length > 0 ? missing.join(', ') : 'NONE'
            };
        });

        if (format === 'csv') {
            if (exportData.length === 0) {
                this.showToast('No data to export', 'info');
                return;
            }
            const headers = Object.keys(exportData[0]).join(',');
            const rows = exportData.map(row => Object.values(row).map(v => {
                const str = String(v).replace(/"/g, '""');
                return `"${str}"`;
            }).join(','));
            const csvContent = headers + "\n" + rows.join("\n");
            
            const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const link = document.createElement("a");
            link.setAttribute("href", url);
            link.setAttribute("download", `CCSMM_Calendar_Export_${new Date().toISOString().split('T')[0]}.csv`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        } else {
            // XLSX using SheetJS
            const ws = XLSX.utils.json_to_sheet(exportData);
            const wb = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(wb, ws, "Posts");
            XLSX.writeFile(wb, `CCSMM_Calendar_Export_${new Date().toISOString().split('T')[0]}.xlsx`);
            this.showToast('Excel Export Ready!', 'success');
        }
    },

