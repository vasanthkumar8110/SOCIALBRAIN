    deletePost: async function(id, skipConfirm = false, isFromModal = false) {
        if(!skipConfirm && !confirm('Are you sure you want to delete this post?')) return;
        
        let undoTimer = null;
        let deletedPostId = id;
        
        try {
            const res = await fetch('?action=delete_post', { 
                method: 'POST', 
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({id}) 
            });
            const result = await res.json();
            if(result.success) {
                await this.loadData();
                this.renderKanban();
                this.renderCalendar();
                this.renderDashboard();
                if(isFromModal) {
                    this.viewDayDetail(this.state.currentDetailDate);
                }
                
                // Show undo toast
                const container = document.getElementById('toastContainer');
                const toast = document.createElement('div');
                toast.className = 'toast info';
                toast.innerHTML = `
                    <i class="fas fa-info-circle text-blue-500 text-xl"></i>
                    <div class="flex-1 font-medium">Post deleted</div>
                    <button onclick="App.undoDelete('${deletedPostId}')" class="bg-blue-600 text-white px-3 py-1 rounded-lg text-sm font-bold hover:bg-blue-700 transition">
                        UNDO
                    </button>
                `;
                container.appendChild(toast);
                
                // Auto-remove after 5 seconds
                undoTimer = setTimeout(() => {
                    if (toast.parentNode) {
                        toast.classList.add('toast-exit');
                        setTimeout(() => toast.remove(), 300);
                    }
                }, 5000);
                
                // Store timer for undo
                toast.dataset.timer = undoTimer;
                toast.dataset.postId = deletedPostId;
            } else {
                this.showToast(result.message, 'error');
            }
        } catch(e) {
            this.showToast('Error deleting post', 'error');
        }
    },

    undoDelete: async function(postId) {
        try {
            const res = await fetch('?action=restore_post', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({id: postId})
            });
            const result = await res.json();
            if(result.success) {
                // Remove the undo toast
                const toasts = document.querySelectorAll('.toast');
                toasts.forEach(t => {
                    if(t.dataset.postId === postId) {
                        clearTimeout(parseInt(t.dataset.timer));
                        t.remove();
                    }
                });
                
                await this.loadData();
                this.renderKanban();
                this.renderCalendar();
                this.renderDashboard();
                this.showToast('Post restored!', 'success');
            } else {
                this.showToast(result.message, 'error');
            }
        } catch(e) {
            this.showToast('Error restoring post', 'error');
        }
    },

