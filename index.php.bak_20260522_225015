    // --- Intelligence Brain Engine ---
    renderAnalytics: function() {
        if (typeof Chart === 'undefined') {
            this.showToast('Logic Brain: Chart library missing.', 'error');
            return;
        }

        const posts = this.data.posts || [];
        const logs = this.data.logs || [];
        
        if (posts.length === 0) {
            document.getElementById('guidanceTitle').textContent = 'Intelligence Standby';
            document.getElementById('guidanceMessage').textContent = 'The predictive engine requires active posts and historical logs to generate insights.';
            return;
        }

        const brain = this.processIntelligence(posts, logs);
        
        this.renderInsightEngine(brain);
        this.renderLoadForecast(brain);
        this.renderPriorityMatrix(brain);
        this.renderRiskEscalation(brain);
        this.renderStatusDrift(brain);
        this.renderEfficiencyScore(brain);
    },

    processIntelligence: function(posts, logs) {
        const now = new Date();
        const thirtyDaysAhead = new Date();
        thirtyDaysAhead.setDate(now.getDate() + 30);

        // 1. Load Forecasting Logic
        const dailyCreationWeights = {};
        logs.filter(l => l.action === 'post_created').forEach(l => {
            const date = l.timestamp.split('T')[0];
            dailyCreationWeights[date] = (dailyCreationWeights[date] || 0) + 1;
        });
        
        const avgCreationRate = Object.values(dailyCreationWeights).length > 0 
            ? Object.values(dailyCreationWeights).reduce((a,b) => a+b, 0) / Object.values(dailyCreationWeights).length 
            : 0.5;

        // 2. Risk & Impact Scoring
        const scoredPosts = posts.map(post => {
            const [d, m, y] = (post.date || '').split('-').map(Number);
            const dueDate = new Date(y, m - 1, d);
            const daysLeft = Math.ceil((dueDate - now) / (1000 * 60 * 60 * 24));
            
            // Urgency (0-1)
            const urgency = daysLeft <= 0 ? 1 : Math.max(0, 1 - (daysLeft / 14));
            
            // Impact (Platform & Product based)
            let impact = 0.5;
            if (['Facebook', 'Instagram', 'TikTok'].includes(post.platform)) impact += 0.2;
            if (post.status === 'approved') impact += 0.1;

            // Risk Score (0-100)
            const reschedules = logs.filter(l => l.action === 'post_rescheduled' && l.details.post_id === post.id).length;
            let risk = (urgency * 60) + (reschedules * 15);
            if (post.status === 'posted') risk = 0;
            if (daysLeft < 0 && post.status !== 'posted') risk = 100;

            return { ...post, urgency, impact, risk, daysLeft };
        });

        return {
            posts: scoredPosts,
            avgCreationRate,
            now,
            thirtyDaysAhead
        };
    },

    renderInsightEngine: function(brain) {
        const title = document.getElementById('guidanceTitle');
        const message = document.getElementById('guidanceMessage');
        const icon = document.getElementById('guidanceIcon');
        const panel = document.getElementById('actionGuidance');

        const highRisk = brain.posts.filter(p => p.risk > 80 && p.status !== 'posted');
        const pendingToday = brain.posts.filter(p => p.daysLeft === 0 && p.status !== 'posted');

        if (highRisk.length > 0) {
            panel.className = 'premium-card p-6 mb-8 border border-rose-100 bg-white rounded-2xl relative overflow-hidden flex items-start gap-4';
            icon.className = 'h-12 w-12 rounded-xl bg-rose-50 flex items-center justify-center text-rose-600 text-2xl';
            title.textContent = `High risk: ${highRisk.length} posts at risk`;
            message.textContent = `Historical patterns and deadline proximity show ${highRisk.length} posts need immediate attention to avoid gaps.`;
        } else if (pendingToday.length > 0) {
            panel.className = 'premium-card p-6 mb-8 border border-amber-100 bg-white rounded-2xl relative overflow-hidden flex items-start gap-4';
            icon.className = 'h-12 w-12 rounded-xl bg-amber-50 flex items-center justify-center text-amber-600 text-2xl';
            title.textContent = `Load spike: ${pendingToday.length} deadlines today`;
            message.textContent = `Workload clusters on today. Move ${Math.ceil(pendingToday.length/2)} posts into "ongoing" to smooth pressure.`;
        } else {
            panel.className = 'premium-card p-6 mb-8 border border-emerald-100 bg-white rounded-2xl relative overflow-hidden flex items-start gap-4';
            icon.className = 'h-12 w-12 rounded-xl bg-emerald-50 flex items-center justify-center text-emerald-600 text-2xl';
            title.textContent = 'Path clear';
            message.textContent = 'No major risk detected for the next 48 hours. Use the week to grow your best performing lanes.';
        }
    },

    renderLoadForecast: function(brain) {
        const ctx = document.getElementById('loadForecastChart');
        if (!ctx) return;

        const labels = [];
        const forecastData = [];
        const actualData = [];

        for (let i = 0; i < 30; i++) {
            const d = new Date();
            d.setDate(d.getDate() + i);
            const dateStr = d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
            labels.push(dateStr);

            const pendingOnDay = brain.posts.filter(p => {
                const [pd, pm, py] = (p.date || '').split('-').map(Number);
                const pDate = new Date(py, pm - 1, pd);
                return pDate.toDateString() === d.toDateString() && p.status !== 'posted';
            }).length;

            actualData.push(pendingOnDay);
            // Simple Linear Projection
            forecastData.push(pendingOnDay + (brain.avgCreationRate * (i/10)));
        }

        if (this.charts.load) this.charts.load.destroy();
        this.charts.load = new Chart(ctx, {
            type: 'line',
            data: {
                labels,
                datasets: [
                    { label: 'Baseline Load', data: actualData, borderColor: '#3b82f6', backgroundColor: 'rgba(59, 130, 246, 0.1)', fill: true, tension: 0.4 },
                    { label: 'Predicted Pressure', data: forecastData, borderColor: '#94a3b8', borderDash: [5, 5], tension: 0.4 }
                ]
            },
            options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'top' } } }
        });
    },

    renderPriorityMatrix: function(brain) {
        const ctx = document.getElementById('priorityMatrixChart');
        if (!ctx) return;

        const data = brain.posts.filter(p => p.status !== 'posted').map(p => ({
            x: p.urgency * 10,
            y: p.impact * 10,
            r: 8
        }));

        if (this.charts.matrix) this.charts.matrix.destroy();
        this.charts.matrix = new Chart(ctx, {
            type: 'bubble',
            data: {
                datasets: [{
                    label: 'Post Priority',
                    data: data,
                    backgroundColor: 'rgba(59, 130, 246, 0.6)'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    x: { title: { display: true, text: 'Urgency' }, min: 0, max: 10 },
                    y: { title: { display: true, text: 'Impact' }, min: 0, max: 10 }
                },
                plugins: {
                    tooltip: {
                        callbacks: {
                            label: (c) => `U: ${c.raw.x}, I: ${c.raw.y}`
                        }
                    }
                }
            }
        });
    },

    renderRiskEscalation: function(brain) {
        const ctx = document.getElementById('riskChart');
        if (!ctx) return;

        // SAFEGUARD: Filter out null/undefined posts first
        const safePosts = (brain.posts || []).filter(p => p && typeof p === 'object');
        
        const sorted = safePosts.filter(p => p.status !== 'posted').sort((a,b) => (b.risk || 0) - (a.risk || 0)).slice(0, 10);

        if (this.charts.risk) this.charts.risk.destroy();
        this.charts.risk = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: sorted.map(p => (p.title || p.product_name || 'Untitled').substring(0, 10) + '...'),
                datasets: [{
                    label: 'Risk Score',
                    data: sorted.map(p => p.risk || 0),
                    backgroundColor: sorted.map(p => (p.risk || 0) > 80 ? '#ef4444' : (p.risk || 0) > 50 ? '#f59e0b' : '#3b82f6')
                }]
            },
            options: { responsive: true, maintainAspectRatio: false, indexAxis: 'y' }
        });
    },

    renderStatusDrift: function(brain) {
        const ctx = document.getElementById('driftChart');
        if (!ctx) return;

        const drifts = { 'Ongoing': 0, 'Approved': 0, 'Draft': 0 };
        (brain.posts || []).forEach(p => {
             if (!p || !p.status) return;
             const status = p.status.charAt(0).toUpperCase() + p.status.slice(1);
             if (drifts.hasOwnProperty(status)) drifts[status]++;
        });

        if (this.charts.drift) this.charts.drift.destroy();
