    mountResearchPanel: function(view) {
        const panel = document.getElementById('researchPanel');
        if (!panel) return;

        const target =
            view === 'dashboard'
                ? document.getElementById('researchMount-dashboard')
                : view === 'analytics'
                    ? document.getElementById('researchMount-analytics')
                    : null;

        if (!target) {
            panel.classList.add('hidden');
            return;
        }

        if (panel.parentElement !== target) {
            target.appendChild(panel);
        }
        panel.classList.remove('hidden');
    },

    switchView: function(view) {
        const currentUser = this.data.current_user || {};
        if (view === 'research' || view === 'analytics') view = 'dashboard';
        
        // RBAC: Viewer Panel Lock
        const assignedPanel = currentUser.assigned_panel === 'research' ? 'dashboard' : (currentUser.assigned_panel || '');
        if (currentUser.role === 'viewer' && assignedPanel && view !== assignedPanel) {
            this.showToast('Access restricted to assigned panel', 'error');
            return false;
        }
        
        // RBAC: Block Admin Access for Non-Admins with Blur Overlay
        if (view === 'admin') {
            if (currentUser.role !== 'admin') {
                const overlay = document.getElementById('adminRestrictionOverlay');
                if(overlay) overlay.classList.remove('hidden');
                return false; // Stop switching view
            }
        }

        // Hide all views first
        document.querySelectorAll('.view-panel').forEach(el => {
            el.classList.add('hidden');
            el.classList.remove('fade-in'); // Reset animation
        });
        
        const newViewEl = document.getElementById('view-' + view);
        if (newViewEl) {
            newViewEl.classList.remove('hidden');
            // Trigger reflow to restart animation if needed
            void newViewEl.offsetWidth;
            newViewEl.classList.add('fade-in');
        } else {
            return false;
        }
        
        document.querySelectorAll('nav button.nav-btn-liquid').forEach(btn => {
            btn.classList.remove('nav-active');
            btn.classList.remove('text-slate-900');
            btn.classList.add('text-slate-600');
        });
        const navBtn = document.getElementById('nav-' + view);
        if (navBtn) {
            navBtn.classList.remove('text-slate-600');
            navBtn.classList.add('nav-active');
            navBtn.classList.add('text-slate-900');
        }

        this.state.currentView = view;
        this.saveState();

        this.mountResearchPanel(view);

        if(view === 'dashboard') {
            this.renderDashboard();
            this.renderResearch();
        }
        if(view === 'kanban') this.renderKanban();
        if(view === 'calendar') this.renderCalendar();
        if(view === 'tasks') {
            this.renderTasksView();
        }
        if(view === 'planner') {
            this.loadPlannerData();
        }

        document.querySelectorAll('#mobileMenu .group').forEach(btn => {
            btn.classList.remove('mobile-nav-active');
            btn.classList.remove('ring-2');
            btn.classList.remove('ring-emerald-400');
        });
        let mobileBtn = null;
        if (view === 'tasks') {
            mobileBtn = document.querySelector('#mobileMenu button[onclick^="App.openTasksFromNavbar"]');
        } else {
            mobileBtn = document.querySelector(`#mobileMenu button[onclick*="'${view}'"]`);
        }
        if (mobileBtn) {
            mobileBtn.classList.add('mobile-nav-active');
            mobileBtn.classList.add('ring-2');
            mobileBtn.classList.add('ring-emerald-400');
        }
        return true;
    },

