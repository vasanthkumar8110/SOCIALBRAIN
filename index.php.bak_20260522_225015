    applyCalendarPostToSlot: function(postId) {
        const idx = this.plannerState.selectedSlot;
        if (idx === null) {
            this.showToast('Select a grid slot first', 'info');
            return;
        }
        const posts = this.data.posts || [];
        const post = posts.find(p => p.id === postId);
        if (!post) {
            this.showToast('Calendar post not found', 'error');
            return;
        }
        const rawDate = String(post.date || '').trim();
        if (!rawDate) {
            this.showToast('Selected post has no date. Set date in calendar first.', 'error');
            return;
        }
        const parts = rawDate.split('-').map(Number);
        if (parts.length !== 3 || !parts[0] || !parts[1] || !parts[2]) {
            this.showToast('Selected post has invalid date format.', 'error');
            return;
        }
        const dt = new Date(parts[2], parts[1] - 1, parts[0]);
        if (Number.isNaN(dt.getTime())) {
            this.showToast('Selected post has invalid date.', 'error');
            return;
        }
        const pad = (n) => String(n).padStart(2, '0');
        const isoDate = `${dt.getFullYear()}-${pad(dt.getMonth() + 1)}-${pad(dt.getDate())}`;
        let timeStr = String(post.post_time || '').slice(0, 5);
        if (!/^\d{2}:\d{2}$/.test(timeStr)) timeStr = '12:00';
        const schedule = `${isoDate}T${timeStr}`;
        if (!this.plannerState.grid[idx]) this.plannerState.grid[idx] = {};
        const item = this.plannerState.grid[idx];
        item.id = post.id;
        item.caption = post.caption || '';
        item.image = post.media_url || '';
        item.type = post.type || 'image';
        item.product_id = post.product_id || null;
        item.product_name = post.product_name || '';
        const platformId = post.platform_id || post.platform || 'instagram';
        item.platform_id = platformId;
        item.schedule = schedule;
        this.renderPlannerGrid();
        this.plannerSelectSlot(idx);
        this.closePlannerCalendarModal();
        this.showToast('Calendar post applied to grid slot.', 'success');
        this.plannerSave();
    },

    plannerDragStart: function(e, index) {
        e.dataTransfer.setData('text/plain', index);
        e.dataTransfer.effectAllowed = 'move';
        this.dragSrcIndex = index; // Fallback
    },

    plannerDragOver: function(e) {
        e.preventDefault(); // Necessary to allow dropping
        e.dataTransfer.dropEffect = 'move';
        return false;
    },

    plannerDrop: function(e, index) {
        e.stopPropagation(); // stops the browser from redirecting.
        e.preventDefault();

        const srcIndex = parseInt(e.dataTransfer.getData('text/plain'));
        if (srcIndex === index) return;

        // Swap Data
        const temp = this.plannerState.grid[srcIndex];
        this.plannerState.grid[srcIndex] = this.plannerState.grid[index];
        this.plannerState.grid[index] = temp;

        // If currently editing one of these slots, refresh editor
        if (this.plannerState.selectedSlot === srcIndex) {
            this.plannerSelectSlot(index);
        } else if (this.plannerState.selectedSlot === index) {
            this.plannerSelectSlot(srcIndex);
        }

        this.renderPlannerGrid();
        this.plannerSave(); // Auto-save on rearrange
        return false;
    },

