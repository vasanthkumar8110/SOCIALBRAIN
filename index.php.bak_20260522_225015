if ($action === 'recover_from_log' && $method === 'POST') {
    $input = json_decode(file_get_contents('php://input'), true);
    $logId = $input['log_id'] ?? '';
    if ($logId === '') {
        jsonResponse(null, false, 'Log id is required');
    }

    $masterData = loadJSON(MASTER_BRAIN_FILE);
    $currentTeamId = $_SESSION['team_id'] ?? '';
    if (!isset($masterData['logs']) || !is_array($masterData['logs'])) {
        jsonResponse(null, false, 'No logs available');
    }

    $logs = $masterData['logs'];
    $logIndex = null;
    $logEntry = null;
    foreach ($logs as $idx => $l) {
        if (isset($l['id']) && $l['id'] === $logId) {
            $team = $l['details']['team'] ?? ($l['team'] ?? null);
            if ($currentTeamId && $team !== $currentTeamId) {
                jsonResponse(null, false, 'Cannot recover log from another team');
            }
            $logIndex = $idx;
            $logEntry = $l;
            break;
        }
    }

    if ($logIndex === null || !$logEntry) {
        jsonResponse(null, false, 'Log entry not found');
    }

    if (isset($logEntry['revoked_at'])) {
        jsonResponse(null, false, 'Log already revoked');
    }

    $actionFromLog = $logEntry['action'] ?? '';
    $details = $logEntry['details'] ?? [];

    if ($actionFromLog === 'post_soft_deleted') {
        $postId = $details['post_id'] ?? '';
        if ($postId === '') {
            jsonResponse(null, false, 'Post id missing in log details');
        }

        if (!isset($masterData['posts']) || !is_array($masterData['posts'])) {
            jsonResponse(null, false, 'No posts available for recovery');
        }

        $restored = false;
        $restoredProductName = null;
        foreach ($masterData['posts'] as &$post) {
            if (isset($post['id']) && $post['id'] === $postId) {
                // Security: Ensure post belongs to my team
                if (isset($post['team_id']) && $post['team_id'] !== $_SESSION['team_id']) {
                    jsonResponse(null, false, 'Unauthorized: Cannot restore post from another team');
                }

                if (isset($post['product_name'])) {
                    $restoredProductName = $post['product_name'];
                }
                unset($post['deleted_at']);
                unset($post['deleted_by']);
                $restored = true;
                break;
            }
        }
        unset($post);

        if (!$restored) {
            jsonResponse(null, false, 'Post not found for this log or unauthorized');
        }

        $logs[$logIndex]['revoked_at'] = date('c');
        $logs[$logIndex]['revoked_by'] = $_SESSION['user_id'] ?? 'system';
        $masterData['logs'] = $logs;

        saveJSON(MASTER_BRAIN_FILE, $masterData);

        if (isset($_SESSION['user_id']) && function_exists('logActivity')) {
            $restoreDetails = ['post_id' => $postId];
            if ($restoredProductName) {
                $restoreDetails['product'] = $restoredProductName;
            }
            logActivity($_SESSION['user_id'], 'post_restored_from_log', $restoreDetails);
        }

        jsonResponse(['post_id' => $postId], true, 'Post recovered and log revoked');
    }

    jsonResponse(null, false, 'Recovery not supported for this action type yet');
}

