        if (idx !== null) {
            if (!this.plannerState.grid[idx]) this.plannerState.grid[idx] = {};
            this.plannerState.grid[idx].schedule = this.normalizePlannerSchedule(date);
            this.renderPlannerGrid(); // Update grid icon
            this.plannerSave();
        }
    },

