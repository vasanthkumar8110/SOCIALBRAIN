        document.getElementById('dayDetailTitle').textContent = `Content for ${dateStr}`;
        const list = document.getElementById('dayDetailList');
        list.innerHTML = '';
        const showTasksBtn = document.getElementById('dayDetailShowTasksBtn');
        if (showTasksBtn) {
            showTasksBtn.classList.add('hidden');
            showTasksBtn.onclick = null;
        }

        if (posts.length === 0 && tasks.length === 0) {
            list.innerHTML = '<div class="text-center text-slate-400 py-8">No content or tasks for this day</div>';
            if (showTasksBtn) {
                showTasksBtn.classList.add('hidden');
                showTasksBtn.onclick = null;
            }
