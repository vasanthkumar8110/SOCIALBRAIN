        // Show loading
        resultDiv.classList.remove('hidden');
        resultDiv.innerHTML = '<div class="flex items-center gap-2"><i class="fas fa-spinner fa-spin text-indigo-500"></i> Thinking...</div>';
        
        // Simulate AI
        setTimeout(() => {
            const suggestions = [
                `✨ ${prompt} vibes only! #SocialBrain #${prompt.replace(/\s+/g, '')}`,
                `Thinking about ${prompt}? So are we. Let's discuss! 👇`,
                `🔥 Hot take: ${prompt} is the new black. Do you agree?`,
                `Daily dose of ${prompt} for your feed. 💫`,
