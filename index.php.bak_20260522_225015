        if (!preg_match('/^\d{2}-\d{2}-\d{4}$/', $date)) continue;

        // Resolve Platform
        $platformId = '';
        foreach($platforms as $p) {
            if (strtolower($p['name']) === strtolower($platformName)) {
                $platformId = $p['id'];
                break;
            }
        }
        if (!$platformId) $platformId = strtolower($platformName);

        // Resolve Product
        $targetProduct = null;
        foreach ($products as $p) {
            // Security: Only match products from my team
            if (isset($p['team_id']) && $p['team_id'] !== $_SESSION['team_id']) continue;

            if (strtolower($p['name']) === strtolower($productSearch) || (isset($p['code']) && strtolower($p['code']) === strtolower($productSearch))) {
                $targetProduct = $p;
                break;
            }
        }

        if (!$targetProduct) continue; // Skip if product not found

        $newPost = [
            'id' => generateID('post_'),
            'date' => $date,
            'platform' => $platformId,
            'post_type' => str_replace(' ', '_', $postType),
            'product_id' => $targetProduct['id'],
            'product_name' => $targetProduct['name'],
            'sector_id' => $targetProduct['sector_id'] ?? '',
            'category_id' => $targetProduct['category_id'] ?? '',
            'sub_category_id' => $targetProduct['sub_category_id'] ?? '',
            'post_time' => $time,
            'status' => $status,
            'created_at' => date('c'),
            'updated_at' => date('c'),
            'created_by' => $_SESSION['user_id'],
            'team_id' => $_SESSION['team_id']
        ];

        $masterData['posts'][] = $newPost;
        $added++;
    }
    
    fclose($handle);
    saveJSON(MASTER_BRAIN_FILE, $masterData);
    logActivity($_SESSION['user_id'], 'bulk_upload_posts', ['count' => $added]);
    
    $msg = "Import Complete: Added {$added} posts.";
    if ($added === 0) jsonResponse(null, false, "No valid posts found in CSV. Check date format (DD-MM-YYYY) and Product Names.");
    jsonResponse(null, true, $msg);
}

