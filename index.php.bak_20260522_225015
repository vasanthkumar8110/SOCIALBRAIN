    initEngagementHotkeys: function() {
        const handler = (e) => {
            // Avoid triggering if user is typing in an input or textarea
            if (['INPUT', 'TEXTAREA'].includes(document.activeElement.tagName)) return;
            
            // Check for Shift as modifier
            if (!e.shiftKey) return;

            const key = (e.key || '').toLowerCase();
            if (key === 'w') { e.preventDefault(); this.highlightEngagementDays('whatsapp'); }
            else if (key === 'i') { e.preventDefault(); this.highlightEngagementDays('instagram'); }
            else if (key === 'f') { e.preventDefault(); this.highlightEngagementDays('facebook'); }
            else if (key === 'e') { e.preventDefault(); this.openHolidayModal(); }
        };

        window.addEventListener('keydown', handler);
        window.addEventListener('keyup', (e) => {
            // Clear if Shift is released or if the specific key is released
            const key = (e.key || '').toLowerCase();
            if (e.key === 'Shift' || ['w','i','f'].includes(key)) {
                this.clearEngagementHighlights();
            }
        });
        window.addEventListener('blur', () => this.clearEngagementHighlights());
    },

    highlightEngagementDays: function(platform) {
        this.clearEngagementHighlights();
        const month = this.state.currentDate.getMonth();
        const data = this.engagementData[month];
        if (!data) return;

        let days = data[platform] || [];
        if (data.all) days = [...days, ...data.all];
        
        if (days.length === 0) return;

        const expandedDays = [];
        days.forEach(range => {
            for (let d = range[0]; d <= range[1]; d++) {
                expandedDays.push(d);
            }
        });

        const cells = document.querySelectorAll('.calendar-cell');
        cells.forEach(cell => {
            // Look for the span containing the day number (d)
            const dayNumSpan = cell.querySelector('span.font-bold');
            if (dayNumSpan) {
                const dayValue = parseInt(dayNumSpan.textContent.trim());
                if (!isNaN(dayValue) && expandedDays.includes(dayValue)) {
                    cell.classList.add(`high-eng-${platform}`);
                }
            }
        });
    },

    clearEngagementHighlights: function() {
        document.querySelectorAll('.calendar-cell').forEach(cell => {
            cell.classList.remove('high-eng-whatsapp', 'high-eng-instagram', 'high-eng-facebook');
        });
    },

