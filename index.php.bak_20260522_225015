                    const confirmRecover = window.confirm('Recover last 1-day snapshot? This will overwrite current brain data.');
                    if (!confirmRecover) return;
                    try {
                        const res = await fetch('?action=recover_last_day', { method: 'POST' });
                        const json = await res.json();
                        if (json.success) {
                            this.showToast('Brain recovered from last 1-day snapshot', 'success');
                            await this.loadData();
                            await this.loadLogs();
                        } else {
                            this.showToast(json.message || 'Recovery failed', 'error');
                        }
                    } catch (e) {
                        console.error('Recover Error:', e);
                        this.showToast('Error during recovery', 'error');
                    }
                });
            }
        } catch(e) {
            console.error('Log Load Error:', e);
            container.innerHTML = '<div class="text-red-500 p-4 text-center">Failed to load system logs. <button onclick="App.switchView(\'dashboard\')" class="ml-2 text-purple-600 underline">Try Intelligence Center</button></div>';
        }
    },

    // R&D Intelligence: Calculate activity insights
    calculateActivityInsights: function(logs) {
        const now = new Date();
        const last24h = logs.filter(log => {
            const logTime = new Date(log.timestamp);
            return (now - logTime) < (24 * 60 * 60 * 1000);
        });

        const actionCounts = {};
        logs.forEach(log => {
            actionCounts[log.action] = (actionCounts[log.action] || 0) + 1;
        });

        const topAction = Object.keys(actionCounts).reduce((a, b) => 
            actionCounts[a] > actionCounts[b] ? a : b, 'none'
        );

        return {
            totalActions: logs.length,
            uniqueUsers: new Set(logs.map(l => l.user_id)).size,
            topAction: topAction.replace(/_/g, ' '),
            recentActivity: last24h.length
        };
    },

    // R&D Intelligence: Calculate activity score
    calculateActivityScore: function(log) {
        const actionScores = {
            'post_created': 90,
            'product_added': 85,
            'sector_saved': 80,
            'api_key_created': 95,
            'bulk_upload_products': 100,
            'export_products': 75,
            'login': 50,
            'post_updated': 70,
            'post_soft_deleted': 60,
            'delete_task': 60,
            'product_deleted': 60
        };

        const baseScore = actionScores[log.action] || 40;
        
        // Bonus for detailed actions
        const detailBonus = log.details && Object.keys(log.details).length > 0 ? 10 : 0;
        
        // Time-based scoring (recent actions get higher scores)
        const logTime = new Date(log.timestamp);
        const now = new Date();
        const hoursSince = (now - logTime) / (1000 * 60 * 60);
        const timeBonus = hoursSince < 1 ? 15 : hoursSince < 24 ? 10 : 0;

        return Math.min(100, baseScore + detailBonus + timeBonus);
    },

    initiateDataDeletion: function(type) {
        const labels = {
            'products': 'ALL Products Data',
            'sectors': 'ALL Sectors & Hierarchies',
            'holidays': 'ALL Main Days/Holidays',
            'logs': 'ALL Activity Logs',
            'api': 'ALL API Keys'
        };

        this.pendingDeletionType = type;
        document.getElementById('destructiveTarget').textContent = labels[type] || type;
        
        // Reset Modal State
        const modal = document.getElementById('destructiveModal');
        const passInput = document.getElementById('destructivePassword');
        const confirmBtn = document.getElementById('destructiveConfirmBtn');
        const timerEl = document.getElementById('destructiveTimer');
        const circle = document.getElementById('countdownCircle');
        const progress = document.getElementById('destructiveProgress');

        passInput.value = '';
        passInput.disabled = true;
        confirmBtn.disabled = true;
        confirmBtn.innerHTML = '<i class="fas fa-trash-alt mr-2"></i>Wait...';
        
        modal.classList.remove('hidden');

        // Start Countdown
        let seconds = 15;
        timerEl.textContent = seconds;
        
        // Reset Circle (251 is circumference of r=40)
        circle.style.strokeDashoffset = '0';
        progress.style.width = '100%';

        if (this.deletionTimer) clearInterval(this.deletionTimer);

        this.deletionTimer = setInterval(() => {
            seconds--;
            timerEl.textContent = seconds;
            
            // Update Visuals
            const offset = 251 - (251 * seconds / 15);
            circle.style.strokeDashoffset = offset;
            progress.style.width = `${(seconds / 15) * 100}%`;

            if (seconds <= 0) {
                clearInterval(this.deletionTimer);
                passInput.disabled = false;
                confirmBtn.disabled = false;
                confirmBtn.innerHTML = '<i class="fas fa-trash-alt mr-2"></i>CONFIRM DELETE';
                passInput.focus();
                this.showToast('Safety timer finished. Enter password to confirm.', 'warning');
