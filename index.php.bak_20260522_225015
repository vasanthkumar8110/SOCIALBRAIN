    // --- Kanban Logic ---
    renderKanban: function() {
        const dropZones = document.querySelectorAll('.kanban-drop-zone');
        if(!dropZones.length) return;
        dropZones.forEach(el => el.innerHTML = '');
        
        const year = this.state.currentDate.getFullYear();
        const month = this.state.currentDate.getMonth();
        const monthNames = this.monthNames;
        
        // Update Kanban Title & Dropdowns
        const mSelect = document.getElementById('kanbanMonthSelect');
        const ySelect = document.getElementById('kanbanYearSelect');
        
        if (mSelect) {
            mSelect.innerHTML = monthNames.map((name, i) => `<option value="${i}" ${i === month ? 'selected' : ''}>${name}</option>`).join('');
        }
        if (ySelect) {
            ySelect.innerHTML = [year-1, year, year+1].map(y => `<option value="${y}" ${y === year ? 'selected' : ''}>${y}</option>`).join('');
        }

        const counts = { draft:0, ongoing:0, approved:0, lost:0, posted:0 };
        
        const now = new Date();
        const todayStr = String(now.getDate()).padStart(2, '0') + '-' + String(now.getMonth() + 1).padStart(2, '0') + '-' + now.getFullYear();
        
        const tomorrow = new Date(); tomorrow.setDate(tomorrow.getDate() + 1);
        const tomorrowStr = String(tomorrow.getDate()).padStart(2, '0') + '-' + String(tomorrow.getMonth() + 1).padStart(2, '0') + '-' + tomorrow.getFullYear();

        const filteredPosts = (this.data.posts || []).filter(p => {
            const parts = (p.date || '').split('-');
            if (parts.length !== 3) return false;
            return parseInt(parts[1]) === (month + 1) && parseInt(parts[2]) === year;
        }).sort((a, b) => {
            const dateA = a.date.split('-').reverse().join('-');
            const dateB = b.date.split('-').reverse().join('-');
            return dateA.localeCompare(dateB);
        });

        filteredPosts.forEach(post => {
            const status = post.status || 'draft';
            if (counts.hasOwnProperty(status)) counts[status]++;
            
            const col = document.querySelector(`.kanban-drop-zone[data-status="${status}"]`);
            if(col) {
                const card = document.createElement('div');
                card.draggable = true;
                card.className = 'bg-white p-3 rounded-xl shadow-sm border border-slate-200 cursor-grab active:cursor-grabbing hover:shadow-md transition relative group select-none';
                card.tabIndex = 0;
                card.addEventListener('mouseenter', (ev) => this.showPostHoverCard(post, ev));
                card.addEventListener('mousemove', (ev) => this.positionPostHoverCard(ev));
                card.addEventListener('mouseleave', () => this.hidePostHoverCard());
                card.addEventListener('focus', () => {
                    const r = card.getBoundingClientRect();
                    this.showPostHoverCard(post, { clientX: r.right, clientY: r.top });
                });
                card.addEventListener('blur', () => this.hidePostHoverCard());
                
                const platform = (this.data.platforms || []).find(p => p && p.id === post.platform);
                const icon = platform ? platform.icon : 'fas fa-question';
                
                let dateBadge = `<span class="text-[10px] font-bold text-slate-400 bg-slate-50 px-1.5 py-0.5 rounded">${post.date}</span>`;
                if(post.date === todayStr) {
                    dateBadge = `<span class="text-[10px] font-bold text-white bg-blue-500 px-1.5 py-0.5 rounded shadow-sm">TODAY</span>`;
                } else if (post.date === tomorrowStr) {
                    dateBadge = `<span class="text-[10px] font-bold text-white bg-emerald-500 px-1.5 py-0.5 rounded shadow-sm">TOMORROW</span>`;
                }

                card.innerHTML = `
                    <div class="flex justify-between items-start mb-2">
                        ${dateBadge}
                        <i class="${icon} text-slate-400"></i>
                    </div>
                    <div class="font-bold text-sm text-slate-800 leading-tight mb-1 truncate" title="${this.escapeHTML(post.product_name)}">${this.escapeHTML(post.product_name)}</div>
                    ${post.caption ? `<div class="text-[9px] text-slate-400 mb-1 line-clamp-1 italic">"${this.escapeHTML(post.caption)}"</div>` : ''}
                    <div class="text-[10px] text-slate-500 capitalize flex items-center gap-1">
                        <i class="fas fa-arrow-right text-[8px]"></i> ${this.escapeHTML(post.post_type)}
                    </div>
                    
                    <button class="absolute top-2 right-8 text-red-400 opacity-0 group-hover:opacity-100 hover:text-red-600 transition p-1" onclick="App.deletePost('${post.id}')"><i class="fas fa-trash"></i></button>
                    ${post.post_time ? `<button onclick="App.editPostTime('${post.id}')" class="mt-2 text-[9px] font-bold text-slate-400 hover:text-blue-600 hover:bg-blue-50 transition-all uppercase tracking-wider bg-slate-50 p-1.5 rounded-lg inline-flex items-center gap-1.5"><i class="far fa-clock"></i> ${this.escapeHTML(post.post_time)}</button>` : `<button onclick="App.editPostTime('${post.id}')" class="mt-2 text-[9px] font-bold text-slate-300 hover:text-blue-600 hover:bg-blue-50 transition-all uppercase tracking-wider p-1.5 rounded-lg inline-flex items-center gap-1.5"><i class="fas fa-plus"></i> Time</button>`}
                `;
                
                card.ondragstart = (e) => {
                    e.dataTransfer.setData('text', post.id);
                    e.dataTransfer.setData('old_status', status);
                    card.classList.add('opacity-50');
                    this.hidePostHoverCard();
                };
                card.ondragend = () => card.classList.remove('opacity-50');
                col.appendChild(card);
            }
        });
 
        // --- Kanban Empty States ---
        dropZones.forEach(zone => {
            if (zone.innerHTML === '') {
                zone.innerHTML = `
                    <div class="empty-state py-8 border-2 border-dashed border-slate-100 rounded-2xl w-full">
                        <i class="fas fa-layer-group text-slate-200 mb-2"></i>
                        <div class="text-[10px] text-slate-300 uppercase tracking-widest font-bold">Nothing here</div>
                    </div>
                `;
            }
        });

        // Update Counts
        Object.keys(counts).forEach(k => {
            const el = document.getElementById('count-'+k);
            if(el) el.textContent = counts[k];
        });
    },

    allowDrop: function(e) { e.preventDefault(); },
    
    drop: async function(e) {
        e.preventDefault();
        const postId = e.dataTransfer.getData('text');
        const oldStatus = e.dataTransfer.getData('old_status');
        const col = e.target.closest('.kanban-drop-zone');
        if(!col) return;
        
        const newStatus = col.dataset.status;
        const post = this.data.posts.find(p => p.id === postId);
        
        if(post && post.status !== newStatus) {
            let finalDate = post.date;
            let finalTime = post.post_time || '';

            if ((newStatus === 'approved' || newStatus === 'posted') && (oldStatus === 'draft' || oldStatus === 'ongoing')) {
                if (!post.date) {
                    const base = new Date(this.state.currentDate.getFullYear(), this.state.currentDate.getMonth(), this.state.currentDate.getDate());
                    const d = String(base.getDate()).padStart(2, '0');
                    const m = String(base.getMonth() + 1).padStart(2, '0');
                    const y = base.getFullYear();
                    const suggestedDate = `${d}-${m}-${y}`;
                    const message = `Select a time for ${suggestedDate}`;
                    const userTime = await this.showScheduleModal(message, "10:00 AM");
                    if (userTime === null) {
                        this.renderKanban();
                        return;
                    }
                    finalDate = suggestedDate;
                    finalTime = userTime;
                } else if (!post.post_time) {
                    const message = `Select a time for ${post.date}`;
                    const userTime = await this.showScheduleModal(message, "10:00 AM");
                    if (userTime === null) {
                        this.renderKanban();
                        return;
                    }
                    finalDate = post.date;
                    finalTime = userTime;
                }
            }

            if (newStatus === 'posted') {
                const dateStr = finalDate || post.date || '';
                const parts = dateStr.split('-').map(Number);
                if (parts.length === 3) {
                    const d = parts[0];
                    const m = parts[1];
                    const y = parts[2];
                    const scheduled = new Date(y, m - 1, d);
                    if (!Number.isNaN(scheduled.getTime())) {
                        const now = new Date();
                        const todayOnly = new Date(now.getFullYear(), now.getMonth(), now.getDate());
                        const scheduledOnly = new Date(scheduled.getFullYear(), scheduled.getMonth(), scheduled.getDate());
                        if (scheduledOnly.getTime() > todayOnly.getTime()) {
                            this.showToast('Cannot move to Posted Live: date is in the future. Adjust date first.', 'warning');
                            this.renderKanban();
                            return;
                        }
                        if (scheduledOnly.getTime() < todayOnly.getTime()) {
                            const reason = await this.showLateReasonModal(post.late_reason || '');
                            if (reason !== null) {
                                post.late_reason = reason;
                            }
                        }
                    }
                }
            }

            post.status = newStatus;
            post.date = finalDate;
            post.post_time = finalTime;
            this.renderKanban(); // Optimistic update
            
            try {
                // Update via save_post to avoid race conditions (single atomic write)
                await fetch('?action=save_post', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        id: postId,
                        status: newStatus,
                        date: finalDate,
                        post_time: finalTime,
                        platform: post.platform || 'instagram',
                        late_reason: post.late_reason || null
                    })
                });

                await this.loadData(); // Final sync
                this.renderKanban();
                this.renderCalendar();
                this.renderDashboard();
            } catch(err) {
                this.showToast('Update failed', 'error');
                await this.loadData();
                this.renderKanban();
            }
        }
    },

    handleCalendarDrop: async function(e, newDate) {
        e.preventDefault();
        const postId = e.dataTransfer.getData('text');
        const post = this.data.posts.find(p => p.id === postId);
        
        if (post && post.date !== newDate) {
            const oldDate = post.date;
            post.date = newDate;
            this.renderCalendar(); 
            this.renderKanban();  
            this.renderDashboard();
            
            try {
                const res = await fetch('?action=update_post_date', {
                    method: 'POST',
                    body: JSON.stringify({ id: postId, date: newDate })
                });
                const result = await res.json();
                if (!result.success) {
                    this.showToast(result.message, 'error');
                    post.date = oldDate;
                    this.renderCalendar();
                    this.renderKanban();
                    this.renderDashboard();
                }
            } catch(err) {
                this.showToast('Reschedule failed', 'error');
                post.date = oldDate;
                this.renderCalendar();
                this.renderKanban();
            }
        }
    },

    applyTaskStatusUpdate: async function(taskId, newStatus, context) {
        const tasks = Array.isArray(this.data.tasks) ? this.data.tasks : [];
        const task = tasks.find(t => t && t.id === taskId);
        if (!task || !newStatus) return;
        const previousStatus = task.status || 'draft';
        task.status = newStatus;
        if (context === 'day') {
            this.viewDayDetail(this.state.currentDetailDate);
        } else if (context === 'tasks') {
            this.renderTasksView();
        }
        try {
            const res = await fetch('?action=update_task_status', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: taskId, status: newStatus })
            });
            const json = await res.json();
            if (!json.success) {
                task.status = previousStatus;
                if (context === 'day') this.viewDayDetail(this.state.currentDetailDate);
                if (context === 'tasks') this.renderTasksView();
                if (json.message) this.showToast(json.message, 'error');
                return;
            }
            if (this.aiAgentState && typeof this.getVirtualNow === 'function' && typeof this.computeAiAgentPredictions === 'function' && typeof this.updateAiAgentPredictions === 'function') {
                const now = this.getVirtualNow();
                const preds = this.computeAiAgentPredictions(now);
                this.updateAiAgentPredictions(preds, now);
            }
        } catch (err) {
            task.status = previousStatus;
            if (context === 'day') this.viewDayDetail(this.state.currentDetailDate);
            if (context === 'tasks') this.renderTasksView();
            this.showToast('Task update failed', 'error');
        }
    },
    
    handleTaskDrop: async function(e, newStatus) {
        e.preventDefault();
        const taskId = e.dataTransfer.getData('task_id');
        const oldStatus = e.dataTransfer.getData('old_status') || 'draft';
        if (!taskId || !newStatus || oldStatus === newStatus) return;
        await this.applyTaskStatusUpdate(taskId, newStatus, 'day');
    },

    getTaskEffectiveStatus: function(task) {
        const raw = (task && task.status) ? String(task.status).toLowerCase() : 'draft';
        if (raw === 'draft' || raw === 'pending') return 'draft';
        if (raw === 'ongoing' || raw === 'in_progress') return 'ongoing';
        if (raw === 'approved' || raw === 'completed') return 'approved';
        if (raw === 'posted' || raw === 'published' || raw === 'live') return 'posted';
        if (raw === 'lost' || raw === 'cancelled' || raw === 'canceled') return 'lost';
        return 'draft';
    },

    isTaskOnDate: function(task, dateStr) {
        if (!task || !dateStr) return false;
        const parseDMY = (s) => {
            const parts = String(s || '').split('-').map(Number);
            if (parts.length !== 3) return null;
            const d = parts[0];
            const m = parts[1];
            const y = parts[2];
            if (!d || !m || !y) return null;
            const dt = new Date(y, m - 1, d);
            if (Number.isNaN(dt.getTime())) return null;
            return dt;
        };
        const target = parseDMY(dateStr);
        const start = parseDMY(task.start_date || task.date);
        const end = parseDMY(task.end_date || task.date);
        if (!target || !start || !end) return false;
        const tTime = target.getTime();
        return tTime >= start.getTime() && tTime <= end.getTime();
    },

