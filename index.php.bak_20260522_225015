    renderAdminApiKeys: function() {
        // Dynamic URL update
        const urlEl = document.getElementById('apiEndpointUrl');
        if(urlEl) urlEl.textContent = `${window.location.protocol}//${window.location.host}${window.location.pathname}?action=api_get_all`;

        const list = document.getElementById('adminApiKeyList');
        if (!list) return;
        list.innerHTML = '';
        
        const keys = this.data.api_keys || [];
        if (keys.length === 0) {
            list.innerHTML = `
                <div class="empty-state py-12 border-2 border-dashed border-slate-100 rounded-3xl">
                    <i class="fas fa-key text-slate-100 text-4xl mb-4"></i>
                    <div class="text-slate-400 font-bold uppercase tracking-widest text-xs">No active API keys</div>
                </div>
            `;
            return;
        }

        keys.forEach(k => {
            const card = document.createElement('div');
            card.className = `p-6 rounded-2xl border transition-all ${k.status === 'revoked' ? 'bg-slate-50 opacity-60 border-slate-200' : 'bg-white border-slate-100 shadow-sm hover:shadow-md'}`;
            
            // Plan Color Mapping
            const planColors = {
                'free': 'bg-slate-100 text-slate-600',
                'basic': 'bg-blue-100 text-blue-600',
                'b2c': 'bg-emerald-100 text-emerald-600',
                'b2b': 'bg-purple-100 text-purple-600'
            };
            const planBadge = `<span class="px-2 py-0.5 rounded-full text-[8px] font-black uppercase tracking-tighter ${planColors[k.plan || 'free']} shadow-sm border border-white/20">${k.plan || 'free'}</span>`;

            card.innerHTML = `
                <div class="flex justify-between items-start">
                    <div class="flex-1">
                        <div class="flex items-center gap-2 mb-2">
                            <span class="font-bold text-slate-800">${k.label}</span>
                            ${planBadge}
                            <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase ${k.status === 'active' ? 'bg-emerald-100 text-emerald-700' : 'bg-rose-100 text-rose-700'}">
                                ${k.status}
                            </span>
                        </div>
                        <div class="flex gap-2 items-center mb-4">
                            <code class="bg-slate-100 px-3 py-2 rounded-lg text-slate-600 font-mono text-xs flex-1 truncate">${k.key}</code>
                            ${k.status === 'active' ? `
                                <button onclick="App.copyToClipboard('${k.key}')" class="p-2 text-slate-400 hover:text-blue-600 transition-colors">
                                    <i class="fas fa-copy"></i>
                                </button>
                            ` : ''}
                        </div>
                        <div class="flex items-center gap-6 text-[10px] font-bold text-slate-400 uppercase tracking-widest">
                            <span>CREATED: ${new Date(k.created_at).toLocaleDateString()}</span>
                            <span>LAST USED: ${k.last_used ? new Date(k.last_used).toLocaleDateString() : 'NEVER'}</span>
                        </div>
                    </div>
                    ${k.status === 'active' ? `
                        <button onclick="App.revokeApiKey('${k.id}')" class="ml-4 p-2 text-rose-400 hover:text-rose-600 hover:bg-rose-50 rounded-lg transition-all" title="Revoke Key">
                            <i class="fas fa-ban"></i>
                        </button>
                    ` : ''}
                </div>
            `;
            list.appendChild(card);
        });
    },

    generateApiKey: function() {
        document.getElementById('api_key_label').value = '';
        document.getElementById('apiKeyModal').classList.remove('hidden');
        document.getElementById('api_key_label').focus();
    },

    confirmApiKeyGeneration: async function() {
        const label = document.getElementById('api_key_label').value.trim();
        if (!label) return this.showToast('Please enter a name for the key', 'error');
        
        const plan = document.querySelector('input[name="api_plan"]:checked').value;
        const role = document.getElementById('api_key_role').value;

        try {
            const res = await fetch('?action=api_generate_key', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ label, plan, role })
            });
            const result = await res.json();
            if (result.success) {
                document.getElementById('apiKeyModal').classList.add('hidden');
                this.showToast('API Key generated successfully', 'success');
                await this.loadData();
                this.renderAdminApiKeys();
            } else {
                this.showToast(result.message, 'error');
            }
        } catch(e) {
            this.showToast('Error generating API Key', 'error');
        }
    },

    revokeApiKey: async function(id) {
        if (!confirm('Are you sure you want to revoke this API Key? This action cannot be undone and will break any apps using it.')) return;

        try {
            const res = await fetch('?action=api_revoke_key', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id })
            });
            const result = await res.json();
            if (result.success) {
                this.showToast('API Key revoked', 'info');
                await this.loadData();
                this.renderAdminApiKeys();
            } else {
                this.showToast(result.message, 'error');
            }
        } catch(e) {
            this.showToast('Error revoking API Key', 'error');
        }
    },

    copyToClipboard: function(text) {
