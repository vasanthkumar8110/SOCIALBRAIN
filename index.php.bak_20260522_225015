    },
    
    plannerUseAIContent: function(text) {
        const captionBox = document.getElementById('plannerCaptionInput');
        if(captionBox) {
            captionBox.value = text;
            this.plannerUpdateCaption(text); // Update state and char count
            this.showToast("Content applied!", "success");
            this.plannerToggleAI(); // Close AI panel
        }
    },
    
    plannerSave: async function() {
        const fixTargets = this.plannerState.grid.filter(item => item && item.schedule && item.image && !item.product_id);
        if (fixTargets.length > 0) {
            this.plannerState.grid = this.plannerState.grid.map(item => {
                if (item && item.schedule && item.image && !item.product_id) {
                    const clone = Object.assign({}, item);
                    clone.schedule = '';
                    return clone;
                }
                return item;
            });
            this.renderPlannerGrid();
            this.showToast(`Scheduled slots without product were unscheduled (${fixTargets.length}). Select a product and re-schedule.`, 'warning');
        }

        // Clear validation errors on success path
        this.plannerState.showValidationErrors = false;
        this.renderPlannerGrid();
        
        // Grab mood data
        const vibe = document.getElementById('plannerVibeInput')?.value || '';
        const notes = document.getElementById('plannerNotesInput')?.value || '';
        this.plannerState.mood.vibe = vibe;
        this.plannerState.mood.notes = notes;

        // Ensure IDs for all items (for sync)
        this.plannerState.grid.forEach(item => {
            if (item && !item.id) {
                item.id = 'plan_' + Date.now().toString(36) + Math.random().toString(36).substr(2, 5);
            }
        });

        try {
            const res = await fetch('?action=planner_save', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    grid: this.plannerState.grid,
                    mood: this.plannerState.mood
                })
            });
            const json = await res.json();
            if (json.success) {
                this.showToast(json.message || 'Planner saved!', 'success');
                // Reload data to ensure calendar sync is reflected
                await this.loadData();
            } else {
                this.showToast('Failed to save', 'error');
            }
        } catch (e) {
            this.showToast('Network error saving planner', 'error');
        }
    },

    plannerUpdateColor: function(index, color) {
        if (!this.plannerState.mood.palette) this.plannerState.mood.palette = [];
        this.plannerState.mood.palette[index] = color;
    },

    renderPlannerMood: function() {
        const vibeInput = document.getElementById('plannerVibeInput');
        const notesInput = document.getElementById('plannerNotesInput');
        if(vibeInput) vibeInput.value = this.plannerState.mood.vibe || 'Professional';
        if(notesInput) notesInput.value = this.plannerState.mood.notes || '';
        
        // Render Palette
        const paletteContainer = document.getElementById('plannerColorSwatches');
        if (paletteContainer) {
            const palette = this.plannerState.mood.palette || [];
            // Ensure at least 5 slots
            for(let i=0; i<5; i++) {
                if(!palette[i]) palette[i] = '#e2e8f0'; // Default slate-200
            }
            
            paletteContainer.innerHTML = palette.slice(0, 5).map((color, idx) => `
                <div class="relative group">
                    <input type="color" class="w-8 h-8 rounded-full cursor-pointer border-none p-0 bg-transparent overflow-hidden transition-transform hover:scale-110" 
                           value="${color}" 
                           onchange="App.plannerUpdateColor(${idx}, this.value)">
                    <div class="absolute -bottom-6 left-1/2 -translate-x-1/2 bg-black text-white text-[9px] px-1 rounded opacity-0 group-hover:opacity-100 pointer-events-none whitespace-nowrap z-10">
                        ${color}
                    </div>
                </div>
            `).join('');
            
            this.plannerState.mood.palette = palette; // sync back defaults
        }
    },

    // --- Asset Library & Types ---
    
    plannerSetType: function(type) {
        const idx = this.plannerState.selectedSlot;
        if (idx !== null) {
            if (!this.plannerState.grid[idx]) this.plannerState.grid[idx] = {};
            this.plannerState.grid[idx].type = type;
            this.renderPlannerGrid();
            this.updatePlannerTypeUI(type);
            this.updateUploadAccepts(type);
        }
    },

    updatePlannerTypeUI: function(type) {
        ['image', 'carousel', 'reel'].forEach(t => {
            const btn = document.getElementById(`plannerType${t.charAt(0).toUpperCase() + t.slice(1)}`);
            if (btn) {
                if (t === type) {
                    btn.classList.add('bg-white', 'shadow-sm', 'text-pink-600');
                    btn.classList.remove('text-slate-500', 'hover:bg-white/50');
                } else {
                    btn.classList.remove('bg-white', 'shadow-sm', 'text-pink-600');
                    btn.classList.add('text-slate-500', 'hover:bg-white/50');
                }
            }
        });
    },
    
    updateUploadAccepts: function(type) {
        const editorInput = document.querySelector('#plannerEditor input[type=file]');
        const mobileInput = document.getElementById('plannerMobileFileInput');
        const setAttrs = (el) => {
            if (!el) return;
            if (type === 'reel') {
                el.setAttribute('accept', 'video/*');
                el.removeAttribute('multiple');
            } else if (type === 'carousel') {
                el.setAttribute('accept', 'image/*');
                el.setAttribute('multiple', '');
            } else {
                el.setAttribute('accept', 'image/*');
                el.removeAttribute('multiple');
            }
        };
        setAttrs(editorInput);
        setAttrs(mobileInput);
    },

    openAssetLibrary: async function() {
        const modal = document.getElementById('assetLibraryModal');
        if (modal) {
             modal.classList.remove('hidden');
             // Load images if not already loaded or stale
             await this.loadAssetLibraryImages();
        }
    },

    closeAssetLibrary: function() {
        const modal = document.getElementById('assetLibraryModal');
        if (modal) modal.classList.add('hidden');
    },

    loadAssetLibraryImages: async function() {
        const container = document.getElementById('assetLibraryGrid');
        if (!container) return;
        
        container.innerHTML = '<div class="col-span-full text-center text-slate-400 py-8"><i class="fas fa-spinner fa-spin text-2xl"></i><br>Loading assets...</div>';
        
        try {
            const images = await this.fetchRD('research_list_images', {}, { bypassCache: true });
            if (!images || images.length === 0) {
                container.innerHTML = '<div class="col-span-full text-center text-slate-400 py-8">No assets found. Upload some first!</div>';
                return;
            }
            
            container.innerHTML = images.map(img => {
                const isVideo = img.type === 'video' || (img.url && img.url.match(/\.(mp4|webm|mov)$/i));
                const content = isVideo 
                    ? `<video src="${img.url}" class="w-full h-full object-cover" muted></video><div class="absolute top-1 right-1 bg-black/50 text-white p-1 rounded-full text-xs"><i class="fas fa-video"></i></div>` 
                    : `<img loading="lazy" decoding="async" src="${img.url}" class="w-full h-full object-cover">`;
                    
                return `
                <div class="group relative aspect-square bg-slate-100 rounded-lg overflow-hidden border border-slate-200 cursor-pointer hover:border-pink-500 transition-colors"
                     onclick="App.selectAsset('${img.url}')">
                    ${content}
                    <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 flex items-center justify-center text-white font-bold text-xs">
                        Select
                    </div>
                </div>
            `;
            }).join('');
        } catch (e) {
            container.innerHTML = '<div class="col-span-full text-center text-red-400 py-8">Failed to load assets.</div>';
        }
    },

    selectAsset: function(url) {
        const idx = this.plannerState.selectedSlot;
        if (idx !== null) {
            if (!this.plannerState.grid[idx]) this.plannerState.grid[idx] = {};
            const isVideo = url.match(/\.(mp4|webm|mov)$/i);
            const type = this.plannerState.grid[idx].type || (isVideo ? 'reel' : 'image');
            if (type === 'reel' && !isVideo) {
                this.showToast('Reel requires a video asset.', 'error');
                return;
            }
            if ((type === 'image' || type === 'carousel') && isVideo) {
                this.showToast('Selected video is not allowed for this post type.', 'error');
                return;
            }
            if (type === 'carousel') {
                if (!Array.isArray(this.plannerState.grid[idx].images)) this.plannerState.grid[idx].images = [];
                this.plannerState.grid[idx].images.push(url);
                this.plannerState.grid[idx].image = this.plannerState.grid[idx].images[0];
                this.plannerState.grid[idx].type = 'carousel';
                this.renderPlannerGrid();
                this.plannerSelectSlot(idx);
                this.plannerSave();
                this.showToast('Added image to carousel', 'success');
                this.closeAssetLibrary();
                return;
            }
            this.plannerState.grid[idx].image = url;
            if (isVideo) this.plannerState.grid[idx].type = 'reel';
            this.renderPlannerGrid();
            this.plannerSelectSlot(idx);
            this.plannerSave();
        }
        this.closeAssetLibrary();
    },

    // --- End Planner Logic ---

};

