    useAIContent: function(text) {
        const captionBox = document.getElementById('postCaption');
        if(captionBox) {
            captionBox.value = text;
            this.showToast("Content applied to caption!", "success");
        } else {
            navigator.clipboard.writeText(text).then(() => {
                this.showToast("Copied to clipboard!", "success");
            });
        }
    },

