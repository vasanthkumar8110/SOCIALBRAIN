    closeWizard: function() {
        this.state.wizard = {};
        this.saveState();
        document.getElementById('wizardModal').classList.add('hidden');
    },

    renderWizardStep: function() {
        const s = this.state.wizard.step;
        
        // Hide all steps
        document.querySelectorAll('.wizard-step').forEach(el => el.classList.add('hidden'));
        const stepEl = document.getElementById(`step-${s}`);
        if(stepEl) stepEl.classList.remove('hidden');
        
        // Update Stepper UI
        for(let i=1; i<=6; i++) {
            const node = document.getElementById(`node-${i}`);
            const line = document.getElementById(`line-${i-1}`);
            
            if(node) {
                if(i <= s) {
                    node.classList.add('active', 'border-blue-500', 'text-blue-600');
                    node.classList.remove('border-slate-200', 'text-slate-300');
                    if(line) line.classList.add('active');
                } else {
                    node.classList.remove('active', 'border-blue-500', 'text-blue-600');
                    node.classList.add('border-slate-200', 'text-slate-300');
                    if(line) line.classList.remove('active');
                }
            }
        }

        // Buttons
        document.getElementById('btnBack').classList.toggle('hidden', s === 1);
        document.getElementById('btnNext').classList.remove('hidden');
        document.getElementById('btnFinish').classList.add('hidden');

        // Render Specific Step Content
        if(s === 1) this.renderPlatformGrid();
        if(s === 2) this.renderTypeGrid();
        if(s === 3) this.renderWizSectorGrid();
        if(s === 4) this.renderWizCategoryGrid();
        if(s === 5) this.renderWizSubCategoryGrid();
        if(s === 6) {
            this.renderProductGrid();
            document.getElementById('btnNext').classList.add('hidden');
            document.getElementById('btnFinish').classList.remove('hidden');
        }
    },

