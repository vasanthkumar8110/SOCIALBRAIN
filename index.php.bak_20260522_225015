                            <div class="text-slate-500">Last 24h</div>
                        </div>
                    </div>
                </div>
            `;
            
            const userMap = {};
            (this.data && Array.isArray(this.data.users) ? this.data.users : []).forEach(u => {
                if (u && u.id) {
                    userMap[u.id] = u.username || u.name || u.email || u.id;
                }
            });

            container.innerHTML = intelligenceHeader + logs.map(l => {
                const date = new Date(l.timestamp);
                const timeStr = date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                const dateStr = date.toLocaleDateString([], { month: 'short', day: 'numeric' });
                
                const actionColors = {
                    'post_created': 'bg-green-100 text-green-700',
                    'post_updated': 'bg-blue-100 text-blue-700',
                    'post_soft_deleted': 'bg-red-100 text-red-700',
                    'post_restored': 'bg-emerald-100 text-emerald-700',
                    'post_rescheduled': 'bg-amber-100 text-amber-700',
                    'product_added': 'bg-blue-100 text-blue-700',
                    'product_updated': 'bg-blue-100 text-blue-700',
                    'product_deleted': 'bg-red-100 text-red-700',
                    'sector_saved': 'bg-indigo-100 text-indigo-700',
                    'sector_deleted': 'bg-red-100 text-red-700',
                    'category_saved': 'bg-indigo-100 text-indigo-700',
                    'category_deleted': 'bg-red-100 text-red-700',
                    'sub_category_saved': 'bg-indigo-100 text-indigo-700',
                    'sub_category_deleted': 'bg-red-100 text-red-700',
                    'create_task': 'bg-green-100 text-green-700',
                    'update_task': 'bg-blue-100 text-blue-700',
                    'update_task_status': 'bg-amber-100 text-amber-700',
                    'delete_task': 'bg-red-100 text-red-700',
                    'login': 'bg-green-100 text-green-700',
                    'api_key_created': 'bg-purple-100 text-purple-700',
                    'all_products_deleted': 'bg-red-100 text-red-700',
                    'all_sectors_deleted': 'bg-red-100 text-red-700',
                    'all_holidays_deleted': 'bg-red-100 text-red-700',
                    'all_logs_deleted': 'bg-red-100 text-red-700',
                    'all_api_keys_deleted': 'bg-red-100 text-red-700',
                    'export_products': 'bg-orange-100 text-orange-700',
                    'bulk_upload_products': 'bg-cyan-100 text-cyan-700',
                    'holiday_saved': 'bg-pink-100 text-pink-700',
                    'holiday_deleted': 'bg-red-100 text-red-700',
                    'holidays_seeded': 'bg-pink-100 text-pink-700'
                };
                const colorClass = actionColors[l.action] || 'bg-slate-100 text-slate-600';
                const actionLabel = l.action.replace(/_/g, ' ').toUpperCase();
                const rawUserId = l.user_id || '';
                const displayName = userMap[rawUserId] || rawUserId || 'Unknown User';
                const avatarLetter = displayName.charAt(0).toUpperCase();

                let humanDetails = '';
                if (l.action === 'post_created' || l.action === 'post_updated') {
                    const pid = l.details && l.details.post_id ? l.details.post_id : '';
                    const prod = l.details && l.details.product ? l.details.product : '';
                    humanDetails = `Post ${pid}${prod ? ' for ' + prod : ''}`;
                } else if (l.action === 'post_soft_deleted' || l.action === 'post_restored' || l.action === 'post_rescheduled' || l.action === 'status_updated') {
                    const pid = l.details && (l.details.post_id || l.details.id) ? (l.details.post_id || l.details.id) : '';
