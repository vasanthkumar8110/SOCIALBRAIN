    renderCalendar: function() {
        const year = this.state.currentDate.getFullYear();
        const month = this.state.currentDate.getMonth();
        const monthNames = this.monthNames;
        
        document.getElementById('calTitle').textContent = `${monthNames[month]} ${year}`;
        
        const weekHeader = document.getElementById('calendarWeekHeader');
        if (weekHeader) {
            if ((this.state.calendarLayout || 'grid') === 'grid') weekHeader.classList.remove('hidden');
            else weekHeader.classList.add('hidden');
        }

        const layoutBtn = document.getElementById('btnCalLayout');
        if (layoutBtn) {
            const layout = this.state.calendarLayout || 'grid';
            layoutBtn.classList.toggle('text-blue-600', layout === 'grid');
            layoutBtn.classList.toggle('text-indigo-600', layout !== 'grid');
        }
        const compactBtn = document.getElementById('btnCalCompact');
        if (compactBtn) {
            compactBtn.classList.toggle('text-blue-600', !!this.state.calendarCompact);
        }

        const grid = document.getElementById('calendarGrid');
        grid.innerHTML = '';
        grid.className = 'flex-1 overflow-y-auto';
        grid.style.display = 'block';

        const root = document.createElement('div');
        root.className = 'timeline-calendar custom-scrollbar';
        grid.appendChild(root);

        if ((this.state.calendarLayout || 'grid') === 'grid') {
            this.renderModernGridMonth(root, year, month);
        } else {
            this.renderTimelineMonth(root, year, month);
        }
        this.checkProximityAlerts();
    },

    toggleCalendarLayout: function() {
        const current = this.state.calendarLayout || 'grid';
        this.state.calendarLayout = current === 'grid' ? 'timeline' : 'grid';
        this.saveState();
        this.renderCalendar();
    },

    toggleCalendarCompact: function() {
        this.state.calendarCompact = !this.state.calendarCompact;
        this.saveState();
        this.renderCalendar();
    },

    renderTimelineMonth: function(root, year, month) {
        const layout = document.createElement('div');
        layout.className = 'timeline-layout';

        const allPosts = (this.data.posts || []).filter(p => !p.deleted_at);
        const allTasks = Array.isArray(this.data.tasks) ? this.data.tasks : [];

        const backlogPanel = document.createElement('div');
        backlogPanel.className = 'timeline-panel timeline-backlog';
        const backlogBody = document.createElement('div');
        backlogBody.className = 'timeline-panel-body';

        const daysPanel = document.createElement('div');
        daysPanel.className = 'timeline-days';

        const daysInMonth = new Date(year, month + 1, 0).getDate();
        const today = new Date();
        const todayKey = `${String(today.getDate()).padStart(2, '0')}-${String(today.getMonth() + 1).padStart(2, '0')}-${today.getFullYear()}`;

        const inMonth = (dateStr) => {
            if (!dateStr) return false;
            const parts = dateStr.split('-').map(Number);
            if (parts.length !== 3) return false;
            return parts[1] === (month + 1) && parts[2] === year;
        };

        const backlogPosts = allPosts
            .filter(p => (p.status || 'draft') !== 'posted')
            .filter(p => !p.date || !inMonth(p.date))
            .sort((a, b) => (a.date || '').localeCompare(b.date || ''));

        const backlogHeader = document.createElement('div');
        backlogHeader.className = 'timeline-panel-header';
        backlogHeader.innerHTML = `
            <div>
                <div class="timeline-panel-title">Backlog</div>
                <div class="timeline-panel-sub">${backlogPosts.length} unscheduled</div>
            </div>
            <button class="timeline-btn editor-only" onclick="App.openWizard()"><i class="fas fa-plus"></i> New</button>
        `;
        backlogPanel.appendChild(backlogHeader);
        backlogPanel.appendChild(backlogBody);

        if (backlogPosts.length === 0) {
            const empty = document.createElement('div');
            empty.className = 'timeline-empty';
            empty.textContent = 'No backlog posts';
            backlogBody.appendChild(empty);
        } else {
            backlogPosts.forEach(p => backlogBody.appendChild(this.createTimelinePostCard(p)));
        }

        for (let d = 1; d <= daysInMonth; d++) {
            const dateStr = `${String(d).padStart(2, '0')}-${String(month + 1).padStart(2, '0')}-${year}`;
            const dt = new Date(year, month, d);
            const weekday = dt.toLocaleDateString('en-US', { weekday: 'short' });
            const isToday = dateStr === todayKey;

            const dayPosts = allPosts
                .filter(p => p.date === dateStr)
                .sort((a, b) => (a.post_time || '').localeCompare(b.post_time || ''));

            const dayTasks = allTasks.filter(t => this.isTaskOnDate(t, dateStr));

            const holiday = holidays.find(h => h.date === dateStr);

            const day = document.createElement('div');
            day.className = `timeline-day ${isToday ? 'today' : ''}`;

            const marker = document.createElement('div');
            marker.className = 'timeline-marker';
            day.appendChild(marker);

            const header = document.createElement('div');
            header.className = 'timeline-day-header';
            const dateWrap = document.createElement('div');
            dateWrap.className = 'timeline-date';

            const dateTop = document.createElement('div');
            dateTop.className = 'timeline-date-top';

            const num = document.createElement('div');
            num.className = 'timeline-date-num';
            num.textContent = String(d);

            const wd = document.createElement('div');
            wd.className = 'timeline-date-weekday';
            wd.textContent = weekday;

            dateTop.appendChild(num);
            dateTop.appendChild(wd);

            const badges = document.createElement('div');
            badges.className = 'timeline-badges';

            if (holiday) {
                const holidayEl = document.createElement('span');
                holidayEl.className = `timeline-pill ${holiday.priority ? 'urgent' : ''}`;
                holidayEl.textContent = holiday.what_day || 'Main Day';
                badges.appendChild(holidayEl);
            }

            const countEl = document.createElement('span');
            countEl.className = 'timeline-pill count';
            countEl.textContent = `${dayPosts.length} posts`;
            badges.appendChild(countEl);

            if (dayTasks.length > 0) {
                const taskCountEl = document.createElement('span');
                taskCountEl.className = 'timeline-pill';
                taskCountEl.textContent = `${dayTasks.length} tasks`;
                badges.appendChild(taskCountEl);
            }

            dateWrap.appendChild(dateTop);
            dateWrap.appendChild(badges);

            const actions = document.createElement('div');
            actions.className = 'timeline-actions';

            const addBtn = document.createElement('button');
            addBtn.className = 'timeline-btn editor-only';
            addBtn.innerHTML = '<i class="fas fa-plus"></i> Add';
            addBtn.onclick = () => this.openWizard(dateStr);
            actions.appendChild(addBtn);

            header.appendChild(dateWrap);
            header.appendChild(actions);
            day.appendChild(header);

            const drop = document.createElement('div');
            drop.className = 'timeline-dropzone';
            drop.dataset.date = dateStr;
            drop.ondragover = (e) => { e.preventDefault(); drop.classList.add('dragover'); };
            drop.ondragleave = () => drop.classList.remove('dragover');
            drop.ondrop = (e) => { drop.classList.remove('dragover'); this.handleCalendarDrop(e, dateStr); };

            if (dayPosts.length === 0) {
                const empty = document.createElement('div');
                empty.className = 'timeline-empty';
                empty.textContent = 'Drop a post here';
                drop.appendChild(empty);
            } else {
                dayPosts.forEach(p => drop.appendChild(this.createTimelinePostCard(p)));
            }

            day.appendChild(drop);
            daysPanel.appendChild(day);
        }

        layout.appendChild(backlogPanel);
        layout.appendChild(daysPanel);
        root.appendChild(layout);
    },

    createTimelinePostCard: function(post) {
        const card = document.createElement('div');
        card.className = 'timeline-post';
        card.draggable = true;
        card.tabIndex = 0;
        card.addEventListener('mouseenter', (ev) => this.showPostHoverCard(post, ev));
        card.addEventListener('mousemove', (ev) => this.positionPostHoverCard(ev));
        card.addEventListener('mouseleave', () => this.hidePostHoverCard());
        card.addEventListener('focus', () => {
            const r = card.getBoundingClientRect();
            this.showPostHoverCard(post, { clientX: r.right, clientY: r.top });
        });
        card.addEventListener('blur', () => this.hidePostHoverCard());
        card.ondragstart = (e) => {
            e.dataTransfer.setData('text', post.id);
            card.style.opacity = '0.6';
            this.hidePostHoverCard();
        };
        card.ondragend = () => { card.style.opacity = ''; };

        const platform = (this.data.platforms || []).find(pl => pl.id === post.platform);
        const iconClass = platform ? platform.icon : 'fas fa-file';

        const status = (post.status || 'draft').toLowerCase();

        const iconWrap = document.createElement('div');
        iconWrap.className = 'timeline-post-icon';
        const icon = document.createElement('i');
        icon.className = iconClass;
        iconWrap.appendChild(icon);

        const main = document.createElement('div');
        main.className = 'timeline-post-main';

        const title = document.createElement('div');
        title.className = 'timeline-post-title';
        title.textContent = post.product_name || 'Untitled';
        title.title = post.product_name || '';

        const meta = document.createElement('div');
        meta.className = 'timeline-post-meta';

        const sub = document.createElement('div');
        sub.className = 'timeline-post-sub';

        const timeSpan = document.createElement('span');
        const timeIcon = document.createElement('i');
        timeIcon.className = 'far fa-clock';
        timeSpan.appendChild(timeIcon);
        timeSpan.appendChild(document.createTextNode(` ${post.post_time || 'No time'}`));
        sub.appendChild(timeSpan);

        if (post.post_type) {
            const typeSpan = document.createElement('span');
            typeSpan.textContent = String(post.post_type).replace(/_/g, ' ');
            sub.appendChild(typeSpan);
        }

        const tools = document.createElement('div');
        tools.className = 'timeline-post-tools';

        const statusEl = document.createElement('span');
        statusEl.className = `timeline-post-status ${status}`;
        statusEl.textContent = status;

        const timeBtn = document.createElement('button');
        timeBtn.className = 'timeline-icon-btn';
        timeBtn.title = 'Edit time';
        timeBtn.innerHTML = '<i class="far fa-clock"></i>';
        timeBtn.onclick = () => this.editPostTime(post.id);

        tools.appendChild(statusEl);
        tools.appendChild(timeBtn);

        meta.appendChild(sub);
        meta.appendChild(tools);

        main.appendChild(title);
        main.appendChild(meta);

        card.appendChild(iconWrap);
        card.appendChild(main);

        return card;
    },

    renderModernGridMonth: function(root, year, month) {
        const compact = !!this.state.calendarCompact;
        const monthNames = this.monthNames;

        const shell = document.createElement('div');
        shell.className = `modern-calendar-shell${compact ? ' compact' : ''}`;

        const side = document.createElement('div');
        side.className = 'modern-side';

        const grid = document.createElement('div');
        grid.className = 'modern-calendar-grid';

        shell.appendChild(side);
        shell.appendChild(grid);
        root.appendChild(shell);

        const pad2 = (n) => String(n).padStart(2, '0');
        const toDateStr = (dt) => `${pad2(dt.getDate())}-${pad2(dt.getMonth() + 1)}-${dt.getFullYear()}`;
        const parseDateStr = (dateStr) => {
            const parts = String(dateStr || '').split('-').map(Number);
            if (parts.length !== 3) return null;
            const dt = new Date(parts[2], parts[1] - 1, parts[0]);
            if (Number.isNaN(dt.getTime())) return null;
            return dt;
        };

        const daysInMonth = new Date(year, month + 1, 0).getDate();
        const firstDay = new Date(year, month, 1).getDay();
        const totalCells = (() => {
            const raw = firstDay + daysInMonth;
            const pad = (7 - (raw % 7)) % 7;
            return raw + pad;
        })();

        const today = new Date();
        const todayKey = toDateStr(today);

        const allPosts = (this.data.posts || []).filter(p => !p.deleted_at);
        const allTasks = Array.isArray(this.data.tasks) ? this.data.tasks : [];
        const maxPerDay = compact ? 4 : 3;

        const holidays = this.data.holidays || [];
        const mainDays = holidays.filter(h => h.priority);

        const taskPriorityColor = (priority) => {
            switch (priority) {
                case 'P1': return '#ef4444';
                case 'P2': return '#f59e0b';
                case 'P3': return '#22c55e';
                case 'P4': return '#22c55e';
                default: return '#64748b';
            }
        };

        const platformColor = (platformId) => {
            const plat = (this.data.platforms || []).find(pl => pl.id === platformId);
            const key = String((plat?.name || platformId || '')).toLowerCase();
            if (key.includes('instagram')) return '#ec4899';
            if (key.includes('facebook')) return '#3b82f6';
            if (key.includes('whatsapp')) return '#22c55e';
            if (key.includes('tiktok')) return '#111827';
            if (key.includes('youtube')) return '#ef4444';
            if (key === 'x' || key.includes('twitter')) return '#111827';
            return '#64748b';
        };

        for (let i = 0; i < totalCells; i++) {
            const dayNum = (i - firstDay) + 1;
            const dt = new Date(year, month, dayNum);
            const dateStr = toDateStr(dt);
            const outside = dt.getMonth() !== month;
            const isToday = dateStr === todayKey;

            const dayPosts = allPosts
                .filter(p => p.date === dateStr)
                .sort((a, b) => (a.post_time || '').localeCompare(b.post_time || ''));

            const dayTasks = allTasks.filter(t => this.isTaskOnDate(t, dateStr));

            const holiday = (this.data.holidays || []).find(h => h.date === dateStr);

            const cell = document.createElement('div');
            cell.className = `modern-day-cell ${outside ? 'outside' : ''} ${isToday ? 'today' : ''}`;

            if (!outside && !holiday && mainDays.length > 0) {
                const dtMid = new Date(dt.getFullYear(), dt.getMonth(), dt.getDate());
                dtMid.setHours(0, 0, 0, 0);
                let bestDiff = null;
                mainDays.forEach(h => {
                    const parts = String(h.date || '').split('-').map(Number);
                    if (parts.length !== 3) return;
                    const hDt = new Date(parts[2], parts[1] - 1, parts[0]);
                    hDt.setHours(0, 0, 0, 0);
                    const diffDays = Math.round((hDt - dtMid) / (1000 * 60 * 60 * 24));
                    if (diffDays >= 1 && diffDays <= 7) {
                        if (bestDiff === null || diffDays < bestDiff) {
                            bestDiff = diffDays;
                        }
                    }
                });
                if (bestDiff !== null) {
                    cell.classList.add(`heatmap-${bestDiff}`);
                }
            }

            cell.onclick = () => this.viewDayDetail(dateStr);
            cell.ondragover = (e) => { e.preventDefault(); cell.classList.add('dragover'); };
            cell.ondragleave = () => cell.classList.remove('dragover');
            cell.ondrop = (e) => { cell.classList.remove('dragover'); this.handleCalendarDrop(e, dateStr); };

            const top = document.createElement('div');
            top.className = 'modern-day-top';

            const num = document.createElement('div');
            num.className = `modern-day-num ${(!outside && (holiday?.priority || isToday)) ? 'primary' : ''}`;
            num.textContent = String(dt.getDate());

            const actions = document.createElement('div');
            actions.className = 'modern-day-actions';

            const addPostBtn = document.createElement('button');
            addPostBtn.className = 'modern-day-btn editor-only';
            addPostBtn.title = 'Add post';
            addPostBtn.innerHTML = '<i class="fas fa-plus"></i>';
            addPostBtn.onclick = (ev) => { ev.stopPropagation(); this.openWizard(dateStr); };

            const addTaskBtn = document.createElement('button');
            addTaskBtn.className = 'modern-day-btn editor-only';
            addTaskBtn.title = 'Add task';
            addTaskBtn.innerHTML = '<i class="fas fa-check-circle"></i>';
            addTaskBtn.onclick = (ev) => {
                ev.stopPropagation();
                this.state.currentDetailDate = dateStr;
                this.createTaskForCurrentDay();
            };

            actions.appendChild(addPostBtn);
            actions.appendChild(addTaskBtn);
            top.appendChild(num);
            top.appendChild(actions);

            const badges = document.createElement('div');
            badges.className = 'modern-day-badges';

            if (holiday) {
                const h = document.createElement('span');
                h.className = `modern-badge ${holiday.priority ? 'urgent' : ''}`;
                h.textContent = holiday.what_day || 'Main Day';
                badges.appendChild(h);
            }

            const count = document.createElement('span');
            count.className = 'modern-badge count';
            count.textContent = `${dayPosts.length} posts`;
            badges.appendChild(count);

            if (dayTasks.length > 0) {
                const tCount = document.createElement('span');
                tCount.className = 'modern-badge';
                tCount.textContent = `${dayTasks.length} tasks`;
                badges.appendChild(tCount);
            }

            const chips = document.createElement('div');
            chips.className = 'modern-chips';

            dayPosts.slice(0, maxPerDay).forEach(p => {
                const chip = document.createElement('div');
                chip.className = `modern-chip ${compact ? 'compact' : ''}`;
                chip.draggable = true;
                chip.tabIndex = 0;
                chip.onclick = (ev) => { ev.stopPropagation(); this.viewDayDetail(dateStr); };
                chip.addEventListener('mouseenter', (ev) => this.showPostHoverCard(p, ev));
                chip.addEventListener('mousemove', (ev) => this.positionPostHoverCard(ev));
                chip.addEventListener('mouseleave', () => this.hidePostHoverCard());
                chip.addEventListener('focus', () => {
                    const r = chip.getBoundingClientRect();
                    this.showPostHoverCard(p, { clientX: r.right, clientY: r.top });
                });
                chip.addEventListener('blur', () => this.hidePostHoverCard());
                chip.ondragstart = (e) => {
                    e.dataTransfer.setData('text', p.id);
                    chip.style.opacity = '0.6';
                    this.hidePostHoverCard();
                };
                chip.ondragend = () => { chip.style.opacity = ''; };

                const dot = document.createElement('div');
                dot.className = 'modern-chip-dot';
                dot.style.background = platformColor(p.platform);

                const row = document.createElement('div');
                row.className = 'modern-chip-row';

                const title = document.createElement('div');
                title.className = 'modern-chip-title';
                title.textContent = p.product_name || 'Untitled';

                const sub = document.createElement('div');
                sub.className = 'modern-chip-sub';
                const timeIcon = document.createElement('i');
                timeIcon.className = 'far fa-clock';
                sub.appendChild(timeIcon);
                sub.appendChild(document.createTextNode(` ${p.post_time || 'No time'}`));

                row.appendChild(title);
                row.appendChild(sub);

                chip.appendChild(dot);
                chip.appendChild(row);
                chips.appendChild(chip);
            });

            if (dayTasks.length > 0) {
                const taskStrip = document.createElement('div');
                taskStrip.style.display = 'flex';
                taskStrip.style.flexWrap = 'wrap';
                taskStrip.style.gap = '2px';
                taskStrip.style.marginTop = '4px';
                taskStrip.style.maxWidth = '100%';
                const maxDots = 4;
                dayTasks.slice(0, maxDots).forEach(t => {
                    const d = document.createElement('div');
                    d.style.width = '6px';
                    d.style.height = '6px';
                    d.style.borderRadius = '999px';
                    d.style.background = taskPriorityColor(t.priority || 'P3');
                    d.title = t.title || '';
                    taskStrip.appendChild(d);
                });
                if (dayTasks.length > maxDots) {
                    const more = document.createElement('div');
                    more.style.fontSize = '9px';
                    more.style.color = '#6b7280';
                    more.textContent = '+' + (dayTasks.length - maxDots);
                    taskStrip.appendChild(more);
                }
                chips.appendChild(taskStrip);
            }

            cell.appendChild(top);
            cell.appendChild(badges);
            cell.appendChild(chips);
            grid.appendChild(cell);
        }

        const upcoming = allPosts
            .filter(p => p.date)
            .map(p => ({ post: p, dt: parseDateStr(p.date) }))
            .filter(x => x.dt && x.dt.getFullYear() === year && x.dt.getMonth() === month)
            .sort((a, b) => (a.dt.getTime() - b.dt.getTime()) || String(a.post.post_time || '').localeCompare(String(b.post.post_time || '')));
        
        const sideTitle = document.createElement('div');
        sideTitle.className = 'modern-side-title';
        sideTitle.innerHTML = `<span>Upcoming event</span><span class="text-xs text-slate-400">${monthNames[month]} ${year}</span>`;

        const sideSub = document.createElement('div');
        sideSub.className = 'modern-side-sub';
        sideSub.textContent = upcoming.length > 0 ? 'Next scheduled post in this month' : 'No scheduled posts this month';

        const upcomingEvent = upcoming[0];

        const sectionUpcoming = document.createElement('div');
        sectionUpcoming.className = 'modern-side-section';

        if (upcomingEvent) {
            const { post, dt } = upcomingEvent;
            const title = document.createElement('div');
            title.className = 'modern-side-event-title';
            title.textContent = post.product_name || 'Upcoming post';

            const meta = document.createElement('div');
            meta.className = 'modern-side-event-meta';
            const timeSpan = document.createElement('span');
            timeSpan.innerHTML = `<i class="far fa-clock mr-1"></i>${post.post_time || 'No time set'}`;
            const dateSpan = document.createElement('span');
            dateSpan.textContent = dt.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
            meta.appendChild(timeSpan);
            meta.appendChild(dateSpan);

            const pillRow = document.createElement('div');
            pillRow.className = 'modern-side-pill-row';

            const yesBtn = document.createElement('button');
            yesBtn.className = 'modern-side-pill primary';
            yesBtn.textContent = 'Yes';
            yesBtn.type = 'button';

            const maybeBtn = document.createElement('button');
            maybeBtn.className = 'modern-side-pill';
            maybeBtn.textContent = "Don't know yet";
            maybeBtn.type = 'button';

            const noBtn = document.createElement('button');
            noBtn.className = 'modern-side-pill';
            noBtn.textContent = 'No';
            noBtn.type = 'button';

            pillRow.appendChild(yesBtn);
            pillRow.appendChild(maybeBtn);
            pillRow.appendChild(noBtn);

            sectionUpcoming.appendChild(title);
            sectionUpcoming.appendChild(meta);
            sectionUpcoming.appendChild(pillRow);
        } else {
            const empty = document.createElement('div');
            empty.className = 'modern-side-event-meta';
            empty.textContent = 'No upcoming posts';
            sectionUpcoming.appendChild(empty);
        }

        const sectionMiniCal = document.createElement('div');
        sectionMiniCal.className = 'modern-side-section';

        const miniLabel = document.createElement('div');
        miniLabel.className = 'modern-side-sub';
        miniLabel.textContent = 'Monthly view';

        const mini = document.createElement('div');
        mini.className = 'modern-mini-calendar';

        const miniHeader = document.createElement('div');
        miniHeader.className = 'flex items-center justify-between text-xs text-slate-400';
        miniHeader.innerHTML = `<span>${monthNames[month]} ${year}</span><span class="uppercase tracking-[0.15em]">Sun - Sat</span>`;

        const miniGrid = document.createElement('div');
        miniGrid.className = 'modern-mini-calendar-grid';

        const miniPad2 = (n) => String(n).padStart(2, '0');
        const miniDaysInMonth = new Date(year, month + 1, 0).getDate();
        const miniFirstDay = new Date(year, month, 1).getDay();
        const miniTotalCells = (() => {
            const raw = miniFirstDay + miniDaysInMonth;
            const pad = (7 - (raw % 7)) % 7;
            return raw + pad;
        })();

        const monthKeys = new Set(
            upcoming.map(({ dt: d }) => `${miniPad2(d.getDate())}-${miniPad2(d.getMonth() + 1)}-${d.getFullYear()}`)
        );

        for (let i = 0; i < miniTotalCells; i++) {
            const dayNum = i - miniFirstDay + 1;
            const dtCell = new Date(year, month, dayNum);
            const cell = document.createElement('div');
            cell.className = 'modern-mini-calendar-day';

            if (dtCell.getMonth() === month && dayNum > 0 && dayNum <= miniDaysInMonth) {
                const key = `${miniPad2(dtCell.getDate())}-${miniPad2(dtCell.getMonth() + 1)}-${dtCell.getFullYear()}`;
                if (key === todayKey) cell.classList.add('is-today');
                if (monthKeys.has(key)) cell.classList.add('has-event');
                cell.textContent = dtCell.getDate();
                cell.onclick = () => this.viewDayDetail(key);
            } else {
                cell.textContent = '';
                cell.style.opacity = '0';
            }
            miniGrid.appendChild(cell);
        }

        mini.appendChild(miniHeader);
        mini.appendChild(miniGrid);

        sectionMiniCal.appendChild(miniLabel);
        sectionMiniCal.appendChild(mini);

        const sectionBreakdown = document.createElement('div');
        sectionBreakdown.className = 'modern-side-section';

        const breakdownLabel = document.createElement('div');
        breakdownLabel.className = 'modern-side-sub';
        breakdownLabel.textContent = 'Status breakdown';

        const breakdown = document.createElement('div');
        breakdown.className = 'modern-side-breakdown';

        const monthPosts = upcoming.map(x => x.post);
        const counts = { draft: 0, ongoing: 0, approved: 0, posted: 0, lost: 0 };
        monthPosts.forEach(p => {
            const st = (p.status || 'draft').toLowerCase();
            if (counts[st] !== undefined) counts[st] += 1;
        });

        const total = Object.values(counts).reduce((a, b) => a + b, 0) || 1;
        const rows = [
            { key: 'draft', label: 'Drafts', color: '#6b7280' },
            { key: 'ongoing', label: 'Ongoing', color: '#3b82f6' },
            { key: 'approved', label: 'Approved', color: '#22c55e' },
            { key: 'posted', label: 'Posted', color: '#a855f7' },
            { key: 'lost', label: 'Lost', color: '#ef4444' }
        ];

        rows.forEach(rowCfg => {
            const row = document.createElement('div');
            row.className = 'modern-side-breakdown-row';
            const label = document.createElement('span');
            label.textContent = `${rowCfg.label}`;
            const bar = document.createElement('div');
            bar.className = 'modern-side-breakdown-bar';
            const fill = document.createElement('div');
            fill.className = 'modern-side-breakdown-fill';
