    checkVersion: async function() {
        // Don't poll if we are editing text inputs to avoid disruptions
        if (document.activeElement && (document.activeElement.tagName === 'INPUT' || document.activeElement.tagName === 'TEXTAREA')) {
            this.scheduleNextUpdate();
            return;
        }

        try {
            const res = await fetch('?action=check_version');
            if (res.ok) {
                const json = await res.json();
                if (json.version && json.version > this.lastServerVersion) {
                    await this.loadData();
                    if (typeof this.updateBrainSyncStatus === 'function') {
                        this.updateBrainSyncStatus();
                    }
                    // Re-render current view
                    if (this.state.currentView === 'kanban') this.renderKanban();
                    if (this.state.currentView === 'calendar') this.renderCalendar();
                    if (this.state.currentView === 'dashboard') this.renderDashboard();
                    if (this.state.currentView === 'tasks') this.renderTasksView();
                    
                    const indicator = document.getElementById('liveUpdateIndicator');
                    if (indicator) {
                        indicator.classList.remove('opacity-0');
                        setTimeout(() => indicator.classList.add('opacity-0'), 2000);
                    } else {
                        this.showToast('Data updated', 'info');
                    }
                }
                // Reset delay on success
                this.liveUpdateDelay = 3000;
            } else {
                throw new Error('Server returned ' + res.status);
            }
        } catch(e) {
            // Exponential backoff
            this.liveUpdateDelay = Math.min(this.liveUpdateDelay * 1.5, 30000);
        } finally {
            this.scheduleNextUpdate();
        }
    },

    showToast: function(msg, type = 'info') {
        const container = document.getElementById('toastContainer');
        if (!container) return;

        const toast = document.createElement('div');
        toast.className = `toast ${type}`;
        
        const icons = {
            'success': 'fa-check',
            'error': 'fa-bug',
            'info': 'fa-bell',
            'warning': 'fa-exclamation-triangle'
        };

        const titles = {
            'success': 'Success',
            'error': 'Error Encountered',
            'info': 'Notification',
            'warning': 'Attention'
        };

        // Allow HTML but sanitize basic if needed (trusting internal calls mostly)
        const safeMsg = this.escapeHTML(msg).replace(/\n/g, '<br>');

        toast.innerHTML = `
            <i class="fas ${icons[type] || icons.info} main-icon"></i>
            <div class="flex-1 min-w-0">
                <div class="font-bold text-sm mb-0.5 opacity-90">${titles[type] || 'Notice'}</div>
                <div class="text-sm font-medium opacity-80 leading-snug break-words">${safeMsg}</div>
            </div>
            <button class="opacity-40 hover:opacity-100 transition-opacity p-1" onclick="this.parentElement.remove()">
                <i class="fas fa-times"></i>
            </button>
        `;
        
        toast.onclick = (e) => {
            // Don't trigger if close button was clicked (handled inline)
            if(e.target.closest('button')) return;
            toast.classList.add('toast-exit');
            setTimeout(() => toast.remove(), 400);
        };

        // Sound Effect (Subtle)
        // const audio = new Audio('assets/sounds/' + type + '.mp3');
        // audio.volume = 0.2;
        // audio.play().catch(e => {}); // Ignore autoplay errors

        container.appendChild(toast);

        // Auto remove info/success
        if (type !== 'error') {
            const timeout = setTimeout(() => {
                if (toast.parentNode) {
                    toast.classList.add('toast-exit');
                    setTimeout(() => toast.remove(), 400);
                }
            }, 6000); // Longer duration for readability

            // Pause on hover
            toast.onmouseenter = () => clearTimeout(timeout);
            toast.onmouseleave = () => {
                setTimeout(() => {
                     if (toast.parentNode) {
                        toast.classList.add('toast-exit');
                        setTimeout(() => toast.remove(), 400);
                    }
                }, 2000);
            };
        }
    },

