    openPlannerCalendarPicker: function() {
        if (this.plannerState.selectedSlot === null) {
            this.showToast('Select a grid slot first', 'info');
            return;
        }
        const modal = document.getElementById('plannerCalendarModal');
        const list = document.getElementById('plannerCalendarList');
        if (!modal || !list) return;
        const posts = (this.data.posts || []).filter(p => !p.deleted_at);
        if (posts.length === 0) {
            list.innerHTML = '<div class="text-center text-slate-400 py-6 text-sm">No calendar posts available yet.</div>';
            modal.classList.remove('hidden');
            return;
        }
        const parseTs = (p) => {
            const raw = String(p.date || '').trim();
            const parts = raw.split('-').map(Number);
            if (parts.length !== 3) return Number.POSITIVE_INFINITY;
            const dt = new Date(parts[2], parts[1] - 1, parts[0]);
            if (Number.isNaN(dt.getTime())) return Number.POSITIVE_INFINITY;
            const timeStr = String(p.post_time || '').slice(0, 5);
            if (/^\d{2}:\d{2}$/.test(timeStr)) {
                const [hh, mm] = timeStr.split(':').map(Number);
                dt.setHours(hh || 0, mm || 0, 0, 0);
            }
            return dt.getTime();
        };
        posts.sort((a, b) => parseTs(a) - parseTs(b));
        const cards = posts.map(p => {
            const mediaUrl = p.media_url || '';
            const isVideo = mediaUrl && mediaUrl.match(/\.(mp4|webm|mov)$/i);
            const caption = (p.caption || '').substring(0, 80).replace(/"/g, '&quot;');
            const dateLabel = String(p.date || '');
            const timeLabel = String(p.post_time || '');
            const product = p.product_name || '';
            const thumb = mediaUrl
                ? (isVideo
                    ? `<div class="relative aspect-square bg-black overflow-hidden rounded-xl"><video src="${mediaUrl}" class="w-full h-full object-cover" muted playsinline></video><div class="absolute top-1 right-1 bg-black/70 text-white text-[10px] px-2 py-0.5 rounded-full flex items-center gap-1"><i class="fas fa-video"></i><span>Video</span></div></div>`
                    : `<div class="relative aspect-square overflow-hidden rounded-xl bg-slate-100"><img src="${mediaUrl}" class="w-full h-full object-cover" loading="lazy" decoding="async"><div class="absolute top-1 right-1 bg-black/60 text-white text-[10px] px-2 py-0.5 rounded-full">Image</div></div>`)
                : `<div class="aspect-square rounded-xl bg-slate-100 flex items-center justify-center text-slate-300"><i class="fas fa-image text-2xl"></i></div>`;
            return `
                <div class="group p-3 bg-white rounded-2xl border border-slate-100 hover:border-pink-500 hover:shadow-lg transition-all cursor-pointer flex gap-3" onclick="App.applyCalendarPostToSlot('${p.id}')">
                    <div class="w-20">${thumb}</div>
                    <div class="flex-1 flex flex-col justify-between gap-1">
                        <div class="text-[11px] font-bold text-slate-500 flex items-center gap-2">
                            <span class="inline-flex items-center gap-1"><i class="far fa-calendar"></i><span>${dateLabel || 'No date'}</span></span>
                            ${timeLabel ? `<span class="inline-flex items-center gap-1"><i class="far fa-clock"></i><span>${timeLabel}</span></span>` : ''}
                        </div>
                        <div class="text-xs text-slate-700 line-clamp-2">${caption || 'No caption yet'}</div>
                        ${product ? `<div class="text-[11px] text-amber-600 font-semibold truncate"><i class="fas fa-box-open mr-1"></i>${product}</div>` : ''}
                        <div class="flex justify-end mt-1">
                            <span class="text-[10px] font-bold text-pink-600 opacity-0 group-hover:opacity-100 transition-opacity">Apply to this slot</span>
                        </div>
                    </div>
                </div>
            `;
        }).join('');
        list.innerHTML = cards;
        modal.classList.remove('hidden');
    },

