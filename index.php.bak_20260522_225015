    saveHoliday: async function() {
        const name = document.getElementById('holiday_name').value;
        const dateInput = document.getElementById('holiday_date').value;
        const priority = document.getElementById('holiday_priority').checked;
        const oldName = document.getElementById('holiday_old_name').value;
        const oldDate = document.getElementById('holiday_old_date').value;

        if (!name || !dateInput) return this.showToast('Name and Date are required', 'error');

        const dateObj = new Date(dateInput);
        const dayNames = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
        const formattedDate = `${String(dateObj.getDate()).padStart(2, '0')}-${String(dateObj.getMonth() + 1).padStart(2, '0')}-${dateObj.getFullYear()}`;

        const holiday = {
            date: formattedDate,
            day: dayNames[dateObj.getDay()],
            what_day: name,
            priority: priority
        };

        try {
            // If editing, maybe delete old one first if date/name changed
            if (oldDate && (oldDate !== formattedDate || oldName !== name)) {
                await fetch('?action=delete_holiday', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ date: oldDate, what_day: oldName })
                });
            }

            const res = await fetch('?action=save_holiday', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(holiday)
            });
            const result = await res.json();
            if(result.success) {
                document.getElementById('holidayModal').classList.add('hidden');
                await this.loadData();
                this.renderCalendar();
                this.renderAdminHolidays();
                this.showToast('Main Day Saved!', 'success');
            }
        } catch(e) {
            this.showToast('Error saving holiday', 'error');
        }
    },

