        const resultDiv = document.getElementById('aiSuggestionResult');
        
        if(!prompt) {
            this.showToast("Please enter a topic first", "info");
            return;
        }
        
        // Show loading state
        resultDiv.classList.remove('hidden');
        resultDiv.innerHTML = '<div class="flex items-center gap-2"><i class="fas fa-spinner fa-spin text-indigo-500"></i> Thinking...</div>';
        
        // Simulate AI Delay
        setTimeout(() => {
            const suggestions = [
                `🔥 Trending: "${prompt}" - Don't miss out! #Viral #Trending`,
                `✨ Unlock the power of ${prompt} today! Discover more at our link.`,
                `🚀 Level up your game with ${prompt}. It's time to shine!`,
                `💡 Pro Tip: ${prompt} is the key to success. What do you think?`
            ];
            const randomSuggestion = suggestions[Math.floor(Math.random() * suggestions.length)];
            
            resultDiv.innerHTML = `
                <div class="font-bold text-xs text-indigo-600 mb-1">Suggestion:</div>
                "${randomSuggestion}"
                <button onclick="App.useAIContent('${randomSuggestion.replace(/'/g, "\\'")}')" class="block mt-2 text-xs text-blue-600 font-bold hover:underline">Use this</button>
