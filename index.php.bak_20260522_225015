    renderDashboard: function() {
        const grid = document.getElementById('dashboardGrid');
        if(!grid) return;
        
        if (!this.data.posts || this.data.posts.length === 0) {
            grid.innerHTML = `
                <div class="col-span-full empty-state premium-card p-12 text-center">
                    <i class="fas fa-rocket text-blue-500 mb-4 text-5xl opacity-20"></i>
                    <h2 class="text-2xl font-bold text-slate-800 dark:text-white mb-2">Ready to Launch?</h2>
                    <p class="text-slate-500 mb-6">Your calendar is looking a bit quiet. Start planning your social media success today!</p>
                    <button onclick="App.openWizard()" class="bg-blue-600 text-white px-6 py-3 rounded-xl font-bold hover:bg-blue-700 transition transform hover:scale-105 active:scale-95 shadow-lg shadow-blue-200">
                        Create Your First Post
                    </button>
                </div>
            `;
            this.renderAnalytics();
            return;
        }
        grid.innerHTML = '';

        const now = new Date();
        const pad2 = (n) => String(n).padStart(2, '0');
        const todayStr = `${pad2(now.getDate())}-${pad2(now.getMonth() + 1)}-${now.getFullYear()}`;

        const posts = this.data.posts || [];

        const totalPosts = posts.length;
        const runningPosts = posts.filter(p => p.status === 'ongoing' || p.status === 'approved' || p.status === 'draft').length;
        const finishedPosts = posts.filter(p => p.status === 'posted').length;

        const thirtyDaysAgo = new Date(now);
        thirtyDaysAgo.setDate(now.getDate() - 30);
        let newPosts = 0;
        posts.forEach(p => {
            const [d, m, y] = (p.date || '').split('-').map(Number);
            if (!d || !m || !y) return;
            const dt = new Date(y, m - 1, d);
            if (dt >= thirtyDaysAgo && dt <= now) newPosts++;
        });

        const upcomingPosts = posts
            .map(p => {
                const [d, m, y] = (p.date || '').split('-').map(Number);
                if (!d || !m || !y) return null;
                const dt = new Date(y, m - 1, d);
                return { post: p, dt };
            })
            .filter(x => x && x.dt >= now)
            .sort((a, b) => a.dt - b.dt)
            .slice(0, 8);

        const weekStart = new Date(now);
        const dow = weekStart.getDay();
        const diff = (dow + 6) % 7;
        weekStart.setDate(weekStart.getDate() - diff);
        const weekdayCounts = [0, 0, 0, 0, 0, 0, 0];
        posts.forEach(p => {
            const [d, m, y] = (p.date || '').split('-').map(Number);
            if (!d || !m || !y) return;
            const dt = new Date(y, m - 1, d);
            if (dt < weekStart) return;
            const diffDays = Math.floor((dt - weekStart) / 86400000);
            if (diffDays >= 0 && diffDays < 7) weekdayCounts[diffDays] += 1;
        });
        const maxWeekCount = Math.max(1, ...weekdayCounts);

        const statusCounts = { draft: 0, ongoing: 0, approved: 0, posted: 0, lost: 0 };
        posts.forEach(p => {
            const s = p.status || 'draft';
            if (statusCounts[s] !== undefined) statusCounts[s] += 1;
        });

        const wrapper = document.createElement('div');
        wrapper.className = 'col-span-full space-y-8';

        const mainRow = document.createElement('div');
        mainRow.className = 'grid grid-cols-1 xl:grid-cols-[2fr_1fr] gap-6';

        const leftCol = document.createElement('div');
        leftCol.className = 'space-y-4';

        const welcome = document.createElement('div');
        welcome.className = 'flex items-center justify-between';
        const wTextWrap = document.createElement('div');
        const currentUser = this.data.current_user || {};
        const welcomeTitle = document.createElement('h2');
        welcomeTitle.className = 'text-2xl font-bold text-slate-900';
        welcomeTitle.textContent = currentUser.username ? `Welcome back, ${currentUser.username}.` : 'Welcome back.';
        const welcomeSub = document.createElement('p');
        welcomeSub.className = 'text-slate-500 text-sm';
        welcomeSub.textContent = 'Plan, prioritize, and accomplish your campaigns with a single glance.';
        wTextWrap.appendChild(welcomeTitle);
        wTextWrap.appendChild(welcomeSub);
        const wTag = document.createElement('div');
        wTag.className = 'hidden md:inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-50 text-emerald-700 text-xs font-semibold border border-emerald-100';
        const wDot = document.createElement('span');
        wDot.className = 'w-2 h-2 rounded-full bg-emerald-500';
        const wLabel = document.createElement('span');
        wLabel.textContent = 'Weekly overview';
        wTag.appendChild(wDot);
        wTag.appendChild(wLabel);
        welcome.appendChild(wTextWrap);
        welcome.appendChild(wTag);

        const kpiGrid = document.createElement('div');
        kpiGrid.className = 'grid grid-cols-2 lg:grid-cols-4 gap-4';

        const makeKpiCard = (title, value, subtitle, accent) => {
            const card = document.createElement('div');
            card.className = 'premium-card p-4 rounded-2xl border border-emerald-100 bg-white';
            const badge = document.createElement('div');
            badge.className = `mb-3 inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-${accent}-50 text-${accent}-700`;
            badge.textContent = title;
            const val = document.createElement('div');
            val.className = 'text-2xl font-bold text-slate-900';
            val.textContent = String(value);
            const sub = document.createElement('div');
            sub.className = 'text-[11px] text-slate-400';
            sub.textContent = subtitle;
            card.appendChild(badge);
            card.appendChild(val);
            card.appendChild(sub);
            return card;
        };

        kpiGrid.appendChild(makeKpiCard('Total posts', totalPosts, 'All scheduled content', 'emerald'));
        kpiGrid.appendChild(makeKpiCard('Running', runningPosts, 'Not yet posted', 'blue'));
        kpiGrid.appendChild(makeKpiCard('Finished', finishedPosts, 'Marked as posted', 'teal'));
        kpiGrid.appendChild(makeKpiCard('New this month', newPosts, 'Created in last 30 days', 'amber'));

