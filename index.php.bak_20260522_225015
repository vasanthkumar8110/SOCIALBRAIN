    getEngagementIntensity: function(dIndex, h) {
        // Realistic Social Media Usage Patterns (UAE/India Common Patterns)
        let intensity = 0;
        
        // Adjust dIndex to be 0=Mon, 6=Sun
        // JS Date.getDay() returns 0=Sun, 1=Mon...6=Sat.
        // My existing logic assumes dIndex 0-6 where 0 is Monday.
        
        if(dIndex < 5) { // Weekdays (Mon-Fri)
            if(h >= 7 && h <= 9) intensity = 5;       // Morning Commute (Peak)
            else if(h >= 12 && h <= 13) intensity = 4; // Lunch Break
            else if(h >= 17 && h <= 19) intensity = 5; // Evening Commute (Peak)
            else if(h >= 20 && h <= 22) intensity = 4; // Prime Time
            else if(h >= 9 && h < 17) intensity = 2;   // Work Hours (Lower)
            else if(h >= 6 && h < 7) intensity = 2;    // Early Morning
            else intensity = 0;                        // Sleep (Low)
        } else { // Weekends (Sat-Sun)
            if(h >= 10 && h <= 13) intensity = 5;      // Late Morning/Brunch
            else if(h >= 19 && h <= 23) intensity = 5; // Evening Social
            else if(h >= 14 && h <= 18) intensity = 3; // Afternoon
            else if(h >= 8 && h < 10) intensity = 2;   // Early Morning
            else intensity = 0;
        }
        
        return intensity;
    },

    renderBestTimeTimeline: function() {
        const container = document.getElementById('heatmapTimeline');
        if(!container) return;
        container.innerHTML = '';
        
        const now = new Date();
        const currentDayIndex = (now.getDay() + 6) % 7; // Convert 0=Sun to 0=Mon, 6=Sun
        const days = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];
        
        const createSection = (title, icon, content) => {
            const section = document.createElement('div');
            section.className = 'bg-slate-50 rounded-xl p-6 border border-slate-100';
            section.innerHTML = `
                <div class="flex items-center gap-3 mb-4">
                    <div class="w-10 h-10 rounded-full bg-white border border-slate-100 flex items-center justify-center text-lg shadow-sm text-fuchsia-600">
                        ${icon}
                    </div>
                    <h4 class="font-bold text-lg text-slate-800">${title}</h4>
                </div>
                <div class="space-y-3">
                    ${content}
                </div>
            `;
            return section;
        };
        
        // Helper to format time range
        const formatTime = (h) => {
            const ampm = h >= 12 ? 'PM' : 'AM';
            const hour = h % 12 || 12;
            return `${hour}:00 ${ampm}`;
        };
        
        // Helper to get best slots for a day
        const getBestSlots = (dIdx) => {
            const slots = [];
            for(let h=0; h<24; h++) {
                const intensity = this.getEngagementIntensity(dIdx, h);
                if(intensity >= 4) {
                    slots.push({ h, intensity });
                }
            }
            return slots;
        };
        
        // Helper to render slots HTML
        const renderSlots = (slots) => {
            if(slots.length === 0) return '<div class="text-slate-400 italic">No high impact slots today</div>';
            
            // Group consecutive hours
            const groups = [];
            let currentGroup = null;
            
            slots.forEach(s => {
                if(currentGroup && s.h === currentGroup.end + 1 && s.intensity === currentGroup.intensity) {
                    currentGroup.end = s.h;
                } else {
                    if(currentGroup) groups.push(currentGroup);
                    currentGroup = { start: s.h, end: s.h, intensity: s.intensity };
                }
            });
            if(currentGroup) groups.push(currentGroup);
            
            return groups.map(g => `
                <div class="flex items-center justify-between bg-white p-3 rounded-lg border border-slate-100 shadow-sm hover:shadow-md transition-shadow">
                    <div class="flex items-center gap-3">
                        <div class="w-2 h-2 rounded-full ${g.intensity === 5 ? 'bg-red-500 animate-pulse' : 'bg-orange-400'}"></div>
                        <span class="font-bold text-slate-700">${formatTime(g.start)} - ${formatTime(g.end + 1)}</span>
                    </div>
                    <span class="text-xs font-bold px-2 py-1 rounded-full ${g.intensity === 5 ? 'bg-red-50 text-red-600' : 'bg-orange-50 text-orange-600'}">
                        ${g.intensity === 5 ? 'Peak 🔥' : 'High 🚀'}
                    </span>
                </div>
            `).join('');
        };
        
        // 1. Today
        const todaySlots = getBestSlots(currentDayIndex);
        container.appendChild(createSection('Today', '<i class="fas fa-calendar-day"></i>', renderSlots(todaySlots)));
        
        // 2. Tomorrow
        const tmrwIndex = (currentDayIndex + 1) % 7;
        const tmrwSlots = getBestSlots(tmrwIndex);
        container.appendChild(createSection('Tomorrow', '<i class="fas fa-sun"></i>', renderSlots(tmrwSlots)));
        
        // 3. This Week
        const weekContent = document.createElement('div');
        weekContent.className = 'grid grid-cols-1 md:grid-cols-2 gap-4';
        
        // Loop remaining days of week
        let remainingDaysHtml = '';
        for(let i=2; i<7; i++) {
            const dIdx = (currentDayIndex + i) % 7;
            const dName = days[dIdx];
            const slots = getBestSlots(dIdx);
            
            // Just take top 2 groups to save space
            const simpleSlots = renderSlots(slots).split('</div>').slice(0, 2).join('</div>') + (slots.length > 2 ? '</div>' : ''); // Hacky text slice, better to reuse logic
            
            // Re-render simplified for grid
            const groups = [];
            let currentGroup = null;
            slots.forEach(s => {
                if(currentGroup && s.h === currentGroup.end + 1 && s.intensity === currentGroup.intensity) {
                    currentGroup.end = s.h;
                } else {
                    if(currentGroup) groups.push(currentGroup);
                    currentGroup = { start: s.h, end: s.h, intensity: s.intensity };
                }
            });
            if(currentGroup) groups.push(currentGroup);
            
            const bestTimesStr = groups.slice(0, 3).map(g => 
                `<span class="inline-block px-2 py-1 bg-white border border-slate-200 rounded text-xs font-bold text-slate-600 mr-1 mb-1">${formatTime(g.start)}-${formatTime(g.end+1)}</span>`
            ).join('');
            
            remainingDaysHtml += `
                <div class="p-3 bg-white rounded-lg border border-slate-100">
                    <div class="font-bold text-fuchsia-600 mb-2">${dName}</div>
                    <div class="flex flex-wrap">${bestTimesStr || '<span class="text-slate-400 text-xs">Low Activity</span>'}</div>
                </div>
            `;
        }
        
        const weekSection = createSection('Rest of Week', '<i class="fas fa-calendar-week"></i>', `<div class="grid grid-cols-1 md:grid-cols-2 gap-3">${remainingDaysHtml}</div>`);
        container.appendChild(weekSection);
        
        // 4. This Month (Strategic Insight)
        const monthContent = `
            <div class="p-4 bg-gradient-to-r from-indigo-500 to-purple-600 rounded-xl text-white">
                <div class="font-bold text-lg mb-2"><i class="fas fa-star mr-2"></i>Strategic Insight</div>
                <p class="text-indigo-100 text-sm mb-4">
                    Your audience in UAE/India is most active during <strong>Evening Commutes (5-7 PM)</strong> on weekdays and <strong>Late Nights (7-11 PM)</strong> on weekends.
                </p>
                <div class="flex items-center gap-4 text-sm font-bold bg-white/10 p-3 rounded-lg">
                    <span><i class="fas fa-trophy text-yellow-300 mr-2"></i>Best Day:</span>
                    <span>Friday & Saturday</span>
                </div>
            </div>
            
            <div class="mt-4">
                <h5 class="font-bold text-slate-700 mb-2">Upcoming High-Traffic Holidays</h5>
                <div id="timelineHolidays" class="space-y-2">
                    <!-- Loaded dynamically -->
                </div>
            </div>
        `;
        
        const monthSection = createSection('This Month', '<i class="fas fa-calendar-alt"></i>', monthContent);
        container.appendChild(monthSection);
        
        // Load holidays for the month section
        const holidays = this.data.holidays || [];
        const todayDate = new Date();
        todayDate.setHours(0,0,0,0);
        const next30Days = new Date(todayDate);
        next30Days.setDate(todayDate.getDate() + 30);
        
        const upcoming = holidays
            .map(h => {
                const parts = h.date.split('-');
                const d = new Date(parts[2], parts[1]-1, parts[0]);
                return { ...h, dt: d };
            })
            .filter(h => h.dt >= todayDate && h.dt <= next30Days)
            .sort((a,b) => a.dt - b.dt)
            .slice(0, 3);
            
        const holidayContainer = monthSection.querySelector('#timelineHolidays');
        if(upcoming.length > 0) {
            holidayContainer.innerHTML = upcoming.map(h => `
                <div class="flex items-center justify-between p-2 bg-red-50 border border-red-100 rounded-lg">
                    <span class="font-bold text-red-700 text-sm">${h.what_day}</span>
                    <span class="text-xs text-red-500 font-mono">${h.date}</span>
                </div>
            `).join('');
        } else {
            holidayContainer.innerHTML = '<div class="text-slate-400 text-sm italic">No major holidays in next 30 days</div>';
        }
    },

