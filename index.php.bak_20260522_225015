    updateBrainSyncStatus: function() {
        const pill = document.getElementById('brainSyncPill');
        const label = document.getElementById('brainSyncLabel');
        if (!pill || !label) return;
        const ts = this.data && this.data.last_brain_sync ? Number(this.data.last_brain_sync) : 0;
        if (!ts) {
            label.textContent = 'Brain: not synced yet';
            pill.classList.remove('bg-emerald-100', 'text-emerald-700', 'bg-amber-100', 'text-amber-700');
            pill.classList.add('bg-slate-100', 'text-slate-500');
            return;
        }
        const nowSec = Math.floor(Date.now() / 1000);
        const diff = Math.max(0, nowSec - ts);
        let text = '';
        pill.classList.remove('bg-slate-100', 'text-slate-500', 'bg-emerald-100', 'text-emerald-700', 'bg-amber-100', 'text-amber-700');
        if (diff <= 120) {
            text = 'Brain: just synced';
            pill.classList.add('bg-emerald-100', 'text-emerald-700');
        } else if (diff <= 3600) {
            const mins = Math.round(diff / 60);
            text = 'Brain: ' + mins + ' min ago';
            pill.classList.add('bg-emerald-100', 'text-emerald-700');
        } else {
            const hours = Math.round(diff / 3600);
            text = 'Brain: ' + hours + 'h ago';
            pill.classList.add('bg-amber-100', 'text-amber-700');
        }
        label.textContent = text;
    },

