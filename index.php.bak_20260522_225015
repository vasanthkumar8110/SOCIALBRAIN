
<?php
require_once __DIR__ . '/functions.php';

sb_session_start_secure();
header("X-Frame-Options: SAMEORIGIN");
header("X-Content-Type-Options: nosniff");

// --- Auth Setup ---
$currentUserRole = checkAuthAndGetRole();

// Compatibility for API users (populate $_SESSION for existing logic)
if ($currentUser && ($currentUser['is_api'] ?? false)) {
    $_SESSION['user_id'] = $currentUser['id'];
    $_SESSION['username'] = $currentUser['username'];
    $_SESSION['role'] = $currentUser['role'];
}


// --- Router & Controllers ---

$method = $_SERVER['REQUEST_METHOD'];
$action = $_REQUEST['action'] ?? 'view';

// CSRF: require for state-changing authenticated actions
$csrfExempt = [
    'login',
    'signup',
    'recover_password',
    'register_admin',
    'register_invited'
];
if ($method === 'POST' && !in_array($action, $csrfExempt, true)) {
    // If user is authenticated (session-based), enforce CSRF.
    // API-key calls should use header auth and are not browser-driven.
    if (!empty($_SESSION['user_id']) && empty($currentUser['is_api'])) {
        sb_require_csrf();
    }
}

// 0. AUTH ACTIONS (Public)
if ($action === 'login' && $method === 'POST') {
    $input = json_decode(file_get_contents('php://input'), true);
    if (!is_array($input) || empty($input['username']) || empty($input['password'])) {
        jsonResponse(null, false, 'Invalid request');
    }
    $masterData = loadJSON(MASTER_BRAIN_FILE);
    $users = $masterData['users'] ?? [];
    
    if (empty($users)) {
        // Safe fallback: if no users, maybe it's a fresh install
        jsonResponse(null, false, 'No users registered. Please sign up.');
    }

    foreach ($users as $user) {
        if ($user['username'] === $input['username'] && password_verify($input['password'], $user['password_hash'])) {
            if (!empty($user['is_disabled'])) {
                jsonResponse(null, false, 'Account is disabled. Contact your administrator.');
            }

            session_regenerate_id(true); // Prevent session fixation
            
            // Direct Login (Fixed: Removed incomplete 2FA flow)
            $_SESSION['user_id'] = $user['id'];
            $_SESSION['username'] = $user['username'];
            $_SESSION['role'] = $user['role'] ?? 'user';
            $_SESSION['team_id'] = $user['team_id'] ?? ('team_' . $user['id']);
            $_SESSION['last_activity'] = time();
            
            if (function_exists('logActivity')) {
                logActivity($user['id'], 'login_success', ['role' => $_SESSION['role']]);
            }
            
            jsonResponse(['redirect' => 'index.php'], true, 'Login successful');
        }
    }
    jsonResponse(null, false, 'Invalid username or password');
}

// 0.1 VERIFY MAGIC LINK
if ($action === 'verify_magic_link') {
    if (!isset($_SESSION['pending_user_id'])) {
        jsonResponse(null, false, 'Session expired or invalid. Please login again.');
    }

    $masterData = loadJSON(MASTER_BRAIN_FILE);
    $userId = $_SESSION['pending_user_id'];
    $user = null;
    foreach ($masterData['users'] as $u) {
        if ($u['id'] === $userId) {
            $user = $u;
            break;
        }
    }

    if ($user) {
        // Finalize Login
        session_regenerate_id(true); // Prevent session fixation
        
        $_SESSION['user_id'] = $user['id'];
        $_SESSION['username'] = $user['username'];
        $_SESSION['role'] = $user['role'] ?? 'user';
        $_SESSION['assigned_panel'] = $user['assigned_panel'] ?? '';
        $_SESSION['team_id'] = $user['team_id'] ?? ('team_' . $user['id']);
        $_SESSION['last_activity'] = time();
        
        // Clear pending
        unset($_SESSION['pending_user_id']);
        unset($_SESSION['pending_username']);
        
        logActivity($user['id'], 'login_success_verified', ['role' => $_SESSION['role'], 'team' => $_SESSION['team_id']]);
        
        jsonResponse(['redirect' => 'index.php'], true, 'Verification successful');
    } else {
        jsonResponse(null, false, 'User not found');
    }
}

// --- HIERARCHICAL REGISTRATION SYSTEM ---

// 1. Register Primary Admin (Payment/Trial Flow)
if ($action === 'register_admin' && $method === 'POST') {
    $input = json_decode(file_get_contents('php://input'), true);
    if (!is_array($input) || empty($input['username']) || empty($input['password']) || empty($input['secret_q']) || empty($input['secret_a'])) {
        jsonResponse(null, false, 'Invalid request');
    }
    if (strlen((string)$input['password']) < 10) {
        jsonResponse(null, false, 'Password must be at least 10 characters');
    }
    $masterData = loadJSON(MASTER_BRAIN_FILE);
    if (!isset($masterData['users'])) $masterData['users'] = [];
    
    // Check if username exists
    foreach ($masterData['users'] as $u) {
        if ($u['username'] === $input['username']) {
            jsonResponse(null, false, 'Username already exists');
        }
    }
    
    // Determine status based on "payment"
    $paymentStatus = $input['payment_status'] ?? 'trial'; // 'paid' or 'trial'
    $role = 'admin'; // Always admin for this endpoint
    
    $newUser = [
        'id' => generateID('user_'),
        'username' => $input['username'],
        'password_hash' => password_hash($input['password'], PASSWORD_DEFAULT),
        'secret_q' => $input['secret_q'] ?? '',
        'secret_a_hash' => isset($input['secret_a']) ? password_hash($input['secret_a'], PASSWORD_DEFAULT) : '',
        'role' => $role,
        'payment_status' => $paymentStatus,
        'created_at' => date('c'),
        'is_disabled' => false,
        'team_id' => generateID('team_') // Each Admin starts their own team/hierarchy
    ];
    
    $masterData['users'][] = $newUser;
    if (saveJSON(MASTER_BRAIN_FILE, $masterData)) {
        $_SESSION['user_id'] = $newUser['id'];
        $_SESSION['username'] = $newUser['username'];
        $_SESSION['role'] = $newUser['role'];
        $_SESSION['team_id'] = $newUser['team_id'];
        $_SESSION['last_activity'] = time();
        logActivity($newUser['id'], 'admin_registered', ['payment' => $paymentStatus]);
        
        jsonResponse(['username' => $newUser['username']], true, 'Admin account created');
    } else {
        jsonResponse(null, false, 'Failed to save account');
    }
}

// 2. Generate Invite Link (Admin Only)
if ($action === 'create_invite' && $method === 'POST') {
    if (!isset($_SESSION['role']) || $_SESSION['role'] !== 'admin') {
        jsonResponse(null, false, 'Unauthorized: Only Admins can invite');
    }
    
    $input = json_decode(file_get_contents('php://input'), true);
    $targetRole = $input['role']; // 'editor' or 'viewer'
    
    if (!in_array($targetRole, ['editor', 'viewer'])) {
        jsonResponse(null, false, 'Invalid role. Can only invite Editors or Viewers.');
    }
    
    $masterData = loadJSON(MASTER_BRAIN_FILE);
    if (!isset($masterData['invites'])) $masterData['invites'] = [];
    
    // Find current admin's team_id to link subordinate
    $currentAdminId = $_SESSION['user_id'];
    $adminUser = null;
    foreach($masterData['users'] as $u) {
        if($u['id'] === $currentAdminId) {
            $adminUser = $u;
            break;
        }
    }
    
    // Fallback if team_id missing
    $teamId = $adminUser['team_id'] ?? ('team_' . $currentAdminId); 
    
    $token = bin2hex(random_bytes(16));
    $invite = [
        'token' => $token,
        'created_by' => $currentAdminId,
        'team_id' => $teamId,
        'target_role' => $targetRole,
        'created_at' => date('c'),
        'expires_at' => date('c', strtotime('+7 days'))
    ];
    
    $masterData['invites'][] = $invite;
    saveJSON(MASTER_BRAIN_FILE, $masterData);
    
    // Return the full link (assuming current host)
    $protocol = isset($_SERVER['HTTPS']) && $_SERVER['HTTPS'] === 'on' ? "https" : "http";
    $host = $_SERVER['HTTP_HOST'];
    $path = dirname($_SERVER['PHP_SELF']);
    $link = "$protocol://$host$path/?invite=$token";
    
    jsonResponse(['link' => $link, 'token' => $token], true, 'Invite link generated');
}

// 3. Register via Invite
if ($action === 'register_invited' && $method === 'POST') {
    $input = json_decode(file_get_contents('php://input'), true);
    $token = $input['token'] ?? '';
    
    $masterData = loadJSON(MASTER_BRAIN_FILE);
    $invites = $masterData['invites'] ?? [];
    
    // Validate Token
    $validInvite = null;
    $inviteIndex = -1;
    
    foreach ($invites as $idx => $inv) {
        if ($inv['token'] === $token) {
            if (strtotime($inv['expires_at']) > time()) {
                $validInvite = $inv;
                $inviteIndex = $idx;
            } else {
                jsonResponse(null, false, 'Invite link expired');
            }
            break;
        }
    }
    
    if (!$validInvite) {
        jsonResponse(null, false, 'Invalid invite link');
    }
    
    // Check username
    foreach ($masterData['users'] as $u) {
        if ($u['username'] === $input['username']) {
            jsonResponse(null, false, 'Username already exists');
        }
    }
    
    $newUser = [
        'id' => generateID('user_'),
        'username' => $input['username'],
        'password_hash' => password_hash($input['password'], PASSWORD_DEFAULT),
        'role' => $validInvite['target_role'],
        'created_by' => $validInvite['created_by'],
        'team_id' => $validInvite['team_id'],
        'payment_status' => 'subaccount', // Subaccounts don't pay directly
        'created_at' => date('c'),
        'is_disabled' => false
    ];
    
    $masterData['users'][] = $newUser;
    
    // Remove used invite
    array_splice($masterData['invites'], $inviteIndex, 1);
    
    if (saveJSON(MASTER_BRAIN_FILE, $masterData)) {
        // Auto-login
        $_SESSION['user_id'] = $newUser['id'];
        $_SESSION['username'] = $newUser['username'];
        $_SESSION['role'] = $newUser['role'];
        $_SESSION['last_activity'] = time();
        logActivity($newUser['id'], 'subaccount_registered', ['role' => $newUser['role'], 'team' => $newUser['team_id']]);
        
        jsonResponse(['username' => $newUser['username']], true, 'Account created successfully');
    } else {
        jsonResponse(null, false, 'Failed to save account');
    }
}

if ($action === 'signup' && $method === 'POST') {
    $input = json_decode(file_get_contents('php://input'), true);
    if (!is_array($input) || empty($input['username']) || empty($input['password']) || empty($input['secret_a'])) {
        jsonResponse(null, false, 'Invalid request');
    }
    if (strlen((string)$input['password']) < 10) {
        jsonResponse(null, false, 'Password must be at least 10 characters');
    }
    $masterData = loadJSON(MASTER_BRAIN_FILE);
    if (!isset($masterData['users'])) $masterData['users'] = [];
    
    // Check if user exists
    foreach ($masterData['users'] as $u) {
        if ($u['username'] === $input['username']) {
            jsonResponse(null, false, 'Username already exists');
        }
    }
    
    $newUser = [
        'id' => generateID('user_'),
        'username' => $input['username'],
        'password_hash' => password_hash($input['password'], PASSWORD_DEFAULT),
        'secret_q' => $input['secret_q'],
        'secret_a_hash' => password_hash($input['secret_a'], PASSWORD_DEFAULT),
        'role' => (count($masterData['users']) === 0) ? 'admin' : 'user',
        'created_at' => date('c'),
        'team_id' => generateID('team_') // Public signup creates a new team/brain
    ];
    
    $masterData['users'][] = $newUser;
    if (saveJSON(MASTER_BRAIN_FILE, $masterData)) {
        $_SESSION['user_id'] = $newUser['id'];
        $_SESSION['username'] = $newUser['username'];
        $_SESSION['role'] = $newUser['role'];
        $_SESSION['team_id'] = $newUser['team_id'];
        $_SESSION['last_activity'] = time();
        jsonResponse(['username' => $newUser['username']], true, 'Account created');
    } else {
        jsonResponse(null, false, 'Failed to save account. Check directory permissions.');
    }
}

if ($action === 'logout') {
    $_SESSION = [];
    if (ini_get('session.use_cookies')) {
        $p = session_get_cookie_params();
        setcookie(session_name(), '', time() - 3600, $p['path'], $p['domain'], $p['secure'], $p['httponly']);
    }
    session_destroy();
    jsonResponse(null, true, 'Logged out');
}

if ($action === 'recover_password' && $method === 'POST') {
    $input = json_decode(file_get_contents('php://input'), true);
    $masterData = loadJSON(MASTER_BRAIN_FILE);
    $users = $masterData['users'] ?? [];
    
    if ($input['step'] === 'get_question') {
        foreach ($users as $user) {
            if ($user['username'] === $input['username']) {
                jsonResponse(['secret_q' => $user['secret_q']]);
            }
        }
        jsonResponse(null, false, 'User not found');
    }
    
    if ($input['step'] === 'reset') {
        foreach ($masterData['users'] as &$user) {
            if ($user['username'] === $input['username'] && password_verify($input['secret_a'], $user['secret_a_hash'])) {
                $user['password_hash'] = password_hash($input['new_password'], PASSWORD_DEFAULT);
                saveJSON(MASTER_BRAIN_FILE, $masterData);
                jsonResponse(null, true, 'Password reset successful');
            }
        }
        jsonResponse(null, false, 'Incorrect answer');
    }
}

// --- User Management Actions ---
if ($action === 'save_user' && $method === 'POST') {
    if ($_SESSION['role'] !== 'admin') jsonResponse(null, false, 'Unauthorized');
    
    $input = json_decode(file_get_contents('php://input'), true);
    $masterData = loadJSON(MASTER_BRAIN_FILE);
    if (!isset($masterData['users'])) $masterData['users'] = [];
    $currentTeamId = $_SESSION['team_id'] ?? '';
    if (!$currentTeamId) jsonResponse(null, false, 'Missing team context');
    
    $id = $input['id'] ?? '';
    $username = trim($input['username']);
    $password = $input['password'] ?? '';
    $role = $input['role'] ?? 'viewer';
    $assigned_panel = $input['assigned_panel'] ?? '';
    $payment_status = $input['payment_status'] ?? 'free'; // free, paid, trial
    $is_disabled = !empty($input['is_disabled']);
    
    if (empty($username)) jsonResponse(null, false, 'Username is required');
    
    // Check duplicates
    foreach ($masterData['users'] as $u) {
        if ($u['username'] === $username && $u['id'] !== $id) {
            jsonResponse(null, false, 'Username already taken');
        }
    }
    
    if ($id) {
        // Edit existing
        foreach ($masterData['users'] as &$u) {
            if ($u['id'] === $id) {
                if (($u['team_id'] ?? '') !== $currentTeamId) {
                    jsonResponse(null, false, 'Cannot modify user from another team');
                }
                $u['username'] = $username;
                $u['role'] = $role;
                $u['assigned_panel'] = $assigned_panel;
                $u['payment_status'] = $payment_status;
                $u['is_disabled'] = $is_disabled;
                if (!empty($password)) {
                    $u['password_hash'] = password_hash($password, PASSWORD_DEFAULT);
                }
                $u['updated_at'] = date('c');
                break;
            }
        }
    } else {
        // Create new
        if (empty($password)) jsonResponse(null, false, 'Password is required for new users');
        $newUser = [
            'id' => generateID('user_'),
            'username' => $username,
            'password_hash' => password_hash($password, PASSWORD_DEFAULT),
            'role' => $role,
            'assigned_panel' => $assigned_panel,
            'payment_status' => $payment_status,
            'is_disabled' => $is_disabled,
            'secret_q' => '', 
            'secret_a_hash' => '',
            'created_at' => date('c'),
            'last_login' => null,
            'team_id' => $currentTeamId
        ];
        $masterData['users'][] = $newUser;
    }
    
    // Ensure array is sequential before saving to prevent JSON object conversion
    $masterData['users'] = array_values($masterData['users']);
    saveJSON(MASTER_BRAIN_FILE, $masterData);
    logActivity($_SESSION['user_id'], $id ? 'update_user' : 'create_user', ['username' => $username, 'role' => $role]);
    jsonResponse(null, true, 'User saved successfully');
}

if ($action === 'delete_user' && $method === 'POST') {
    if ($_SESSION['role'] !== 'admin') jsonResponse(null, false, 'Unauthorized');
    
    $input = json_decode(file_get_contents('php://input'), true);
    $id = $input['id'] ?? '';
    
    if ($id === $_SESSION['user_id']) jsonResponse(null, false, 'Cannot delete yourself');
    
    $masterData = loadJSON(MASTER_BRAIN_FILE);
    $currentTeamId = $_SESSION['team_id'] ?? '';
    $originalCount = count($masterData['users']);
    $masterData['users'] = array_values(array_filter($masterData['users'], function($u) use ($id, $currentTeamId) {
        if ($u['id'] === $id) {
            if (($u['team_id'] ?? '') !== $currentTeamId) {
                return true;
            }
            return false;
        }
        return true;
    }));
    
    if (count($masterData['users']) === $originalCount) {
        jsonResponse(null, false, 'User not found');
    }
    
    saveJSON(MASTER_BRAIN_FILE, $masterData);
    logActivity($_SESSION['user_id'], 'delete_user', ['id' => $id]);
    jsonResponse(null, true, 'User deleted');
}

if ($action === 'get_users' && $method === 'GET') {
    if ($_SESSION['role'] !== 'admin') jsonResponse(null, false, 'Unauthorized');
    
    $masterData = loadJSON(MASTER_BRAIN_FILE);
    $currentTeamId = $_SESSION['team_id'] ?? '';
    $safeUsers = array_values(array_filter($masterData['users'] ?? [], function($u) use ($currentTeamId) {
        if (!$currentTeamId) return false;
        return ($u['team_id'] ?? null) === $currentTeamId;
    }));
    $safeUsers = array_map(function($u) {
        unset($u['password_hash']);
        unset($u['secret_a_hash']);
        return $u;
    }, $safeUsers);
    
    jsonResponse(array_values($safeUsers));
}

// 1. Check Auth for remaining actions
if (!$currentUserRole && !in_array($action, ['view', 'login', 'signup', 'recover_password'])) {
    jsonResponse(null, false, 'Unauthorized');
}

// --- RBAC: Role-Based Access Control ---
// Admin: Full Access
// Editor: Save/Update Content, No Deletion of Critical Data (unless allowed), No User Mgmt
// Viewer: Read Only

$allowedActions = [
    'admin' => ['*'],
    'editor' => ['get_data', 'save_post', 'update_post_date', 'update_status', 'save_product', 'save_sector', 'save_category', 'save_sub_category', 'bulk_upload_products', 'bulk_upload_posts', 'ultra_brain_sync', 'analyze_post_safety', 'save_task', 'update_task_status', 'delete_task', 'planner_save', 'planner_load'],
    'viewer' => ['get_data', 'planner_load']
];

$role = $_SESSION['role'] ?? 'viewer'; // Default to viewer if undefined
$currentRolePermissions = $allowedActions[$role] ?? [];

// If not admin, check specific permissions
if ($role !== 'admin' && !in_array($action, $currentRolePermissions)) {
     // Allow public/auth actions always (handled above), but block others
     if (!in_array($action, ['view', 'login', 'signup', 'recover_password'])) {
         jsonResponse(null, false, "Permission denied for role: $role");
     }
}

// 1. Get All Data
if ($action === 'get_data' && $method === 'GET') {
    $data = loadJSON(MASTER_BRAIN_FILE);
    
    // Prepare Team Map for Legacy Data (Data without team_id)
    $userTeamMap = [];
    $safeUsers = [];
    if (isset($data['users']) && is_array($data['users'])) {
        foreach ($data['users'] as $u) {
            $uid = $u['id'] ?? '';
            if ($uid !== '') {
                $userTeamMap[$uid] = $u['team_id'] ?? ('team_' . $uid);
            }
            $safeUsers[] = [
                'id' => $uid,
                'username' => $u['username'] ?? '',
                'role' => $u['role'] ?? 'viewer',
                'team_id' => $u['team_id'] ?? null
            ];
        }
    }

    // Security: NEVER send user hashes to the frontend
    $currentTeamId = $_SESSION['team_id'] ?? '';
    $data['users'] = array_values(array_filter($safeUsers, function($u) use ($currentTeamId) {
        return ($u['team_id'] ?? null) === $currentTeamId;
    }));

    if (!isset($data['logs']) || !is_array($data['logs'])) {
        $data['logs'] = [];
    }
    $allLogs = $data['logs'];
    
    // Helper: Filter by Team
    $filterByTeam = function($items) use ($currentTeamId, $userTeamMap) {
        if (!is_array($items)) return [];
        return array_values(array_filter($items, function($item) use ($currentTeamId, $userTeamMap) {
            // 1. Direct Team ID Match
            if (isset($item['team_id']) && $item['team_id'] === $currentTeamId) {
                return true;
            }
            // 2. Legacy: Check created_by
            if (!isset($item['team_id']) && isset($item['created_by'])) {
                $creatorTeam = $userTeamMap[$item['created_by']] ?? '';
                if ($creatorTeam === $currentTeamId) return true;
            }
            // 3. Explicitly Global (if we add 'is_global' flag later)
            // For now, strict isolation: hide if no match.
            return false;
        }));
    };

    // Filter Logs
    $data['logs'] = array_values(array_filter($allLogs, function($log) use ($currentTeamId, $userTeamMap) {
        // Logs use 'user_id' usually
        $logUser = $log['user_id'] ?? '';
        // If log has team info (some do from recent updates)
        if (isset($log['team'])) return $log['team'] === $currentTeamId;
        
        // Fallback to user map
        $logTeam = $userTeamMap[$logUser] ?? '';
        return $logTeam === $currentTeamId;
    }));
    
    // Limit logs for performance (last 1000)
    if (count($data['logs']) > 1000) {
        $data['logs'] = array_slice($data['logs'], -1000);
    }

    $defaults = [
        'posts' => [],
        'products' => [],
        'sectors' => [],
        'categories' => [],
        'sub_categories' => [],
        'platforms' => [],
        'holidays' => [],
        'tasks' => []
    ];
    $data = array_merge($defaults, $data);

    $platformsChanged = false;
    if (!isset($data['platforms']) || !is_array($data['platforms']) || count($data['platforms']) === 0) {
        $data['platforms'] = [
            [
                'id' => 'instagram',
                'name' => 'Instagram',
                'icon' => 'fab fa-instagram',
                'enabled' => true,
                'post_types' => ['feed_post', 'story', 'reel']
            ],
            [
                'id' => 'facebook',
                'name' => 'Facebook',
                'icon' => 'fab fa-facebook',
                'enabled' => true,
                'post_types' => [
                    'profile' => ['status_update', 'photo', 'video'],
                    'pages' => ['page_post', 'page_event', 'page_offer']
                ]
            ],
            [
                'id' => 'tiktok',
                'name' => 'TikTok',
                'icon' => 'fab fa-tiktok',
                'enabled' => true,
                'post_types' => ['video', 'live']
            ],
            [
                'id' => 'youtube',
                'name' => 'YouTube',
                'icon' => 'fab fa-youtube',
                'enabled' => true,
                'post_types' => ['short', 'video']
            ],
            [
                'id' => 'linkedin',
                'name' => 'LinkedIn',
                'icon' => 'fab fa-linkedin',
                'enabled' => true,
                'post_types' => ['post', 'article']
            ],
            [
                'id' => 'twitter',
                'name' => 'Twitter',
                'icon' => 'fab fa-twitter',
                'enabled' => true,
                'post_types' => ['tweet', 'thread']
            ]
        ];
        $platformsChanged = true;
    } else {
        foreach ($data['platforms'] as &$platform) {
            if (!is_array($platform)) {
                continue;
            }
            if (($platform['id'] ?? '') === 'facebook') {
                if (!isset($platform['icon'])) {
                    $platform['icon'] = 'fab fa-facebook';
                    $platformsChanged = true;
                }
                if (!isset($platform['enabled'])) {
                    $platform['enabled'] = true;
                    $platformsChanged = true;
                }
                $pt = $platform['post_types'] ?? null;
                $needsTwoWay = true;
                if (is_array($pt) && isset($pt['profile']) && isset($pt['pages'])) {
                    $needsTwoWay = false;
                }
                if ($needsTwoWay) {
                    $platform['post_types'] = [
                        'profile' => ['status_update', 'photo', 'video'],
                        'pages' => ['page_post', 'page_event', 'page_offer']
                    ];
                    $platformsChanged = true;
                }
            }
        }
        unset($platform);
    }
    if ($platformsChanged) {
        saveJSON(MASTER_BRAIN_FILE, $data);
    }
    
    // Filter Core Data Lists
    // Note: Sectors/Categories/Products usually don't have 'created_by'. 
    // We need to update save_product to add team_id. 
    // For legacy products without created_by/team_id, they might disappear!
    // FIX: For products/sectors without team_id/created_by, we assume they belong to the FIRST Admin (or Global).
    // Or we show them to everyone? User said "each account each brain".
    // Better: If no team_id, show to everyone? No, that breaks isolation.
    // Compromise: Show legacy shared data (no team_id) to everyone, BUT new data is isolated.
    // This ensures current setup doesn't break, but new teams get their own space.
    
    $filterByTeamOrGlobal = function($items) use ($currentTeamId, $userTeamMap) {
        if (!is_array($items)) return [];
        return array_values(array_filter($items, function($item) use ($currentTeamId, $userTeamMap) {
            if (isset($item['team_id']) && $item['team_id'] !== '') {
                return $item['team_id'] === $currentTeamId;
            }
            if (isset($item['created_by'])) {
                $creatorTeam = $userTeamMap[$item['created_by']] ?? '';
                return $creatorTeam === $currentTeamId;
            }
            return false; 
        }));
    };

    $data['posts'] = $filterByTeam($data['posts']); // Posts usually have created_by, so strict is fine
    $data['products'] = $filterByTeamOrGlobal($data['products']);
    $data['sectors'] = $filterByTeamOrGlobal($data['sectors']);
    $data['categories'] = $filterByTeamOrGlobal($data['categories']);
    $data['sub_categories'] = $filterByTeamOrGlobal($data['sub_categories']);
    $data['tasks'] = $filterByTeamOrGlobal($data['tasks']);
    $data['holidays'] = $filterByTeamOrGlobal($data['holidays']);
    
    // Ensure strict array structure for lists (prevent JSON objects from legacy bad saves)
    foreach (['posts', 'products', 'sectors', 'categories', 'sub_categories', 'holidays', 'platforms', 'tasks'] as $key) {
        if (isset($data[$key]) && is_array($data[$key])) {
            $data[$key] = array_values($data[$key]);
        }
    }
    
    $data['current_user'] = [
        'id' => $_SESSION['user_id'] ?? '',
        'username' => $_SESSION['username'] ?? 'guest',
        'role' => $_SESSION['role'] ?? 'viewer',
        'assigned_panel' => $_SESSION['assigned_panel'] ?? ''
    ];
    
    $teamBrainReady = false;
    if ($currentTeamId !== '') {
        $teamFile = getTeamBrainFile($currentTeamId);
        if ($teamFile) {
            $teamData = $data;
            $teamData['team_meta'] = [
