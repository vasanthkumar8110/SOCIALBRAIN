    openProductModal: function(data = null) {
        try {
            const form = document.getElementById('productForm');
            if (!form) {
                console.error("Product form not found");
                this.showToast("Internal Error: Product form missing", "error");
                return;
            }
            form.reset();
            
            // Hide "new" inputs safely
            ['prod_new_sector', 'prod_new_category', 'prod_new_sub_category'].forEach(id => {
                const el = document.getElementById(id);
                if (el) el.classList.add('hidden');
            });

            const setVal = (id, val) => {
                const el = document.getElementById(id);
                if (el) el.value = val;
            };

            if (data && data.id) {
                // Edit Existing Product
                setVal('prod_id', data.id);
                setVal('prod_code', data.code || '');
                setVal('prod_name', data.name || '');
                setVal('prod_price', data.price || '');
                setVal('prod_cost', data.cost || '');
                setVal('prod_print_shop', data.print_shop || '');
                setVal('prod_product_size', data.product_size || '');
                
                this.populateAdminSectors(data.sector_id);
                this.populateAdminCategories(data.sector_id, data.category_id);
                this.populateAdminSubCategories(data.category_id, data.sub_category_id);
            } else {
                // New Product (with optional defaults)
                setVal('prod_id', '');
                setVal('prod_code', '');
                setVal('prod_name', '');
                setVal('prod_price', '');
                setVal('prod_cost', '');
                setVal('prod_print_shop', '');
                setVal('prod_product_size', '');

                const defaults = data || {};
                this.populateAdminSectors(defaults.sector_id || '');
                this.populateAdminCategories(defaults.sector_id || '', defaults.category_id || '');
                this.populateAdminSubCategories(defaults.category_id || '', defaults.sub_category_id || '');
            }
            
            const modal = document.getElementById('productModal');
            if (modal) {
                modal.classList.remove('hidden');
            } else {
                console.error("Product modal container not found");
                this.showToast("Error: Modal container missing", "error");
            }
        } catch (e) {
            console.error("Error in openProductModal:", e);
            this.showToast("Failed to open product form: " + e.message, "error");
        }
    },

    saveProduct: async function() {
        try {
            const form = document.getElementById('productForm');
            const formData = new FormData(form);
            const data = Object.fromEntries(formData.entries());
            
            // Handle "new" values
            if (data.sector === 'new') data.sector = document.getElementById('prod_new_sector').value;
            if (data.category === 'new') data.category = document.getElementById('prod_new_category').value;
            if (data.sub_category === 'new') data.sub_category = document.getElementById('prod_new_sub_category').value;

            if(!data.name || !data.sector) return this.showToast('Name and Sector are required', 'error');

            const res = await fetch('?action=save_product', { 
                method: 'POST', 
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data) 
            });
            const result = await res.json();
            
            if(result.success) {
                document.getElementById('productModal').classList.add('hidden');
                await this.loadData();
                this.renderAdminProducts();
                this.showToast('Product saved successfully!', 'success');
            } else {
                this.showToast(result.message, 'error');
            }
        } catch(e) {
            console.error(e);
            this.showToast('Error saving product.', 'error');
        }
    },

    triggerBulkUpload: function() {
        document.getElementById('bulkUploadInput').click();
    },

    handleBulkUpload: async function(event) {
        const file = event.target.files[0];
        if (!file) return;

        const formData = new FormData();
        formData.append('csv_file', file);

        try {
            const res = await fetch('?action=bulk_upload_products', {
                method: 'POST',
                body: formData
            });
            const result = await res.json();
            if (result.success) {
                this.showToast(result.message, 'success');
                await this.loadData();
                this.renderAdminProducts();
            } else {
                this.showToast(result.message, 'error');
            }
        } catch (e) {
            this.showToast('Bulk upload failed', 'error');
        }
        event.target.value = ''; // Reset input
    },
    
    deleteProduct: async function(id) {
        if(!confirm('Delete product?')) return;
        await fetch('?action=delete_product', { 
            method: 'POST', 
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({id}) 
        });
        await this.loadData();
        this.renderAdminProducts();
    },

    generateAIContent: function() {
