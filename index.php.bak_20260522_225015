    plannerSelectSlot: function(index) {
        this.plannerState.selectedSlot = index;
        this.renderPlannerGrid(); // Update selection ring
        
        const editor = document.getElementById('plannerEditor');
        const emptyState = document.getElementById('plannerEmptyState');
        const imgPreview = document.getElementById('plannerImgPreview');
        const captionInput = document.getElementById('plannerCaptionInput');
        const scheduleInput = document.getElementById('plannerScheduleInput');
        const hashtagsInput = document.getElementById('plannerHashtagsInput');
        const productInput = document.getElementById('plannerProductInput');
        const platformInput = document.getElementById('plannerPlatformInput');
        
        const item = this.plannerState.grid[index];
        
        if (editor && emptyState) {
            emptyState.classList.add('hidden');
            editor.classList.remove('hidden');
            
            document.getElementById('plannerSlotTitle').textContent = `Editing Slot #${index + 1}`;
            
            // Populate Product Dropdown
            if (productInput) {
                productInput.innerHTML = '<option value="">-- Select Product --</option>';
                (this.data.products || []).forEach(p => {
                    const opt = document.createElement('option');
                    opt.value = p.id;
                    opt.textContent = p.name;
                    productInput.appendChild(opt);
                });
                productInput.value = item ? (item.product_id || '') : '';
            }

            // Populate Platform Dropdown
            if (platformInput) {
                // Use dynamic platforms if available, else keep hardcoded default
                if (this.data.platforms && this.data.platforms.length > 0) {
                    platformInput.innerHTML = '';
                    this.data.platforms.forEach(p => {
                        const opt = document.createElement('option');
                        opt.value = p.id;
                        opt.textContent = p.name;
                        platformInput.appendChild(opt);
                    });
                }
                // Default to 'instagram' if new, or load saved
                platformInput.value = item ? (item.platform_id || 'instagram') : 'instagram';
            }
            
            if (item && item.image) {
                imgPreview.src = item.image;
                imgPreview.classList.remove('hidden');
                document.getElementById('plannerUploadPlaceholder').classList.add('hidden');
            } else {
                imgPreview.src = '';
                imgPreview.classList.add('hidden');
                document.getElementById('plannerUploadPlaceholder').classList.remove('hidden');
            }
            
            const caption = item ? (item.caption || '') : '';
            if (captionInput) captionInput.value = caption;
            const schedValue = item ? this.normalizePlannerSchedule(item.schedule || '') : '';
            if (scheduleInput) scheduleInput.value = schedValue;
            if (hashtagsInput) hashtagsInput.value = item ? (item.hashtags || '') : '';
            
            // Update Type UI
            this.updatePlannerTypeUI(item ? (item.type || 'image') : 'image');

            // Update Char Count
            const countEl = document.getElementById('plannerCharCount');
            if(countEl) countEl.textContent = `${caption.length} chars`;
            
            // Reset AI
            const aiSection = document.getElementById('plannerAISection');
            if(aiSection) aiSection.classList.add('hidden');

            const mobileCaptionInput = document.getElementById('plannerMobileCaptionInput');
            const mobileScheduleInput = document.getElementById('plannerMobileScheduleInput');
            const mobileHashtagsInput = document.getElementById('plannerMobileHashtagsInput');
            if (mobileCaptionInput) mobileCaptionInput.value = caption;
            if (mobileScheduleInput) mobileScheduleInput.value = schedValue;
            if (mobileHashtagsInput) mobileHashtagsInput.value = item ? (item.hashtags || '') : '';

            const mobileImg = document.getElementById('plannerMobilePreviewImage');
            const mobileVideo = document.getElementById('plannerMobilePreviewVideo');
            const mobilePlaceholder = document.getElementById('plannerMobilePreviewPlaceholder');
            if (mobileImg && mobileVideo && mobilePlaceholder) {
                if (item && item.image) {
                    const isVideo = item.type === 'reel' || (item.image && item.image.match(/\.(mp4|webm|mov)$/i));
                    if (isVideo) {
                        mobileVideo.src = item.image;
                        mobileVideo.classList.remove('hidden');
                        mobileImg.classList.add('hidden');
                    } else {
                        mobileImg.src = item.image;
                        mobileImg.classList.remove('hidden');
                        mobileVideo.classList.add('hidden');
                    }
                    mobilePlaceholder.classList.add('hidden');
                } else {
                    mobileImg.src = '';
                    mobileVideo.src = '';
                    mobileImg.classList.add('hidden');
                    mobileVideo.classList.add('hidden');
                    mobilePlaceholder.classList.remove('hidden');
                }
            }
        }
    },

    plannerHandleUpload: async function(event) {
        const files = Array.from(event.target.files || []);
        if (files.length === 0) return;
        const idx = this.plannerState.selectedSlot;
        if (idx === null) return;
        if (!this.plannerState.grid[idx]) this.plannerState.grid[idx] = {};
        const currentType = this.plannerState.grid[idx].type || 'image';
        const isVideoFile = f => f.type.startsWith('video/');
        const isImageFile = f => f.type.startsWith('image/');
        for (const f of files) {
            const validTypes = ['image/jpeg', 'image/png', 'image/gif', 'image/webp', 'video/mp4', 'video/webm', 'video/quicktime'];
            if (!validTypes.includes(f.type)) {
                this.showToast('Invalid file type. Please upload an image or video.', 'error');
                event.target.value = '';
                return;
            }
            if (f.size > 50 * 1024 * 1024) {
                this.showToast('File is too large (Max 50MB).', 'error');
                event.target.value = '';
                return;
            }
        }
        if (currentType === 'reel' && (files.length !== 1 || !isVideoFile(files[0]))) {
            this.showToast('Reel requires a single video file.', 'error');
            event.target.value = '';
            return;
        }
        if (currentType === 'image' && (files.length !== 1 || !isImageFile(files[0]))) {
            this.showToast('Image post requires a single image file.', 'error');
            event.target.value = '';
            return;
        }
        if (currentType === 'carousel' && files.some(isVideoFile)) {
            this.showToast('Carousel accepts images only.', 'error');
            event.target.value = '';
            return;
        }
        this.showLoading();
        try {
            if (currentType === 'carousel') {
                const urls = [];
                for (const f of files) {
                    const fd = new FormData();
                    fd.append('image', f);
                    const res = await fetch('api_intelligence_rd.php?action=research_upload_image', { method: 'POST', body: fd });
                    if (!res.ok) throw new Error(`HTTP Error ${res.status}`);
                    const json = await res.json();
                    if (!json.success) throw new Error(json.error || 'Upload failed');
                    urls.push(json.data.url);
                }
                this.plannerState.grid[idx].images = urls;
                this.plannerState.grid[idx].image = urls[0];
                this.plannerState.grid[idx].type = 'carousel';
                this.renderPlannerGrid();
                this.plannerSelectSlot(idx);
                this.plannerSave();
                this.showToast(`Uploaded ${urls.length} images to carousel`, 'success');
            } else {
                const f = files[0];
                const fd = new FormData();
                fd.append('image', f);
                const res = await fetch('api_intelligence_rd.php?action=research_upload_image', { method: 'POST', body: fd });
                if (!res.ok) throw new Error(`HTTP Error ${res.status}`);
                const json = await res.json();
                if (!json.success) throw new Error(json.error || 'Upload failed');
                this.plannerState.grid[idx].image = json.data.url;
                if (json.data.type === 'video') {
                    this.plannerState.grid[idx].type = 'reel';
                } else if (!this.plannerState.grid[idx].type) {
                    this.plannerState.grid[idx].type = 'image';
                }
                this.renderPlannerGrid();
                this.plannerSelectSlot(idx);
                this.plannerSave();
                this.showToast('Asset uploaded successfully', 'success');
            }
        } catch (e) {
            console.error(e);
            this.showToast('Upload failed: ' + e.message, 'error');
        }
        this.hideLoading();
        event.target.value = '';
    },

    plannerClearSlot: function() {
        const idx = this.plannerState.selectedSlot;
        if (idx !== null) {
            if (confirm('Are you sure you want to clear this slot?')) {
                this.plannerState.grid[idx] = null;
                this.renderPlannerGrid();
                this.plannerSelectSlot(idx); // Refresh editor to show empty state
                this.plannerSave();
                this.showToast('Slot cleared.', 'info');
            }
