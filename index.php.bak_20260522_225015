        } else {
            const adminNav = document.getElementById('nav-admin');
            if(adminNav) adminNav.classList.add('hidden');
            
            const mobileAdmin = document.querySelector(`.md\\:hidden button[onclick*="'admin'"]`);
            if(mobileAdmin) mobileAdmin.classList.add('hidden');
        }
    },

    // R&D Dashboard Integration - Deprecated/Merged
    // openRDDashboard: function() { ... } - Removed to prevent duplication

    fetchRD: async function(action, params = {}, extra = {}) {
        const url = new URL('api_intelligence_rd.php', window.location.href);
        url.searchParams.set('action', action);
        Object.entries(params || {}).forEach(([k, v]) => {
            if (v === undefined || v === null) return;
            url.searchParams.set(k, String(v));
        });
        if (extra && extra.bypassCache) {
            url.searchParams.set('_ts', String(Date.now()));
        }
        const response = await fetch(url.toString(), extra && extra.fetchOptions ? extra.fetchOptions : undefined);
        if (!response.ok) throw new Error(`HTTP ${response.status}: ${response.statusText}`);
        const json = await response.json();
        if (!json.success) throw new Error(json.message || 'Request failed');
        return json.data;
    },

    bindResearchUI: function() {
        if (this.research.bound) return;
        this.research.bound = true;

        const newsSearchBtn = document.getElementById('researchNewsSearchBtn');
        const newsRefreshBtn = document.getElementById('researchNewsRefreshBtn');
        const newsQuery = document.getElementById('researchNewsQuery');
        const newsRegion = document.getElementById('researchNewsRegion');
        const holidayNewsBtn = document.getElementById('researchHolidayNewsBtn');
        const bestTimeBtn = document.getElementById('researchBestTimeBtn');

        const uploadBtn = document.getElementById('researchImageUploadBtn');
        const uploadInput = document.getElementById('researchImageInput');

        if (newsSearchBtn) {
            newsSearchBtn.addEventListener('click', () => this.loadResearchNews(true, true));
        }
        if (newsRefreshBtn) {
            newsRefreshBtn.addEventListener('click', () => this.loadResearchNews(true, true, true));
        }
        if (newsQuery) {
            newsQuery.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    this.loadResearchNews(true, true);
                }
            });
        }
        if (newsRegion) {
            newsRegion.addEventListener('change', () => this.loadResearchNews(true, true));
        }

        if (holidayNewsBtn) {
            holidayNewsBtn.addEventListener('click', () => {
                const holidays = this.data.holidays || [];
                const today = new Date();
                today.setHours(0,0,0,0);
                
                const next = holidays
                    .map(h => {
                        const parts = h.date.split('-');
                        const d = new Date(parts[2], parts[1]-1, parts[0]);
                        return { ...h, dt: d };
                    })
                    .filter(h => h.dt >= today)
                    .sort((a,b) => a.dt - b.dt)[0];
                
                if(next) {
                    const newsQuery = document.getElementById('researchNewsQuery');
                    if(newsQuery) newsQuery.value = `${next.what_day} news`;
                    this.loadResearchNews(true, true);
                    this.showToast(`Searching news for upcoming: ${next.what_day}`, 'info');
                } else {
                    this.showToast('No upcoming holidays found', 'warning');
                }
            });
        }

        if (bestTimeBtn) {
            bestTimeBtn.addEventListener('click', () => {
                this.switchView('calendar');
                setTimeout(() => {
                     const map = document.getElementById('engagementHeatmap');
                     if(map && map.classList.contains('hidden')) {
                         this.toggleHeatmap();
                         this.showToast('Showing Best Posting Times', 'info');
                     }
                }, 100);
            });
        }

        if (uploadBtn && uploadInput) {
            uploadBtn.addEventListener('click', async () => {
                const file = uploadInput.files && uploadInput.files[0];
                if (!file) {
                    this.showToast('Select an image first', 'error');
                    return;
                }
                if (this.research.uploadLoading) return;
                this.research.uploadLoading = true;
                uploadBtn.disabled = true;

                try {
                    const fd = new FormData();
                    fd.append('image', file);
                    const data = await this.fetchRD('research_upload_image', {}, { fetchOptions: { method: 'POST', body: fd }, bypassCache: true });
                    uploadInput.value = '';
                    this.showToast('Image uploaded', 'success');
                    await this.loadResearchImages(true);
                } catch (e) {
                    console.error(e);
                    this.showToast('Upload failed', 'error');
                } finally {
                    this.research.uploadLoading = false;
                    uploadBtn.disabled = false;
                }
            });
        }
    },

    loadResearch: async function(force = false) {
        if (this.research.loading) return;
        const now = Date.now();
        if (!force && (now - (this.research.lastLoadedAt || 0)) < 30000 && this.research.data.overview) {
            this.renderResearchUI();
            return;
        }

        this.research.loading = true;
        try {
            const actions = ['overview', 'api_analytics', 'realtime'];
            const results = await Promise.allSettled(actions.map(a => this.fetchRD(a)));
            const map = {};
            results.forEach((r, idx) => {
                if (r.status === 'fulfilled') map[actions[idx]] = r.value;
            });
            this.research.data.overview = map.overview || this.research.data.overview || null;
            this.research.data.api_analytics = map.api_analytics || this.research.data.api_analytics || null;
            this.research.data.realtime = map.realtime || this.research.data.realtime || null;

            this.research.lastLoadedAt = now;
            await Promise.allSettled([this.loadResearchNews(false, false), this.loadResearchImages(false)]);
        } catch (e) {
            console.error(e);
            this.showToast('Research load failed', 'error');
        } finally {
            this.research.loading = false;
            this.renderResearchUI();
        }
    },

    loadResearchNews: async function(userTriggered = false, saveSettings = false, bypassCache = false) {
        const meta = document.getElementById('researchNewsMeta');
        const results = document.getElementById('researchNewsResults');
        const btn = document.getElementById('researchNewsSearchBtn');
        const refresh = document.getElementById('researchNewsRefreshBtn');
        const regionEl = document.getElementById('researchNewsRegion');
        const queryEl = document.getElementById('researchNewsQuery');

        if (!meta || !results) return;
        if (!['dashboard', 'analytics'].includes(this.state.currentView)) return;
        if (this.research.newsLoading) return;

        const saved = (() => {
            try { return JSON.parse(localStorage.getItem('researchNewsSettings') || 'null'); } catch (_) { return null; }
        })();
        const region = (regionEl?.value || saved?.region || 'uae').toLowerCase();
        const query = (queryEl?.value || saved?.query || '').trim();

        if (saveSettings) {
            try { localStorage.setItem('researchNewsSettings', JSON.stringify({ region, query })); } catch (_) {}
        }

        if (!userTriggered && this.research.data.news) return;

        this.research.newsLoading = true;
        if (btn) btn.disabled = true;
        if (refresh) refresh.disabled = true;
        meta.textContent = 'Loading...';

        try {
            const payload = await this.fetchRD('news', { region, q: query }, { bypassCache });
            this.research.data.news = payload;
            const labelRegion = String(payload.region || region || '').toUpperCase();
            const labelQuery = payload.query || query || '';
            const labelTime = payload.fetched_at ? new Date(payload.fetched_at).toLocaleString() : '';
            meta.textContent = `${labelRegion}${labelQuery ? ' · ' + labelQuery : ''}${labelTime ? ' · ' + labelTime : ''}`;
            this.renderResearchNews(payload);
            try {
                const res = await fetch(`?action=refresh_main_days&region=${encodeURIComponent(region)}`);
                if (res.ok) {
                    const json = await res.json();
                    if (json.success && json.data && Array.isArray(json.data.holidays)) {
                        this.data.holidays = json.data.holidays;
                        const stats = json.data.stats || {};
                        const ts = stats.last_search_at ? new Date(stats.last_search_at) : null;
                        const timeLabel = ts && !Number.isNaN(ts.getTime()) ? ts.toLocaleTimeString() : '';
                        const limitNote = stats.limited ? ' · Daily limit reached' : '';
                        this.showToast(
                            `Updated main days from news (${json.data.added || 0} new, ${json.data.region || region}${timeLabel ? ' · ' + timeLabel : ''}${limitNote})`,
                            stats.limited ? 'warning' : 'info'
                        );
                        if (this.state.currentView === 'calendar') {
                            this.renderCalendar();
                        }
                    }
                }
            } catch (_) {}
        } catch (e) {
            console.error(e);
            meta.textContent = 'Unable to load news right now';
            results.innerHTML = '';
            const err = document.createElement('div');
            err.className = 'p-4 rounded-lg border border-rose-200 bg-rose-50 text-sm text-rose-700';
            err.textContent = 'News fetch failed. Please try again.';
            results.appendChild(err);
        } finally {
            this.research.newsLoading = false;
            if (btn) btn.disabled = false;
            if (refresh) refresh.disabled = false;
        }
    },

    renderResearchNews: function(payload) {
        const container = document.getElementById('researchNewsResults');
        if (!container) return;
        container.innerHTML = '';

        const items = payload && Array.isArray(payload.items) ? payload.items : [];
        if (items.length === 0) {
            const empty = document.createElement('div');
            empty.className = 'p-4 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-sm text-slate-600 dark:text-slate-300';
            empty.textContent = 'No results. Try another search term.';
            container.appendChild(empty);
            return;
        }

        items.forEach(it => {
            const row = document.createElement('div');
            row.className = 'p-4 rounded-2xl border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors';

            const titleLink = document.createElement('a');
            titleLink.className = 'font-semibold text-sm text-fuchsia-700 dark:text-fuchsia-300 hover:underline';
            titleLink.href = it.link || '#';
            titleLink.target = '_blank';
            titleLink.rel = 'noopener noreferrer';
            titleLink.textContent = it.title || 'Untitled';

            const meta = document.createElement('div');
            meta.className = 'mt-1 text-xs text-slate-500 dark:text-slate-400 flex flex-wrap gap-2';

            const source = document.createElement('span');
            source.textContent = it.source && it.source.name ? it.source.name : 'News';

            const date = document.createElement('span');
            const dt = it.published_at ? new Date(it.published_at) : null;
            date.textContent = dt && !Number.isNaN(dt.getTime()) ? dt.toLocaleString() : '';

            meta.appendChild(source);
            if (date.textContent) meta.appendChild(date);

            const snippet = document.createElement('div');
            snippet.className = 'mt-2 text-sm text-slate-700 dark:text-slate-200';
            snippet.textContent = String(it.snippet || '').slice(0, 240);

            row.appendChild(titleLink);
            row.appendChild(meta);
            row.appendChild(snippet);
            container.appendChild(row);
        });
    },

