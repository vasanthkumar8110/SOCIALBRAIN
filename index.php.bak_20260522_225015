    populateAdminSectors: function(selectedId = '') {
        const sel = document.getElementById('prod_sector');
        sel.innerHTML = '<option value="">Select Sector</option>' + 
            (this.data.sectors || []).map(s => `<option value="${s.id}" ${s.id === selectedId ? 'selected' : ''}>${s.name}</option>`).join('') +
            '<option value="new">+ Add New Sector</option>';
    },
    populateAdminCategories: function(sectorId, selectedId = '') {
        const sel = document.getElementById('prod_category');
        const filtered = (this.data.categories || []).filter(c => c.sector_id === sectorId);
        sel.innerHTML = '<option value="">Select Category</option>' + 
            filtered.map(c => `<option value="${c.id}" ${c.id === selectedId ? 'selected' : ''}>${c.name}</option>`).join('') +
            '<option value="new">+ Add New Category</option>';
    },
    populateAdminSubCategories: function(categoryId, selectedId = '') {
        const sel = document.getElementById('prod_sub_category');
        const filtered = (this.data.sub_categories || []).filter(sc => sc.category_id === categoryId);
        sel.innerHTML = '<option value="">Select Sub-Category</option>' + 
