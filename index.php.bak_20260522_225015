    filterProducts: function(term) {
        const grid = document.getElementById('productGrid');
        grid.innerHTML = '';
        const wiz = this.state.wizard;
        const safeTerm = (term || '').toLowerCase();
        const filtered = (this.data.products || []).filter(p => {
            const pName = (p.name || '').toLowerCase();
            const matchTerm = pName.includes(safeTerm);
            const matchSub = !wiz.sub_category_id || p.sub_category_id === wiz.sub_category_id;
            const matchCat = !wiz.category_id || p.category_id === wiz.category_id;
            const matchSec = !wiz.sector_id || p.sector_id === wiz.sector_id;
            return matchTerm && matchSub && matchCat && matchSec;
        });
        
        filtered.forEach(p => {
            const div = document.createElement('div');
            const isSelected = this.state.wizard.product?.id === p.id;
            div.className = `p-3 border rounded-lg cursor-pointer flex justify-between items-center ${isSelected ? 'bg-blue-50 border-blue-500' : 'hover:bg-slate-50 border-slate-200'}`;
            div.innerHTML = `<div><div class="font-bold">${this.escapeHTML(p.name)}</div><div class="text-xs text-slate-500">Code: ${this.escapeHTML(p.code || 'N/A')} - $${p.price}</div></div>`;
            div.onclick = () => {
                this.state.wizard.product = p;
                this.saveState();
                this.filterProducts(term); 
                this.updateWizardSummary();
            };
            grid.appendChild(div);
        });

        this.updateWizardSummary();
    },

    updateWizardSummary: function() {
        const wiz = this.state.wizard;
        const plat = (this.data.platforms || []).find(p => p.id === wiz.platform);
        const sector = (this.data.sectors || []).find(s => s.id === wiz.sector_id);
        const category = (this.data.categories || []).find(c => c.id === wiz.category_id);
        const subcat = (this.data.sub_categories || []).find(sc => sc.id === wiz.sub_category_id);
        
        document.getElementById('summ-date').textContent = wiz.date || '---';
        document.getElementById('summ-platform').textContent = plat ? (plat.name + (wiz.fbContext ? ` (${wiz.fbContext})` : '')) : '---';
