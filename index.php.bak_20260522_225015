                <td class="px-4 py-3 text-slate-400 text-xs">${p.product_size || '---'}</td>
                <td class="px-4 py-3 text-slate-400 text-xs">${p.print_shop || '---'}</td>
                <td class="px-4 py-3 font-bold text-blue-600">$${p.price || 0}</td>
                <td class="px-4 py-3 font-bold text-slate-400">$${p.cost || 0}</td>
