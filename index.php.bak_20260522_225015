    renderAdminUsers: function() {
        fetch('?action=get_users')
            .then(r => r.json())
            .then(res => {
                if(!res.success) return; 
                // Ensure users is an array (handle legacy object data)
                const users = Array.isArray(res.data) ? res.data : (res.data ? Object.values(res.data) : []);
                // Store for modal lookup
                this.data.users = users;
                
                const tbody = document.getElementById('adminUsersTableBody');
                if(!tbody) return;
                tbody.innerHTML = '';
                
                // Update Stats
                const totalEl = document.getElementById('totalUsersCount');
                const adminEl = document.getElementById('adminUsersCount');
                if(totalEl) totalEl.textContent = users.length;
                if(adminEl) adminEl.textContent = users.filter(u => u.role === 'admin').length;
                
                users.forEach(u => {
                    const tr = document.createElement('tr');
                    tr.className = `hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors group border-b border-slate-100 dark:border-slate-800 ${u.is_disabled ? 'opacity-60 bg-slate-50' : ''}`;
                    
