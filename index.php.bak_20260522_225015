                    if (l.details && l.details.name) humanDetails = `Category ${l.details.name}`;
                } else if (l.action === 'sub_category_saved' || l.action === 'sub_category_deleted') {
                    if (l.details && l.details.name) humanDetails = `Sub-category ${l.details.name}`;
                } else if (l.action === 'create_task' || l.action === 'update_task' || l.action === 'update_task_status' || l.action === 'delete_task') {
                    if (l.details && l.details.task_id) {
                        humanDetails = `Task ${l.details.task_id}`;
                        if (l.details.status) {
                            humanDetails += ` status → ${l.details.status}`;
