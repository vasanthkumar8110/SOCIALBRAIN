    renderAdminProducts: function(searchTerm = '') {
        const tbody = document.getElementById('adminProductTable');
        if (!tbody) return;
        tbody.innerHTML = '';
        
        const filtered = (this.data.products || []).filter(p => {
            const s = (searchTerm || '').toLowerCase();
            return (p.name || '').toLowerCase().includes(s) || 
                   (p.code || '').toLowerCase().includes(s) ||
                   (p.sector || '').toLowerCase().includes(s) ||
                   (p.category || '').toLowerCase().includes(s);
        });

        filtered.forEach(p => {
            const sector = (this.data.sectors || []).find(s => s.id === p.sector_id)?.name || '---';
            const category = (this.data.categories || []).find(c => c.id === p.category_id)?.name || '---';
            const subCategory = (this.data.sub_categories || []).find(sc => sc.id === p.sub_category_id)?.name || '---';

            const tr = document.createElement('tr');
            tr.className = 'border-b hover:bg-slate-50 transition-colors';
