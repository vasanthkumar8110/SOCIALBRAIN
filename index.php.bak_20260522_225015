    init: async function() {
        try {
            // Load Theme
            if (localStorage.getItem('theme') === 'dark') {
                document.body.classList.add('dark');
            }

            // Restore State
            try {
                const savedState = JSON.parse(localStorage.getItem('appState'));
                if (savedState) {
                    if (savedState.date) this.state.currentDate = new Date(savedState.date);
                    if (savedState.view) this.state.currentView = savedState.view;
                    if (savedState.mobileMode) this.state.mobileViewMode = savedState.mobileMode;
                    if (savedState.wizard) this.state.wizard = savedState.wizard;
                    if (savedState.calendarLayout) this.state.calendarLayout = savedState.calendarLayout;
                    if (typeof savedState.calendarCompact === 'boolean') this.state.calendarCompact = savedState.calendarCompact;
                }
            } catch(e) { console.error("State restoration failed", e); }

            await this.loadData();
            if (typeof this.updateBrainSyncStatus === 'function') {
                this.updateBrainSyncStatus();
            }
            
            // Restore State Correctness
            this.switchView(this.state.currentView);
            
            // Restore Wizard if was open
            if (this.state.wizard && this.state.wizard.step) {
                if (typeof this.renderWizardStep === 'function') {
                    this.renderWizardStep();
                }
                document.getElementById('wizardModal').classList.remove('hidden');
            }

            if (typeof this.initEngagementHotkeys === 'function') {
                this.initEngagementHotkeys();
            }
            
            // Initial Admin Load
            if (typeof this.renderAdminProducts === 'function') {
                this.renderAdminProducts();
            }
            this.updateLiveDate();
            setInterval(() => this.updateLiveDate(), 60000);
            
            this.initActivityTracker();
            this.startLiveUpdates();
            this.startMainDaysAutoRefresh();
            if (typeof this.initAiAgent === 'function') {
                this.initAiAgent();
            }
            window.addEventListener('scroll', () => this.hidePostHoverCard(), true);
            window.addEventListener('resize', () => this.hidePostHoverCard());
        } catch(error) {
            console.error('Initialization error:', error);
            // Show toast but don't block the screen entirely if possible
            this.showToast('Initialization partially failed: ' + error.message, 'error');
        } finally {
            // Hide Loading Overlay ALWAYS
            const overlay = document.getElementById('loadingOverlay');
            try {
                if (overlay) overlay.classList.add('opacity-0');
                if (!this.data || typeof this.data !== 'object') {
                    this.data = { posts: [], products: [], sectors: [], platforms: [], holidays: [] };
                }
                if (typeof this.applyRolePermissions === 'function') {
                    this.applyRolePermissions(this.getEffectiveRole());
                }
            } catch (e) {
                console.error('Finalize error:', e);
            } finally {
                if (overlay) {
                    setTimeout(() => overlay.classList.add('hidden'), 300);
                }
            }
        }
    },

    getEffectiveRole: function() {
        const domRole = document.body?.dataset?.role || '';
        const dataRole = this.data?.userRole || this.data?.current_user?.role || '';
        return dataRole || domRole || 'viewer';
    },

    escapeHTML: function(str) {
        if (!str) return "";
        return String(str)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");
    },

    hoverCardEl: null,

    ensureHoverCard: function() {
        if (this.hoverCardEl && document.body.contains(this.hoverCardEl)) return this.hoverCardEl;
        const el = document.createElement('div');
        el.id = 'postHoverCard';
        el.className = 'post-hover-card';
        document.body.appendChild(el);
        this.hoverCardEl = el;
        return el;
    },

    getPlatformLabel: function(platformId) {
        const plat = (this.data?.platforms || []).find(p => p.id === platformId);
        return plat?.name || platformId || 'Unknown';
    },

    formatDateLabel: function(dateStr) {
        const parts = String(dateStr || '').split('-').map(Number);
        if (parts.length !== 3) return String(dateStr || '');
        const dt = new Date(parts[2], parts[1] - 1, parts[0]);
        if (Number.isNaN(dt.getTime())) return String(dateStr || '');
        return dt.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
    },

    renderPostHoverCardHTML: function(post) {
        const title = this.escapeHTML(post?.product_name || 'Untitled');
        const platform = this.escapeHTML(this.getPlatformLabel(post?.platform));
        const status = this.escapeHTML(String(post?.status || 'draft').toUpperCase());
        const time = this.escapeHTML(post?.post_time || 'No time');
        const date = this.escapeHTML(this.formatDateLabel(post?.date));
        const type = post?.post_type ? this.escapeHTML(String(post.post_type).replace(/_/g, ' ')) : '';
        const caption = post?.caption ? this.escapeHTML(String(post.caption)) : '';

        const pills = [
            `<span class="post-hover-pill"><i class="far fa-calendar"></i> ${date}</span>`,
            `<span class="post-hover-pill"><i class="far fa-clock"></i> ${time}</span>`,
            `<span class="post-hover-pill"><i class="fas fa-hashtag"></i> ${status}</span>`,
            `<span class="post-hover-pill"><i class="fas fa-share-alt"></i> ${platform}</span>`,
        ];
        if (type) pills.push(`<span class="post-hover-pill"><i class="fas fa-layer-group"></i> ${type}</span>`);

        return `
            <div class="post-hover-title">${title}</div>
            <div class="post-hover-meta">${pills.join('')}</div>
            ${caption ? `<div class="post-hover-sub">${caption}</div>` : ``}
        `;
    },

    showPostHoverCard: function(post, ev) {
        const el = this.ensureHoverCard();
        el.innerHTML = this.renderPostHoverCardHTML(post);
        this.positionPostHoverCard(ev);
        el.classList.add('show');
    },

    positionPostHoverCard: function(ev) {
        const el = this.hoverCardEl;
        if (!el) return;
        const pad = 12;
        const vw = window.innerWidth || 0;
        const vh = window.innerHeight || 0;
        const rect = el.getBoundingClientRect();
        let x = (ev?.clientX ?? 0) + 14;
        let y = (ev?.clientY ?? 0) + 14;
        if (x + rect.width + pad > vw) x = Math.max(pad, vw - rect.width - pad);
        if (y + rect.height + pad > vh) y = Math.max(pad, (ev?.clientY ?? 0) - rect.height - 14);
        el.style.left = `${x}px`;
        el.style.top = `${y}px`;
    },

    hidePostHoverCard: function() {
        const el = this.hoverCardEl;
        if (!el) return;
        el.classList.remove('show');
    },

    liveUpdateTimer: null,
    liveUpdateDelay: 3000,
    mainDaysRefreshTimer: null,
    mainDaysRefreshIntervalMs: 60000,

    startLiveUpdates: function() {
        this.scheduleNextUpdate();
